<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Bez × Darryl — Working Page</title>
<meta name="robots" content="noindex, nofollow">
<link href="https://fonts.googleapis.com/css2?family=EB+Garamond:wght@400;500&family=Inter:wght@200;300;400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --serif: 'EB Garamond', Georgia, serif;
    --sans: 'Inter', 'Helvetica Neue', Helvetica, Arial, sans-serif;
    --ink: #1a1a1a;
    --ink-soft: #4a4a4a;
    --ink-muted: #8a8a8a;
    --paper: #ffffff;
    --paper-warm: #faf7f2;
    --rule: rgba(0,0,0,.08);
    --accent: #95826b;
    --green: #2e7d52;
    --amber: #b07d2e;
    --blue: #2b5ea7;
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { background: var(--paper); color: var(--ink); font-family: var(--serif); -webkit-font-smoothing: antialiased; }

  header {
    padding: 40px 8vw 28px;
    border-bottom: 1px solid var(--rule);
    text-align: center;
  }
  .brand { font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.32em; text-transform: uppercase; color: var(--ink); margin-bottom: 28px; }
  .eyebrow { font-family: var(--sans); font-size: 10px; font-weight: 500; letter-spacing: 0.28em; text-transform: uppercase; color: var(--accent); margin-bottom: 12px; }
  h1 { font-family: var(--sans); font-size: clamp(22px, 2.6vw, 30px); font-weight: 200; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink); line-height: 1.3; margin-bottom: 10px; }
  .lede { font-family: var(--serif); font-size: 15px; color: var(--ink-soft); margin-top: 8px; }

  main { max-width: 900px; margin: 0 auto; padding: 0 6vw 80px; }

  .section { margin-top: 52px; border-top: 1px solid var(--rule); padding-top: 32px; }
  .section__label { font-family: var(--sans); font-size: 10px; font-weight: 600; letter-spacing: 0.28em; text-transform: uppercase; margin-bottom: 20px; }
  .section__label--inprogress { color: var(--amber); }
  .section__label--next { color: var(--blue); }
  .section__label--done { color: var(--green); }
  .section__label--ref { color: #6b35c2; }

  .card { border: 1px solid var(--rule); border-radius: 6px; padding: 20px 24px; margin-bottom: 14px; background: var(--paper-warm); }
  .card__title { font-family: var(--sans); font-size: 14px; font-weight: 500; letter-spacing: 0.04em; color: var(--ink); margin-bottom: 6px; }
  .card__meta { font-family: var(--sans); font-size: 11px; color: var(--ink-muted); letter-spacing: 0.06em; margin-bottom: 10px; }
  .card__note { font-family: var(--serif); font-size: 14px; color: var(--ink-soft); line-height: 1.65; margin-bottom: 14px; }
  .card__links { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  .card__link { font-family: var(--sans); font-size: 10px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-soft); text-decoration: none; border: 1px solid var(--rule); padding: 6px 14px; border-radius: 20px; transition: border-color 0.2s, color 0.2s; }
  .card__link:hover { border-color: var(--accent); color: var(--accent); }
  .card__link--primary { background: var(--ink); color: #fff; border-color: var(--ink); }
  .card__link--primary:hover { background: var(--accent); border-color: var(--accent); color: #fff; }

  .tag { display: inline-block; font-family: var(--sans); font-size: 10px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; padding: 3px 10px; border-radius: 12px; margin-right: 6px; }
  .tag--live { background: #e8f5ee; color: var(--green); }
  .tag--wip  { background: #fdf3e3; color: var(--amber); }

  .tracker-legend { display: grid; grid-template-columns: 1fr 60px 60px 60px 60px 60px 60px; gap: 0; padding: 10px 16px; margin-bottom: 0; border-bottom: 1px solid var(--rule); }
  .tracker-legend span { font-family: var(--sans); font-size: 9px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-muted); text-align: center; white-space: nowrap; }
  .tracker-legend span:first-child { text-align: left; }
  .tracker-group { margin-top: 24px; }
  .tracker-group__label { font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0.24em; text-transform: uppercase; color: var(--accent); padding: 10px 16px; background: var(--paper-warm); border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .tracker-group__label--pending { color: var(--amber); background: #fdf3e3; border-color: rgba(176,125,46,.2); }
  .tracker-row { display: grid; grid-template-columns: 1fr 60px 60px 60px 60px 60px 60px; align-items: center; padding: 11px 16px; border-bottom: 1px solid rgba(0,0,0,.05); }
  .tracker-row:last-child { border-bottom: 1px solid var(--rule); }
  .t-name { font-family: var(--sans); font-size: 13px; font-weight: 500; color: var(--ink); text-decoration: none; letter-spacing: 0.01em; }
  .t-name:hover { color: var(--accent); }
  .t-cell { text-align: center; font-size: 15px; line-height: 1; }
  .t-cell a { text-decoration: none; font-size: 15px; }
  .t-cell a:hover { opacity: 0.7; }

  footer { text-align: center; padding: 32px 6vw; border-top: 1px solid var(--rule); font-family: var(--sans); font-size: 11px; color: var(--ink-muted); letter-spacing: 0.10em; }
</style>
</head>
<body>

<header>
  <div class="brand">Bez Ambar</div>
  <div class="eyebrow">Working Page</div>
  <h1>Bez × Darryl</h1>
  <p class="lede">Active projects, priorities, and shipped work.</p>
</header>

<main>

  <!-- UP NEXT -->
