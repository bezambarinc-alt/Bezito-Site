          <tr><td>3.5</td><td>14.5</td><td>0.570</td><td>45.5</td><td>G</td><td>45.5</td><td>5</td></tr>
          <tr><td>3.75</td><td>14.7</td><td>0.578</td><td>46.1</td><td>G&frac12;</td><td>46</td><td>&mdash;</td></tr>
