          <tr><td>11.5</td><td>21.0</td><td>0.827</td><td>65.9</td><td>W</td><td>66</td><td>25</td></tr>
          <tr class="rsc-highlight"><td>12</td><td>21.4</td><td>0.843</td><td>67.2</td><td>X</td><td>67</td><td>26</td></tr>
          <tr><td>12.5</td><td>21.8</td><td>0.858</td><td>68.5</td><td>Y</td><td>68.5</td><td>27</td></tr>
          <tr class="rsc-highlight"><td>13</td><td>22.2</td><td>0.874</td><td>69.7</td><td>Z</td><td>70</td><td>28</td></tr>
