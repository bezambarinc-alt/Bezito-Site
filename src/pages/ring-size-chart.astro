          <tr><td>5.5</td><td>16.1</td><td>0.634</td><td>50.6</td><td>K</td><td>50.5</td><td>&mdash;</td></tr>
          <tr class="rsc-highlight"><td>6</td><td>16.5</td><td>0.650</td><td>51.9</td><td>L</td><td>52</td><td>12</td></tr>
          <tr><td>6.5</td><td>16.9</td><td>0.665</td><td>53.1</td><td>M</td><td>53</td><td>13</td></tr>
          <tr class="rsc-highlight"><td>7</td><td>17.3</td><td>0.681</td><td>54.4</td><td>N</td><td>54</td><td>14</td></tr>
          <tr><td>7.5</td><td>17.7</td><td>0.697</td><td>55.7</td><td>O</td><td>56</td><td>15</td></tr>
