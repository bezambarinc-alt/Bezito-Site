---
import Layout from '../layouts/Layout.astro';
import '../styles/templates/editorial.css';

const cuts = [
  {
    name: 'Pear',
    desc: 'The teardrop elongated. Step-cut crown, brilliant pavilion — fire and line held in one outline.',
    img: 'https://res.cloudinary.com/dlg2mou53/image/upload/f_auto,q_auto,w_900/v1779091383/Jewelry%20Images/Stones/Elysian_cut_pear_sng4kq.jpg',
  },
  {
    name: 'Oval',
    desc: 'The most calibration-flexible of the seven. Elongation without sacrifice of the light line.',
    img: 'https://res.cloudinary.com/dlg2mou53/image/upload/f_auto,q_auto,w_900/v1779074065/Jewelry%20Images/Stones/Elysian_cut_oval_qcdt5r.jpg',
  },
  {
    name: 'Marquise',
    desc: 'A boat-shaped prism. Maximizes face-up surface while holding Elysian proportion to the edge.',
    img: 'https://res.cloudinary.com/dlg2mou53/image/upload/f_auto,q_auto,w_900/v1779091372/Jewelry%20Images/Stones/Elysian_cut_marquise_boraiy.jpg',
  },
  {
    name: 'Emerald',
    desc: 'The original step cut, taken further. Rectangular facets at the Elysian pavilion angle.',
    img: 'https://res.cloudinary.com/dlg2mou53/image/upload/f_auto,q_auto,w_900/v1779091372/Jewelry%20Images/Stones/Elysian_cut_emerald_a1l5gv.jpg',
  },
  {
    name: 'Octagon',
    desc: 'Eight sides converging in measured symmetry. Architectural without being cold.',
    img: 'https://res.cloudinary.com/dlg2mou53/image/upload/f_auto,q_auto,w_900/v1779091373/Jewelry%20Images/Stones/Elysian_cut_octagon_bucoa5.jpg',
  },
  {
    name: 'Hex',
    desc: 'Six-sided. Rare in fine jewelry. Native to the Elysian calibration system.',
    img: 'https://res.cloudinary.com/dlg2mou53/image/upload/f_auto,q_auto,w_900/v1779091374/Jewelry%20Images/Stones/Elysian_cut_Hex_ywlwno.jpg',
  },
  {
    name: 'Triangle',
    desc: 'Three points held to Elysian proportion. Form, strictly kept, becomes its own fire.',
    img: 'https://res.cloudinary.com/dlg2mou53/image/upload/f_auto,q_auto,w_900/v1779169849/Jewelry%20Images/Stones/Elysian_cut_triangle.282_w8c4ki.avif',
  },
];
---

<Layout
  title="The Elysian Cut&trade; — A Family of Cuts | Bez Ambar"
  description="The Elysian Cut&trade; is a family of original step-cut geometries engineered for calibrated precision. Seven shapes, one philosophy. By Bez Ambar, Los Angeles."
  canonical="https://bezambar.com/elysian-cut"
  headerLight={true}
>

<!-- HERO — dark cinematic -->
<section class="ec-hero">
  <video
    class="ec-hero__bg"
    autoplay
    muted
    loop
    playsinline
    aria-hidden="true"
  >
    <source src="https://res.cloudinary.com/dlg2mou53/video/upload/f_auto,q_auto/Jewelry%20Videos/Rings/C0728_4K_1_smndkz.mp4" type="video/mp4">
  </video>
  <div class="ec-hero__overlay"></div>
  <div class="ec-hero__content">
    <p class="ec-hero__eyebrow">The Elysian Cut&trade;</p>
    <h1 class="ec-hero__title">A Family<br>of Cuts</h1>
    <div class="ec-hero__rule"></div>
    <p class="ec-hero__lede">An old idea — the step cut, centuries in the making — reborn across seven original geometries. Each engineered from the stone outward.</p>
  </div>
  <div class="ec-scroll-cue">
    <span>Scroll</span>
    <div class="ec-scroll-line"></div>
  </div>
</section>

<!-- Editorial intro -->
<div class="ec-intro">
  <div class="ec-intro__inner">
    <p>The Elysian Cut&trade; is not a single shape. It is a system: a family of original step-cut geometries, each engineered from the stone outward — the line of the crown, the relationship of the pavilion, the angles that decide whether light becomes a flicker or a continuous line.</p>
  </div>
</div>

<!-- Philosophy section -->
<section class="ec-philosophy">
  <div class="ec-philosophy__inner">
    <div class="ec-philosophy__number ec-fade">7</div>
    <div class="ec-philosophy__prose ec-fade">
      <span class="ec-eyebrow">The Philosophy</span>
      <h2 class="ec-heading">Calibration is the Discipline</h2>
      <p>Standard step cuts are singular shapes. The Elysian system is something else: each geometry is designed for stone-to-stone precision, the kind that lets a bracelet or a necklace behave as one piece of light, not a row of independent stones.</p>
      <p>Each shape is original. Each is made for calibration. And each holds to the same underlying proportion principle — an angle relationship in the pavilion that governs how light moves across the piece as a whole.</p>
    </div>
  </div>
</section>

<!-- Dark interstitial -->
<div class="ec-interstitial">
  <p class="ec-interstitial__text">&ldquo;The step cut is a discipline. You remove everything the stone does not need to say, and what remains is the line of light.&rdquo;</p>
  <span class="ec-interstitial__attr">Bez Ambar</span>
</div>

<!-- The seven geometries -->
<section class="ec-gallery">
  <div class="ec-gallery__inner">
    <div class="ec-gallery__header ec-fade">
      <span class="ec-eyebrow">The Seven Geometries</span>
      <h2 class="ec-heading">One Cut. Seven Shapes.</h2>
      <p class="ec-gallery__intro">Each shape serves a different design purpose. All share the Elysian proportion system — which is why they calibrate together.</p>
    </div>
    <div class="ec-cuts-grid">
      {cuts.map((cut, i) => (
        <article class={`ec-cut ec-fade`} style={`transition-delay: ${(i % 3) * 0.1}s`}>
          <div class="ec-cut__media">
            <img src={cut.img} alt={`Elysian Cut ${cut.name}`} loading="lazy" />
          </div>
          <div class="ec-cut__body">
            <h3 class="ec-cut__name">{cut.name}</h3>
            <p class="ec-cut__desc">{cut.desc}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- Calibration strip — dark -->
<div class="ec-calibration">
  <div class="ec-calibration__inner">
    <div class="ec-calibration__col ec-fade">
      <div class="ec-calibration__stat">
        <div class="ec-calibration__num">7</div>
        <div class="ec-calibration__label">Original Geometries</div>
      </div>
    </div>
    <div class="ec-calibration__col ec-fade">
      <div class="ec-calibration__stat">
        <div class="ec-calibration__num">1</div>
        <div class="ec-calibration__label">Proportion System</div>
      </div>
    </div>
    <div class="ec-calibration__col ec-calibration__col--prose ec-fade">
      <p>Every Elysian piece is built to order from calibrated stones. Each stone selected for consistency of dimension, angle, and light return across the entire set.</p>
      <p>Pricing and availability on request.</p>
    </div>
  </div>
</div>

<!-- CTA -->
<section class="ba-cta ba-cta--paper">
  <span class="ba-cta__eyebrow">Commission a Piece</span>
  <h2 class="ba-cta__title">See the Elysian Cut&trade; in Person</h2>
  <p class="ba-cta__body">Each piece is built to order from calibrated Elysian Cut&trade; stones. Arrange a private consultation at the Los Angeles atelier to view the full family.</p>
  <a href="/contact" class="ba-cta__btn" onclick="openInquiryDrawer({intent:'Elysian Cut inquiry'}); return false;">Arrange a Consultation</a>
</section>

</Layout>

<style is:global>
/* ── ELYSIAN CUT ──────────────────────────────────────────────── */

/* Hero */
.ec-hero {
  min-height: 100vh;
  background: var(--ink);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  padding: clamp(6rem, 12vw, 10rem) clamp(1.5rem, 6vw, 6rem) clamp(5rem, 8vw, 7rem);
  text-align: center;
}
.ec-hero__bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  opacity: 0.38;
}
.ec-hero__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to bottom,
    rgba(20,18,15,.65) 0%,
    rgba(20,18,15,.32) 45%,
    rgba(20,18,15,.72) 100%
  );
  pointer-events: none;
}
.ec-hero__content { position: relative; z-index: 1; max-width: 820px; }
.ec-hero__eyebrow {
  display: block;
  font-family: var(--sans);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 2.5rem;
}
.ec-hero__title {
  font-family: var(--prose);
  font-size: clamp(52px, 10vw, 116px);
  font-weight: 300;
  font-style: italic;
  color: var(--white);
  line-height: 1.05;
  margin: 0 0 3rem;
}
.ec-hero__rule {
  width: 40px;
  height: 1px;
  background: var(--accent);
  margin: 0 auto 3rem;
}
.ec-hero__lede {
  font-family: var(--prose);
  font-size: clamp(15px, 1.8vw, 18px);
  line-height: 1.85;
  color: rgba(255,255,255,.6);
  max-width: 44ch;
  margin: 0 auto;
}
.ec-scroll-cue {
  position: absolute;
  bottom: 2.5rem;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.75rem;
  z-index: 1;
}
.ec-scroll-cue span {
  font-family: var(--sans);
  font-size: 9px;
  font-weight: 600;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: rgba(255,255,255,.28);
}
.ec-scroll-line {
  width: 1px;
  height: 44px;
  background: linear-gradient(to bottom, rgba(149,130,107,.55), transparent);
  animation: ecScrollPulse 2.2s ease-in-out infinite;
}
@keyframes ecScrollPulse {
  0%, 100% { opacity: .4; transform: scaleY(1); }
  50%       { opacity: 1; transform: scaleY(.55); }
}

/* Fade-in */
.ec-fade {
  opacity: 0;
  transform: translateY(26px);
  transition: opacity .65s ease, transform .65s ease;
}
.ec-fade.in-view { opacity: 1; transform: none; }

/* Eyebrow */
.ec-eyebrow {
  display: block;
  font-family: var(--sans);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 1.25rem;
}

/* Heading */
.ec-heading {
  font-family: var(--prose);
  font-size: clamp(28px, 3.5vw, 48px);
  font-weight: 300;
  color: var(--ink);
  line-height: 1.12;
  margin-bottom: 2rem;
}

/* Intro editorial */
.ec-intro {
  padding: clamp(5rem, 9vw, 9rem) clamp(1.5rem, 6vw, 6rem);
  border-bottom: 1px solid rgba(0,0,0,.07);
}
.ec-intro__inner { max-width: 660px; margin: 0 auto; text-align: center; }
.ec-intro p {
  font-family: var(--prose);
  font-size: clamp(16px, 1.9vw, 22px);
  font-style: italic;
  line-height: 1.82;
  color: var(--ink-soft);
  margin: 0;
}

/* Philosophy */
.ec-philosophy {
  padding: clamp(5rem, 9vw, 10rem) clamp(1.5rem, 6vw, 6rem);
  border-top: 1px solid rgba(0,0,0,.07);
  background: var(--paper);
}
.ec-philosophy__inner {
  max-width: var(--max-w, 1200px);
  margin: 0 auto;
  display: grid;
  grid-template-columns: 200px 1fr;
  gap: clamp(3rem, 6vw, 7rem);
  align-items: start;
}
.ec-philosophy__number {
  font-family: var(--prose);
  font-size: clamp(120px, 14vw, 200px);
  font-weight: 200;
  font-style: italic;
  color: var(--accent);
  line-height: .85;
  opacity: .25;
  user-select: none;
}
.ec-philosophy__prose p {
  font-family: var(--prose);
  font-size: clamp(15px, 1.5vw, 17px);
  line-height: 1.85;
  color: var(--ink-soft);
  margin-bottom: 1.25rem;
}
.ec-philosophy__prose p:last-child { margin-bottom: 0; }

/* Interstitial — dark pull quote */
.ec-interstitial {
  background: var(--ink);
  padding: clamp(6rem, 10vw, 11rem) clamp(1.5rem, 6vw, 6rem);
  text-align: center;
}
.ec-interstitial__text {
  font-family: var(--prose);
  font-style: italic;
  font-weight: 300;
  font-size: clamp(20px, 3vw, 38px);
  line-height: 1.45;
  color: rgba(255,255,255,.82);
  max-width: 28ch;
  margin: 0 auto 2.5rem;
}
.ec-interstitial__attr {
  display: block;
  font-family: var(--sans);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--accent);
}

/* Gallery */
.ec-gallery {
  padding: clamp(5rem, 9vw, 10rem) clamp(1.5rem, 6vw, 6rem);
  border-top: 1px solid rgba(0,0,0,.07);
}
.ec-gallery__inner { max-width: var(--max-w, 1200px); margin: 0 auto; }
.ec-gallery__header { max-width: 580px; margin-bottom: clamp(3.5rem, 7vw, 6rem); }
.ec-gallery__intro {
  font-family: var(--prose);
  font-size: clamp(15px, 1.5vw, 17px);
  line-height: 1.8;
  color: var(--ink-soft);
  margin: 0;
}
.ec-cuts-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: clamp(2rem, 4vw, 3.5rem) clamp(1.5rem, 3vw, 2.5rem);
}

/* nth-child trick to center the 7th (orphan) item */
.ec-cut:nth-child(7) {
  grid-column: 2;
}

.ec-cut { }
.ec-cut__media {
  aspect-ratio: 3/4;
  overflow: hidden;
  background: var(--paper);
  margin-bottom: 1.75rem;
}
.ec-cut__media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform .6s ease;
}
.ec-cut:hover .ec-cut__media img { transform: scale(1.04); }
.ec-cut__name {
  font-family: var(--prose);
  font-size: clamp(22px, 2.5vw, 32px);
  font-weight: 300;
  font-style: italic;
  color: var(--ink);
  margin-bottom: .5rem;
  line-height: 1.1;
}
.ec-cut__desc {
  font-family: var(--prose);
  font-size: 14px;
  line-height: 1.7;
  color: var(--ink-muted);
  margin: 0;
}

/* Calibration strip — dark */
.ec-calibration {
  background: var(--ink);
  padding: clamp(5rem, 8vw, 8rem) clamp(1.5rem, 6vw, 6rem);
  border-top: none;
}
.ec-calibration__inner {
  max-width: var(--max-w, 1200px);
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1fr 2fr;
  gap: clamp(2rem, 5vw, 5rem);
  align-items: center;
}
.ec-calibration__num {
  font-family: var(--prose);
  font-size: clamp(60px, 7vw, 96px);
  font-weight: 200;
  font-style: italic;
  color: var(--accent);
  line-height: .9;
}
.ec-calibration__label {
  font-family: var(--sans);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: .18em;
  text-transform: uppercase;
  color: rgba(255,255,255,.35);
  margin-top: .75rem;
}
.ec-calibration__col--prose p {
  font-family: var(--prose);
  font-size: 15px;
  line-height: 1.8;
  color: rgba(255,255,255,.55);
  margin-bottom: .75rem;
}
.ec-calibration__col--prose p:last-child { margin-bottom: 0; }

/* Responsive */
@media (max-width: 900px) {
  .ec-philosophy__inner { grid-template-columns: 1fr; gap: 2rem; }
  .ec-philosophy__number { font-size: 100px; opacity: .15; }
  .ec-calibration__inner { grid-template-columns: 1fr 1fr; }
  .ec-calibration__col--prose { grid-column: 1 / -1; }
}
@media (max-width: 700px) {
  .ec-cuts-grid { grid-template-columns: repeat(2, 1fr); }
  .ec-cut:nth-child(7) { grid-column: auto; }
}
@media (max-width: 480px) {
  .ec-cuts-grid { grid-template-columns: 1fr; }
  .ec-calibration__inner { grid-template-columns: 1fr 1fr; }
  .ec-scroll-cue { display: none; }
}
</style>

<script>
  // Scroll fade-in
  var ecFades = document.querySelectorAll('.ec-fade');
  var ecObs = new IntersectionObserver(function(entries) {
    entries.forEach(function(e) {
      if (e.isIntersecting) { e.target.classList.add('in-view'); ecObs.unobserve(e.target); }
    });
  }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
  ecFades.forEach(function(el) { ecObs.observe(el); });
</script>
