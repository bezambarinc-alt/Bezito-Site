---
import Layout from '../layouts/Layout.astro';

const cuts = [
  { name: 'Pear',     sub: 'Elysian Cut Pear',     img: 'https://res.cloudinary.com/dlg2mou53/image/upload/f_auto,q_auto/v1779091383/Elysian_cut_pear_sng4kq.jpg' },
  { name: 'Oval',     sub: 'Elysian Cut Oval',     img: 'https://res.cloudinary.com/dlg2mou53/image/upload/f_auto,q_auto/v1779074065/Elysian_cut_oval_qcdt5r.jpg' },
  { name: 'Marquise', sub: 'Elysian Cut Marquise', img: 'https://res.cloudinary.com/dlg2mou53/image/upload/f_auto,q_auto/v1779091372/Elysian_cut_marquise_boraiy.jpg' },
  { name: 'Emerald',  sub: 'Elysian Cut Emerald',  img: 'https://res.cloudinary.com/dlg2mou53/image/upload/f_auto,q_auto/v1779091372/Elysian_cut_emerald_a1l5gv.jpg' },
  { name: 'Octagon',  sub: 'Elysian Cut Octagon',  img: 'https://res.cloudinary.com/dlg2mou53/image/upload/f_auto,q_auto/v1779091373/Elysian_cut_octagon_bucoa5.jpg' },
  { name: 'Hex',      sub: 'Elysian Cut Hex',      img: 'https://res.cloudinary.com/dlg2mou53/image/upload/f_auto,q_auto/v1779091374/Elysian_cut_Hex_ywlwno.jpg' },
  { name: 'Triangle', sub: 'Elysian Cut Triangle',  img: 'https://res.cloudinary.com/dlg2mou53/image/upload/f_auto,q_auto/v1779169849/Elysian_cut_triangle.282_w8c4ki.avif' },
];
---

<Layout
  title="The Elysian Cut&trade; — A Family of Cuts | Bez Ambar"
  description="The Elysian Cut&trade; is a family of original step-cut geometries engineered for calibrated precision. Seven shapes, one philosophy. By Bez Ambar, Los Angeles."
  canonical="https://bezambar.com/elysian-cut"
>
  <section class="ec-hero">
    <p class="ec-hero__eyebrow">The Elysian Cut&trade;</p>
    <h1 class="ec-hero__title">A Family of Cuts</h1>
    <p class="ec-hero__sub">An old idea, the step cut, centuries in the making, reborn across seven geometries.</p>
  </section>

  <section class="ec-intro">
    <p>The Elysian Cut&trade; is not a single shape. It is a family of original step-cut geometries, each engineered from the stone outward: the line of the crown, the relationship of the pavilion, the angles that decide whether light becomes a flicker or a continuous line.</p>
    <p>Each geometry is original. Each is made for calibration, the kind of stone-to-stone precision that lets a band or a necklace behave as one piece of light, not a row of independent stones.</p>
  </section>

  <section class="ec-family">
    <div class="ec-family__header">
      <p class="ec-family__eyebrow">The Family</p>
      <h2 class="ec-family__title">Seven Geometries. One Cut.</h2>
    </div>
    <div class="ec-family__grid">
      {cuts.map(cut => (
        <article class="ec-card">
          <div class="ec-card__media">
            <img src={cut.img} alt={cut.sub} loading="lazy" />
          </div>
          <h3 class="ec-card__name">{cut.name}</h3>
          <p class="ec-card__sub">{cut.sub}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="ec-cta">
    <h2 class="ec-cta__title">See the Elysian Cut&trade; in Person</h2>
    <p class="ec-cta__body">Pricing and current availability on request. Each piece is built to order from calibrated Elysian Cut&trade; stones.</p>
    <a href="mailto:bez@bezambar.com?subject=The%20Elysian%20Cut%E2%84%A2%20%E2%80%94%20Inquiry" class="ec-cta__button">Inquire</a>
  </section>
</Layout>

<style>
  .ec-hero {
    padding: 140px 2rem 72px;
    text-align: center;
    max-width: 680px;
    margin: 0 auto;
  }
  .ec-hero__eyebrow {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent, #95826b);
    margin-bottom: 20px;
  }
  .ec-hero__title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(40px, 6vw, 64px);
    font-weight: 300;
    letter-spacing: 0.03em;
    color: var(--ink, #1a1a1a);
    margin-bottom: 20px;
    line-height: 1.1;
  }
  .ec-hero__sub {
    font-family: 'EB Garamond', 'Cormorant Garamond', serif;
    font-size: 19px;
    line-height: 1.65;
    color: var(--ink, #1a1a1a);
    opacity: 0.7;
  }

  .ec-intro {
    max-width: 680px;
    margin: 0 auto;
    padding: 0 2rem 72px;
  }
  .ec-intro p {
    font-family: 'EB Garamond', 'Cormorant Garamond', serif;
    font-size: 19px;
    line-height: 1.75;
    color: var(--ink, #1a1a1a);
    opacity: 0.82;
    margin-bottom: 24px;
  }

  .ec-family {
    padding: 0 2rem 96px;
    max-width: 1200px;
    margin: 0 auto;
  }
  .ec-family__header {
    text-align: center;
    margin-bottom: 56px;
  }
  .ec-family__eyebrow {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent, #95826b);
    margin-bottom: 16px;
  }
  .ec-family__title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 300;
    letter-spacing: 0.04em;
    color: var(--ink, #1a1a1a);
  }
  .ec-family__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 40px 32px;
  }
  .ec-card__media {
    aspect-ratio: 1;
    overflow: hidden;
    background: #f4f1ec;
    margin-bottom: 20px;
  }
  .ec-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .ec-card:hover .ec-card__media img {
    transform: scale(1.04);
  }
  .ec-card__name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 22px;
    font-weight: 400;
    color: var(--ink, #1a1a1a);
    margin-bottom: 6px;
  }
  .ec-card__sub {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink, #1a1a1a);
    opacity: 0.45;
  }

  .ec-cta {
    text-align: center;
    padding: 80px 2rem 100px;
    background: #f9f7f4;
  }
  .ec-cta__title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 300;
    letter-spacing: 0.04em;
    color: var(--ink, #1a1a1a);
    margin-bottom: 20px;
  }
  .ec-cta__body {
    font-family: 'EB Garamond', 'Cormorant Garamond', serif;
    font-size: 18px;
    line-height: 1.7;
    color: var(--ink, #1a1a1a);
    opacity: 0.7;
    max-width: 500px;
    margin: 0 auto 40px;
  }
  .ec-cta__button {
    display: inline-block;
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #fff;
    background: var(--ink, #1a1a1a);
    padding: 16px 40px;
    text-decoration: none;
    transition: background 0.2s;
  }
  .ec-cta__button:hover {
    background: var(--accent, #95826b);
  }
</style>
