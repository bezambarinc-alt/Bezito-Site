---
import Layout from '../layouts/Layout.astro';

const cuts = [
  { name: 'Pear',     sub: 'Elysian Cut Pear',     img: 'https://res.cloudinary.com/dlg2mou53/image/upload/f_auto,q_auto/v1779091383/Jewelry%20Images/Stones/Elysian_cut_pear_sng4kq.jpg' },
  { name: 'Oval',     sub: 'Elysian Cut Oval',     img: 'https://res.cloudinary.com/dlg2mou53/image/upload/f_auto,q_auto/v1779074065/Jewelry%20Images/Stones/Elysian_cut_oval_qcdt5r.jpg' },
  { name: 'Marquise', sub: 'Elysian Cut Marquise', img: 'https://res.cloudinary.com/dlg2mou53/image/upload/f_auto,q_auto/v1779091372/Jewelry%20Images/Stones/Elysian_cut_marquise_boraiy.jpg' },
  { name: 'Emerald',  sub: 'Elysian Cut Emerald',  img: 'https://res.cloudinary.com/dlg2mou53/image/upload/f_auto,q_auto/v1779091372/Jewelry%20Images/Stones/Elysian_cut_emerald_a1l5gv.jpg' },
  { name: 'Octagon',  sub: 'Elysian Cut Octagon',  img: 'https://res.cloudinary.com/dlg2mou53/image/upload/f_auto,q_auto/v1779091373/Jewelry%20Images/Stones/Elysian_cut_octagon_bucoa5.jpg' },
  { name: 'Hex',      sub: 'Elysian Cut Hex',      img: 'https://res.cloudinary.com/dlg2mou53/image/upload/f_auto,q_auto/v1779091374/Jewelry%20Images/Stones/Elysian_cut_Hex_ywlwno.jpg' },
  { name: 'Triangle', sub: 'Elysian Cut Triangle',  img: 'https://res.cloudinary.com/dlg2mou53/image/upload/f_auto,q_auto/v1779169849/Jewelry%20Images/Stones/Elysian_cut_triangle.282_w8c4ki.avif' },
];
---

<Layout
  title="The Elysian Cut&trade; — A Family of Cuts | Bez Ambar"
  description="The Elysian Cut&trade; is a family of original step-cut geometries engineered for calibrated precision. Seven shapes, one philosophy. By Bez Ambar, Los Angeles."
  canonical="https://bezambar.com/elysian-cut"
  headerLight={true}
>
  <section class="ba-light-hero ba-light-hero--xl">
    <p class="ba-light-hero__eyebrow">The Elysian Cut&trade;</p>
    <h1>A Family of Cuts</h1>
    <p class="ba-light-hero__intro">An old idea, the step cut, centuries in the making, reborn across seven geometries.</p>
  </section>

  <section class="ba-prose-intro">
    <p>The Elysian Cut&trade; is not a single shape. It is a family of original step-cut geometries, each engineered from the stone outward: the line of the crown, the relationship of the pavilion, the angles that decide whether light becomes a flicker or a continuous line.</p>
    <p>Each geometry is original. Each is made for calibration, the kind of stone-to-stone precision that lets a band or a necklace behave as one piece of light, not a row of independent stones.</p>
  </section>

  <section class="ba-editorial-section">
    <div class="ba-editorial-section__header">
      <p class="ba-light-hero__eyebrow">The Family</p>
      <h2>Seven Geometries. One Cut.</h2>
    </div>
    <div class="ba-card-grid--auto">
      {cuts.map(cut => (
        <article class="ba-light-card">
          <div class="ba-light-card__media">
            <img src={cut.img} alt={cut.sub} loading="lazy" />
          </div>
          <h3 class="ba-light-card__name">{cut.name}</h3>
          <p class="ba-light-card__sub">{cut.sub}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="ba-cta">
    <p class="ba-cta__eyebrow">Availability</p>
    <h2 class="ba-cta__title">See the Elysian Cut&trade; in Person</h2>
    <p class="ba-cta__body">Pricing and current availability on request. Each piece is built to order from calibrated Elysian Cut&trade; stones.</p>
    <a href="/contact" class="ba-cta__btn" onclick="openInquiryDrawer({intent:'collection piece'}); return false;">Inquire</a>
  </section>
</Layout>
