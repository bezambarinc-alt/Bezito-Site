    <div class="vg-cat-item">
      <a href="#" class="vg-cat-link" data-filter="earrings">Earrings</a>
      <div class="vg-mega-dropdown">
        <div class="vg-mega-col">
          <h4>Color</h4>
          <a href="#" data-sub="ear-fancy">Fancy Color Diamond</a>
          <a href="#" data-sub="ear-gems">Gems</a>
        </div>
        <div class="vg-mega-col">
          <h4>By Collection</h4>
          <a href="#" data-sub="ear-blaze">Blaze&reg;</a>
          <a href="#" data-sub="ear-rof">Ring of Fire&reg;</a>
          <a href="#" data-sub="ear-flower">Flower</a>
          <a href="#" data-sub="ear-cross">Cross</a>
          <a href="#" data-sub="ear-fashion">Fashion</a>
        </div>
        <div class="vg-mega-col">
          <h4>By Style</h4>
          <a href="#" data-sub="ear-matrix">Matrix</a>
          <a href="#" data-sub="ear-center">Center Stone</a>
          <a href="#" data-sub="ear-hoops">Hoops</a>
