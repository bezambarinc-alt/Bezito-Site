          <a href="#" data-sub="band-baguette">Baguette</a>
          <a href="#" data-sub="band-blaze">Blaze&reg;</a>
          <a href="#" data-sub="band-space">Space Collection</a>
          <a href="#" data-sub="band-pave">Pave</a>
        </div>
        <div class="vg-mega-col">
          <h4>By Style</h4>
          <a href="#" data-sub="band-wide">Wide</a>
          <a href="#" data-sub="band-black">Black</a>
          <a href="#" data-sub="band-eternity">Eternity</a>
          <a href="#" data-sub="band-delicate">Delicate</a>
