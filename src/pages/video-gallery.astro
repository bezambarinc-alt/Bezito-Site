        <div class="vg-mega-col">
          <h4>By Collection</h4>
          <a href="#" data-sub="neck-crosses">Crosses</a>
          <a href="#" data-sub="neck-pave">Pave</a>
          <a href="#" data-sub="neck-hearts">Hearts</a>
          <a href="#" data-sub="neck-fashion">Fashion</a>
          <a href="#" data-sub="neck-initials">Initials</a>
        </div>
        <div class="vg-mega-col">
          <h4>By Style</h4>
          <a href="#" data-sub="neck-dogtag">Dogtag</a>
          <a href="#" data-sub="neck-large">Large Pendants</a>
          <a href="#" data-sub="neck-matrix">Matrix</a>
          <a href="#" data-sub="neck-center">Center Stone</a>
