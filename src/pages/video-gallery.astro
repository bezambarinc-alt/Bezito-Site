          <h4>Color</h4>
          <a href="#" data-sub="ear-fancy">Fancy Color Diamond</a>
          <a href="#" data-sub="ear-gems">Gems</a>
        </div>
        <div class="vg-mega-col">
          <h4>By Collection</h4>
          <a href="#" data-sub="ear-blaze">Blaze&reg;</a>
          <a href="#" data-sub="ear-rof">Ring of Fire&reg;</a>
          <a href="#" data-sub="ear-flower">Flower</a>
