---
import Layout from '../layouts/Layout.astro';
import '../styles/templates/tools.css';
---

<Layout
  title="Video Gallery — 500+ Pieces in Motion | Bez Ambar"
  description="Watch over five hundred Bez Ambar jewelry pieces under atelier light. Rings, bands, necklaces, earrings, and bracelets — every stone in motion before you inquire."
  canonical="https://bezambar.com/video-gallery"
>
  <section class="vg-hero">
    <p class="vg-hero__eyebrow">Video Gallery</p>
    <h1 class="vg-hero__title">Every Piece in Motion</h1>
    <p class="vg-hero__lede">Over five hundred Bez Ambar pieces, filmed at the atelier in Los Angeles. Watch each stone under light before you inquire.</p>
  </section>

  <!-- Category filter bar -->
  <div class="vg-cat-bar" id="vgCatBar">
    <a href="#" class="vg-cat-link active" data-filter="all">All</a>

    <div class="vg-cat-item">
      <a href="#" class="vg-cat-link" data-filter="rings">Rings</a>
      <div class="vg-mega-dropdown">
        <div class="vg-mega-col">
          <h4>White Diamonds</h4>
          <a href="#" data-sub="round">Round</a>
          <a href="#" data-sub="framed-round">Framed Round</a>
          <a href="#" data-sub="oval">Oval</a>
          <a href="#" data-sub="pear">Pear</a>
          <a href="#" data-sub="marquise">Marquise</a>
          <a href="#" data-sub="radiant">Radiant</a>
          <a href="#" data-sub="cushion">Cushion</a>
          <a href="#" data-sub="emerald-cut">Emerald</a>
        </div>
        <div class="vg-mega-col">
          <h4>Fancy Colors</h4>
          <a href="#" data-sub="pink">Pink</a>
          <a href="#" data-sub="blue">Blue</a>
          <a href="#" data-sub="yellow">Yellow</a>
        </div>
        <div class="vg-mega-col">
          <h4>Gemstones</h4>
          <a href="#" data-sub="red">Red</a>
          <a href="#" data-sub="gem-blue">Blue</a>
          <a href="#" data-sub="green">Green</a>
          <a href="#" data-sub="other-colors">Other Colors</a>
          <a href="#" data-sub="color-frame">Color Frame</a>
        </div>
        <div class="vg-mega-col">
          <h4>Three Stone Ring</h4>
          <a href="#" data-sub="three-round">Round</a>
          <a href="#" data-sub="three-oval">Oval</a>
          <a href="#" data-sub="three-cushion">Cushion</a>
          <a href="#" data-sub="three-emerald">Emerald</a>
          <a href="#" data-sub="square-center">Square Center</a>
        </div>
        <div class="vg-mega-col">
          <h4>By Collection</h4>
          <a href="#" data-sub="blaze-rof">Blaze&reg; Ring of Fire&reg;</a>
          <a href="#" data-sub="blaze">Blaze&reg;</a>
          <a href="#" data-sub="divine">Divine&reg;</a>
          <a href="#" data-sub="quadrillion">Quadrillion&reg; (Princess)</a>
          <a href="#" data-sub="pave">Pave</a>
        </div>
      </div>
    </div>

    <div class="vg-cat-item">
      <a href="#" class="vg-cat-link" data-filter="bands">Bands</a>
      <div class="vg-mega-dropdown">
        <div class="vg-mega-col">
          <h4>White Diamonds</h4>
          <a href="#" data-sub="band-round">Round</a>
          <a href="#" data-sub="band-princess">Quadrillion&reg; (Princess)</a>
          <a href="#" data-sub="band-emerald">Emerald</a>
          <a href="#" data-sub="band-heart">Heart</a>
        </div>
        <div class="vg-mega-col">
          <h4>Fancy Colors</h4>
          <a href="#" data-sub="band-pink">Pink</a>
          <a href="#" data-sub="band-blue">Blue</a>
          <a href="#" data-sub="band-yellow">Yellow</a>
