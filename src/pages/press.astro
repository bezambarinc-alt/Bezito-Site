---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Press & Media — Bez Ambar"
  description="Press coverage and media features about Bez Ambar's innovative diamond cuts and bespoke jewelry designs."
  canonical="https://bezambar.com/press"
  theme="dark"
>

<section class="ba-inner-hero ba-inner-hero--gradient">
  <span class="ba-inner-hero__eyebrow">Press & Media</span>
  <h1 class="light-weight">In the Press</h1>
  <p class="ba-inner-hero__intro">Bez Ambar's innovative diamond cuts and bespoke designs, as covered by the world's leading jewelry and luxury publications.</p>
</section>

<section class="press-section">
  <div class="press-section__inner">
    <h2 class="press-section-title">Featured Coverage</h2>
    <div class="press-featured-card">
      <div class="press-featured-card__img">
        <img src="https://res.cloudinary.com/dlg2mou53/image/upload/f_auto,q_auto,w_800/BezAmbar-OldSite/2019/08/5-carat-emerald-cut-engagement-ring-christina-ring.jpg" alt="The Quadrillion Diamond Cut — JQ Magazine 1992" loading="lazy">
      </div>
      <div class="press-featured-card__body">
        <span class="press-featured-card__tag">Featured &middot; JQ Magazine &middot; 1992</span>
        <h3 class="press-featured-card__title">The Quadrillion: A New Cut for the Diamond Industry</h3>
        <p class="press-featured-card__desc">A landmark article in JQ Magazine covering Bez Ambar's revolutionary Quadrillion diamond cut, which went on to become the second most popular diamond shape in the world, now widely recognized as the Princess Cut.</p>
        <a href="#" class="press-featured-card__link">Read Article</a>
      </div>
    </div>
  </div>
</section>

<section class="press-section press-section--alt">
  <div class="press-section__inner">
    <h2 class="press-section-title">In the News</h2>
    <div class="press-grid">
      <div class="press-card">
        <div class="press-card__img">
          <img src="https://res.cloudinary.com/dlg2mou53/image/upload/f_auto,q_auto,w_600/BezAmbar-OldSite/2017/08/1-Carat-Diamond-Engagement-Ring-French-Paloma-white.jpg" alt="DeBeers Diamonds Today Award 1985" loading="lazy">
        </div>
        <div class="press-card__body">
          <span class="press-card__year">1985</span>
          <h3 class="press-card__title">DeBeers Diamonds Today Award</h3>
          <p class="press-card__desc">Recognition for the ATW ring design, highlighting innovation in diamond jewelry craftsmanship and design excellence.</p>
        </div>
      </div>
      <div class="press-card">
        <div class="press-card__img">
          <img src="https://res.cloudinary.com/dlg2mou53/image/upload/f_auto,q_auto,w_600/BezAmbar-OldSite/2014/12/bouquet-of-light-oval-diamond-center-engagement-ring-1bol-ov.jpg" alt="Blaze Cut Introduction 2003" loading="lazy">
        </div>
        <div class="press-card__body">
          <span class="press-card__year">2003</span>
          <h3 class="press-card__title">Diamond Industry Innovation</h3>
          <p class="press-card__desc">Coverage of the Blaze&reg; Cut introduction, showcasing Bez Ambar's continued commitment to revolutionary diamond cutting techniques.</p>
        </div>
      </div>
      <div class="press-card">
        <div class="press-card__img">
          <img src="https://res.cloudinary.com/dlg2mou53/image/upload/f_auto,q_auto,w_600/BezAmbar-OldSite/2019/08/5-carat-emerald-cut-engagement-ring-christina-ring.jpg" alt="Los Angeles Luxury Profile 2020" loading="lazy">
        </div>
        <div class="press-card__body">
          <span class="press-card__year">2020</span>
          <h3 class="press-card__title">Los Angeles Luxury</h3>
          <p class="press-card__desc">Profile of Bez Ambar's LA atelier and the bespoke custom design process that has defined the brand for decades.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="ba-cta">
  <h2 class="ba-cta__title">Media Inquiries</h2>
  <p class="ba-cta__body">
    For press inquiries, interviews, or high-resolution images, please contact:<br>
    <a href="mailto:bez@bezambar.com" class="press-contact__email">bez@bezambar.com</a>
  </p>
  <a href="/contact" class="ba-cta__btn">Request Press Kit</a>
</section>

</Layout>
