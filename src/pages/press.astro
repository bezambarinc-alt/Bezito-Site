---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Press & Media — Bez Ambar"
  description="Press coverage and media features about Bez Ambar's innovative diamond cuts and bespoke jewelry designs."
  canonical="https://bezambar.com/press"
>

<style is:global>
  body { background: #0d0d0d; color: #fff; }
  .ba-header { background: #1a1a1a !important; color: #fff !important; box-shadow: none !important; }
  .ba-header.is-solid { background: #1a1a1a !important; color: #fff !important; }

  .press-hero {
    padding: 140px 20px 80px;
    text-align: center;
    background: linear-gradient(180deg, #141414 0%, #0d0d0d 100%);
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }
  .press-hero__eyebrow {
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--accent, #95826b);
    display: block;
    margin-bottom: 20px;
  }
  .press-hero h1 {
    font-family: var(--serif, 'Cormorant Garamond', Georgia, serif);
    font-size: clamp(36px, 6vw, 60px);
    font-weight: 300;
    font-style: italic;
    letter-spacing: 0.03em;
    color: #fff;
    margin: 0 0 20px;
    line-height: 1.1;
  }
  .press-hero p {
    font-family: 'EB Garamond', Georgia, serif;
    font-size: 18px;
    color: #888;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.65;
  }

  /* Featured */
  .press-featured {
    padding: 80px 24px;
    background: #141414;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }
  .press-featured__inner {
    max-width: 1100px;
    margin: 0 auto;
  }
  .press-section-title {
    font-family: var(--serif, 'Cormorant Garamond', Georgia, serif);
    font-size: 28px;
    font-weight: 400;
    color: #fff;
    margin: 0 0 40px;
    letter-spacing: 0.02em;
  }

  .featured-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 1px solid rgba(255,255,255,0.07);
    overflow: hidden;
    background: #111;
  }
  .featured-card__img {
    overflow: hidden;
    background: #1a1a1a;
  }
  .featured-card__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }
  .featured-card:hover .featured-card__img img { transform: scale(1.04); }
  .featured-card__body {
    padding: clamp(32px, 5vw, 56px);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .featured-card__tag {
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent, #95826b);
    margin-bottom: 20px;
    display: block;
  }
  .featured-card__title {
    font-family: var(--serif, 'Cormorant Garamond', Georgia, serif);
    font-size: clamp(22px, 3vw, 32px);
    font-weight: 400;
    color: #fff;
    margin: 0 0 16px;
    line-height: 1.2;
  }
  .featured-card__desc {
    font-family: 'EB Garamond', Georgia, serif;
    font-size: 17px;
    line-height: 1.7;
    color: #888;
    margin-bottom: 28px;
  }
  .featured-card__link {
    display: inline-block;
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #fff;
    text-decoration: none;
    border-bottom: 1px solid var(--accent, #95826b);
    padding-bottom: 3px;
    align-self: flex-start;
    transition: color 0.2s;
  }
  .featured-card__link:hover { color: var(--accent, #95826b); }

  /* News grid */
  .press-news {
    padding: 80px 24px;
    background: #0d0d0d;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }
  .press-news__inner { max-width: 1100px; margin: 0 auto; }
  .press-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .press-card {
    background: #111;
    border: 1px solid rgba(255,255,255,0.06);
    overflow: hidden;
  }
  .press-card__img {
    aspect-ratio: 3/2;
    overflow: hidden;
    background: #1a1a1a;
  }
  .press-card__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }
  .press-card:hover .press-card__img img { transform: scale(1.05); }
  .press-card__body { padding: 24px; }
  .press-card__year {
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent, #95826b);
    display: block;
    margin-bottom: 10px;
  }
  .press-card__title {
    font-family: var(--serif, 'Cormorant Garamond', Georgia, serif);
    font-size: 20px;
    font-weight: 400;
    color: #fff;
    margin: 0 0 10px;
    line-height: 1.3;
  }
  .press-card__desc {
    font-family: 'EB Garamond', Georgia, serif;
    font-size: 15px;
    line-height: 1.65;
    color: #888;
    margin: 0;
  }

  /* Contact */
  .press-contact {
    padding: 80px 24px;
    text-align: center;
    background: #141414;
  }
  .press-contact h2 {
    font-family: var(--serif, 'Cormorant Garamond', Georgia, serif);
    font-size: clamp(24px, 3.5vw, 36px);
    font-weight: 300;
    color: #fff;
    margin: 0 0 12px;
  }
  .press-contact p {
    font-family: 'EB Garamond', Georgia, serif;
    font-size: 17px;
    color: #888;
    margin: 0 0 20px;
  }
  .press-contact__email {
    display: block;
    font-family: 'Cormorant Garamond', serif;
    font-size: 22px;
    font-style: italic;
    color: var(--accent, #95826b);
    text-decoration: none;
    margin-bottom: 28px;
    transition: opacity 0.2s;
  }
  .press-contact__email:hover { opacity: 0.75; }
  .press-contact__btn {
    display: inline-block;
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #fff;
    text-decoration: none;
    border: 1px solid rgba(255,255,255,0.3);
    padding: 14px 36px;
    transition: border-color 0.2s, color 0.2s;
  }
  .press-contact__btn:hover {
    border-color: var(--accent, #95826b);
    color: var(--accent, #95826b);
  }

  @media (max-width: 900px) {
    .featured-card { grid-template-columns: 1fr; }
    .press-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .press-grid { grid-template-columns: 1fr; }
  }
</style>

<section class="press-hero">
  <span class="press-hero__eyebrow">Press &amp; Media</span>
  <h1>In the Press</h1>
  <p>Bez Ambar's innovative diamond cuts and bespoke designs, as covered by the world's leading jewelry and luxury publications.</p>
</section>

<section class="press-featured">
  <div class="press-featured__inner">
    <h2 class="press-section-title">Featured Coverage</h2>
    <div class="featured-card">
      <div class="featured-card__img">
        <img src="https://res.cloudinary.com/dlg2mou53/image/upload/f_auto,q_auto,w_800/BezAmbar-OldSite/2019/08/5-carat-emerald-cut-engagement-ring-christina-ring.jpg" alt="The Quadrillion Diamond Cut — JQ Magazine 1992" loading="lazy">
      </div>
      <div class="featured-card__body">
        <span class="featured-card__tag">Featured &middot; JQ Magazine &middot; 1992</span>
        <h3 class="featured-card__title">The Quadrillion: A New Cut for the Diamond Industry</h3>
        <p class="featured-card__desc">A landmark article in JQ Magazine covering Bez Ambar's revolutionary Quadrillion diamond cut, which went on to become the second most popular diamond shape in the world, now widely recognized as the Princess Cut.</p>
        <a href="#" class="featured-card__link">Read Article</a>
      </div>
    </div>
  </div>
</section>

<section class="press-news">
  <div class="press-news__inner">
    <h2 class="press-section-title">In the News</h2>
    <div class="press-grid">
      <div class="press-card">
        <div class="press-card__img">
          <img src="https://res.cloudinary.com/dlg2mou53/image/upload/f_auto,q_auto,w_600/BezAmbar-OldSite/2017/08/1-Carat-Diamond-Engagement-Ring-French-Paloma-white.jpg" alt="DeBeers Diamonds Today Award 1985" loading="lazy">
        </div>
        <div class="press-card__body">
          <span class="press-card__year">1985</span>
          <h3 class="press-card__title">DeBeers Diamonds Today Award</h3>
          <p class="press-card__desc">Recognition for the ATW ring design, highlighting innovation in diamond jewelry craftsmanship and design excellence.</p>
        </div>
      </div>
      <div class="press-card">
        <div class="press-card__img">
          <img src="https://res.cloudinary.com/dlg2mou53/image/upload/f_auto,q_auto,w_600/BezAmbar-OldSite/2014/12/bouquet-of-light-oval-diamond-center-engagement-ring-1bol-ov.jpg" alt="Blaze Cut Introduction 2003" loading="lazy">
        </div>
        <div class="press-card__body">
          <span class="press-card__year">2003</span>
          <h3 class="press-card__title">Diamond Industry Innovation</h3>
          <p class="press-card__desc">Coverage of the Blaze&reg; Cut introduction, showcasing Bez Ambar's continued commitment to revolutionary diamond cutting techniques.</p>
        </div>
      </div>
      <div class="press-card">
        <div class="press-card__img">
          <img src="https://res.cloudinary.com/dlg2mou53/image/upload/f_auto,q_auto,w_600/BezAmbar-OldSite/2019/08/5-carat-emerald-cut-engagement-ring-christina-ring.jpg" alt="Los Angeles Luxury Profile 2020" loading="lazy">
        </div>
        <div class="press-card__body">
          <span class="press-card__year">2020</span>
          <h3 class="press-card__title">Los Angeles Luxury</h3>
          <p class="press-card__desc">Profile of Bez Ambar's LA atelier and the bespoke custom design process that has defined the brand for decades.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="press-contact">
  <h2>Media Inquiries</h2>
  <p>For press inquiries, interviews, or high-resolution images, please contact:</p>
  <a href="mailto:bez@bezambar.com" class="press-contact__email">bez@bezambar.com</a>
  <a href="/contact" class="press-contact__btn">Request Press Kit</a>
</section>

</Layout>
