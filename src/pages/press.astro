---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Press & Media — Bez Ambar"
  description="Discover how Bez Ambar's innovative diamond cuts and bespoke designs have captured the attention of the world's leading jewelry and luxury publications."
  canonical="https://bezambar.com/press"
>
  <section class="press-hero">
    <div class="press-hero-content">
      <h1>Press &amp; Media</h1>
      <p>Discover how Bez Ambar's innovative diamond cuts and bespoke designs have captured the attention of the world's leading jewelry and luxury publications.</p>
    </div>
  </section>

  <section class="press-featured-section">
    <div class="press-featured-container">
      <h2 class="press-featured-title">Featured Coverage</h2>
      <div class="featured-article-card">
        <div class="featured-article-image">
          <img src="https://res.cloudinary.com/dlg2mou53/image/upload/f_auto,q_auto,w_800/BezAmbar-OldSite/2019/08/5-carat-emerald-cut-engagement-ring-christina-ring.jpg" alt="The Quadrillion Diamond Cut — JQ Magazine 1992">
        </div>
        <div class="featured-article-content">
          <span class="featured-article-tag">Featured &middot; JQ Magazine &middot; 1992</span>
          <h3 class="featured-article-title">The Quadrillion: A New Cut for the Diamond Industry</h3>
          <p class="featured-article-desc">A landmark article in JQ Magazine covering Bez Ambar's revolutionary Quadrillion diamond cut, which went on to become the second most popular diamond shape in the world, now widely recognized as the Princess Cut.</p>
          <a href="#" class="featured-article-link">Read Article</a>
        </div>
      </div>
    </div>
  </section>

  <section class="press-highlights-section">
    <div class="press-highlights-container">
      <h2 class="press-highlights-title">In the News</h2>
      <div class="press-grid">
        <div class="press-card">
          <img src="https://res.cloudinary.com/dlg2mou53/image/upload/f_auto,q_auto,w_600/BezAmbar-OldSite/2017/08/1-Carat-Diamond-Engagement-Ring-French-Paloma-white.jpg" alt="DeBeers Diamonds Today Award 1985" class="press-card-image">
          <span class="press-card-year">1985</span>
          <h3 class="press-card-title">DeBeers Diamonds Today Award</h3>
          <p class="press-card-desc">Recognition for the ATW ring design, highlighting innovation in diamond jewelry craftsmanship and design excellence.</p>
        </div>
        <div class="press-card">
          <img src="https://res.cloudinary.com/dlg2mou53/image/upload/f_auto,q_auto,w_600/BezAmbar-OldSite/2014/12/bouquet-of-light-oval-diamond-center-engagement-ring-1bol-ov.jpg" alt="Blaze Cut Introduction 2003" class="press-card-image">
          <span class="press-card-year">2003</span>
          <h3 class="press-card-title">Diamond Industry Innovation</h3>
          <p class="press-card-desc">Coverage of the Blaze Cut introduction, showcasing Bez Ambar's continued commitment to revolutionary diamond cutting techniques.</p>
        </div>
        <div class="press-card">
          <img src="https://res.cloudinary.com/dlg2mou53/image/upload/f_auto,q_auto,w_600/BezAmbar-OldSite/2019/08/5-carat-emerald-cut-engagement-ring-christina-ring.jpg" alt="Los Angeles Luxury Profile 2020" class="press-card-image">
          <span class="press-card-year">2020</span>
          <h3 class="press-card-title">Los Angeles Luxury</h3>
          <p class="press-card-desc">Profile of Bez Ambar's LA atelier and the bespoke custom design process that has defined the brand for decades.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="press-contact-section">
    <div class="press-contact-container">
      <h2 class="press-contact-title">Media Inquiries</h2>
      <p class="press-contact-text">For press inquiries, interviews, or high-resolution images, please contact:</p>
      <a href="mailto:bez@bezambar.com" class="press-contact-email">bez@bezambar.com</a>
      <div class="press-kit-btn">
        <a href="/contact">Request Press Kit</a>
      </div>
    </div>
  </section>
</Layout>
