---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Catalogs — Bez Ambar"
  description="Explore Bez Ambar's curated collection catalogs featuring the Flex Collection, Blaze® diamond cuts, and bespoke fine jewelry from Los Angeles."
  canonical="https://bezambar.com/catalogs"
>
  <section class="catalogs-hero">
    <h1>Catalogs</h1>
    <p>Explore our curated collections of fine diamond jewelry. Browse our catalogs featuring our most celebrated designs and proprietary cuts.</p>
  </section>

  <section class="catalogs-section">
    <div class="catalog-cards-grid">
      <a href="/contact" class="catalog-card">
        <div class="catalog-card-visual">
          <svg class="catalog-icon" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M25 15H75C78.3137 15 81 17.6863 81 21V79C81 82.3137 78.3137 85 75 85H25C21.6863 85 19 82.3137 19 79V21C19 17.6863 21.6863 15 25 15Z" stroke="#95826b" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            <line x1="50" y1="15" x2="50" y2="85" stroke="#95826b" stroke-width="1.5"/>
            <path d="M30 25H45M30 35H45M30 45H45M30 55H45M30 65H45" stroke="#95826b" stroke-width="1" stroke-linecap="round"/>
            <path d="M55 25H70M55 35H70M55 45H70M55 55H70M55 65H70" stroke="#95826b" stroke-width="1" stroke-linecap="round"/>
          </svg>
        </div>
        <div class="catalog-card-content">
          <h2>Flex Collection</h2>
          <p>Discover our innovative flexible jewelry designs that move with you, combining elegant aesthetics with modern comfort.</p>
          <span class="catalog-card-button">Request Catalog</span>
        </div>
      </a>

      <a href="/contact" class="catalog-card">
        <div class="catalog-card-visual">
          <svg class="catalog-icon" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M50 10L70 40L65 70L50 85L35 70L30 40L50 10Z" stroke="#95826b" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
            <path d="M50 30L60 45L55 60L50 68L45 60L40 45L50 30Z" stroke="#95826b" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
            <circle cx="50" cy="28" r="2" fill="#95826b"/>
            <circle cx="65" cy="45" r="2" fill="#95826b"/>
            <circle cx="35" cy="45" r="2" fill="#95826b"/>
            <circle cx="50" cy="65" r="2" fill="#95826b"/>
          </svg>
        </div>
        <div class="catalog-card-content">
          <h2>Blaze&reg; &amp; Diamond Cuts</h2>
          <p>Experience our proprietary diamond cuts engineered for maximum brilliance and fire. Each stone is a masterpiece of precision and artistry.</p>
          <span class="catalog-card-button">Request Catalog</span>
        </div>
      </a>
    </div>
  </section>

  <section class="catalogs-cta-section">
    <h2>Request a Physical Catalog</h2>
    <p>Our printed catalogs showcase the full beauty of our collections in stunning detail. Request yours to be delivered to your home.</p>
    <a href="/contact" class="catalogs-cta-button">Get in Touch</a>
  </section>
</Layout>
