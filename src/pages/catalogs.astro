---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Catalogs — Bez Ambar"
  description="Explore Bez Ambar's curated collection catalogs featuring the Flex Collection, Blaze® diamond cuts, and bespoke fine jewelry from Los Angeles."
  canonical="https://bezambar.com/catalogs"
>

<style is:global>
  .catalogs-hero {
    padding: 140px 20px 72px;
    text-align: center;
    border-bottom: 1px solid rgba(0,0,0,.06);
  }
  .catalogs-hero h1 {
    font-family: var(--serif, 'Cormorant Garamond', Georgia, serif);
    font-size: clamp(32px, 5vw, 52px);
    font-weight: 300;
    color: var(--ink, #1a1a1a);
    margin: 0 0 16px;
    letter-spacing: 0.02em;
  }
  .catalogs-hero p {
    font-family: 'EB Garamond', Georgia, serif;
    font-size: 18px;
    color: #666;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.65;
  }

  .catalogs-section {
    padding: 72px 24px;
    max-width: 1100px;
    margin: 0 auto;
    border-bottom: 1px solid rgba(0,0,0,.06);
  }
  .catalog-cards-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }
  .catalog-card {
    display: flex;
    flex-direction: column;
    border: 1px solid rgba(0,0,0,.08);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.25s;
    overflow: hidden;
  }
  .catalog-card:hover { border-color: var(--accent, #95826b); }
  .catalog-card-visual {
    background: #faf7f2;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 48px 32px;
  }
  .catalog-icon { width: 80px; height: 80px; }
  .catalog-card-content {
    padding: 32px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .catalog-card-content h2 {
    font-family: var(--serif, 'Cormorant Garamond', Georgia, serif);
    font-size: 24px;
    font-weight: 400;
    color: var(--ink, #1a1a1a);
    margin: 0 0 12px;
    letter-spacing: 0.02em;
  }
  .catalog-card-content p {
    font-family: 'EB Garamond', Georgia, serif;
    font-size: 16px;
    line-height: 1.7;
    color: #666;
    margin: 0 0 24px;
    flex: 1;
  }
  .catalog-card-button {
    display: inline-block;
    align-self: flex-start;
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink, #1a1a1a);
    border-bottom: 1px solid var(--accent, #95826b);
    padding-bottom: 3px;
    transition: color 0.2s;
  }
  .catalog-card:hover .catalog-card-button { color: var(--accent, #95826b); }

  .catalogs-cta-section {
    text-align: center;
    padding: 72px 20px;
    background: var(--ink, #1a1a1a);
  }
  .catalogs-cta-section h2 {
    font-family: var(--serif, 'Cormorant Garamond', Georgia, serif);
    font-size: clamp(24px, 3.5vw, 36px);
    font-weight: 300;
    color: #fff;
    margin: 0 0 12px;
  }
  .catalogs-cta-section p {
    font-family: 'EB Garamond', Georgia, serif;
    font-size: 17px;
    color: rgba(255,255,255,0.6);
    margin: 0 0 28px;
    max-width: 560px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.65;
  }
  .catalogs-cta-button {
    display: inline-block;
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #fff;
    text-decoration: none;
    border: 1px solid rgba(255,255,255,0.35);
    padding: 14px 36px;
    transition: border-color 0.2s, color 0.2s;
  }
  .catalogs-cta-button:hover { border-color: var(--accent, #95826b); color: var(--accent, #95826b); }
  @media (max-width: 700px) { .catalog-cards-grid { grid-template-columns: 1fr; } }
</style>

  <section class="catalogs-hero">
    <h1>Catalogs</h1>
    <p>Explore our curated collections of fine diamond jewelry. Browse our catalogs featuring our most celebrated designs and proprietary cuts.</p>
  </section>

  <section class="catalogs-section">
    <div class="catalog-cards-grid">
      <a href="/contact" class="catalog-card">
        <div class="catalog-card-visual">
          <svg class="catalog-icon" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M25 15H75C78.3137 15 81 17.6863 81 21V79C81 82.3137 78.3137 85 75 85H25C21.6863 85 19 82.3137 19 79V21C19 17.6863 21.6863 15 25 15Z" stroke="#95826b" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            <line x1="50" y1="15" x2="50" y2="85" stroke="#95826b" stroke-width="1.5"/>
            <path d="M30 25H45M30 35H45M30 45H45M30 55H45M30 65H45" stroke="#95826b" stroke-width="1" stroke-linecap="round"/>
            <path d="M55 25H70M55 35H70M55 45H70M55 55H70M55 65H70" stroke="#95826b" stroke-width="1" stroke-linecap="round"/>
          </svg>
        </div>
        <div class="catalog-card-content">
          <h2>Flex Collection</h2>
          <p>Discover our innovative flexible jewelry designs that move with you, combining elegant aesthetics with modern comfort.</p>
          <span class="catalog-card-button">Request Catalog</span>
        </div>
      </a>

      <a href="/contact" class="catalog-card">
        <div class="catalog-card-visual">
          <svg class="catalog-icon" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M50 10L70 40L65 70L50 85L35 70L30 40L50 10Z" stroke="#95826b" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
            <path d="M50 30L60 45L55 60L50 68L45 60L40 45L50 30Z" stroke="#95826b" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
            <circle cx="50" cy="28" r="2" fill="#95826b"/>
            <circle cx="65" cy="45" r="2" fill="#95826b"/>
            <circle cx="35" cy="45" r="2" fill="#95826b"/>
            <circle cx="50" cy="65" r="2" fill="#95826b"/>
          </svg>
        </div>
        <div class="catalog-card-content">
          <h2>Blaze&reg; &amp; Diamond Cuts</h2>
          <p>Experience our proprietary diamond cuts engineered for maximum brilliance and fire. Each stone is a masterpiece of precision and artistry.</p>
          <span class="catalog-card-button">Request Catalog</span>
        </div>
      </a>
    </div>
  </section>

  <section class="catalogs-cta-section">
    <h2>Request a Physical Catalog</h2>
    <p>Our printed catalogs showcase the full beauty of our collections in stunning detail. Request yours to be delivered to your home.</p>
    <a href="/contact" class="catalogs-cta-button">Get in Touch</a>
  </section>
</Layout>
