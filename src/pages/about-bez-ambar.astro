---
import Layout from '../layouts/Layout.astro';
import '../styles/templates/about.css';

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Bez Ambar",
    "alternateName": "Betzalel Ambar",
    "jobTitle": "Diamond Artist, Designer, and Jeweler",
    "description": "Israeli-American diamond artist, designer, and inventor of the Princess cut diamond. Founder of Bez Ambar Inc. in Los Angeles since 1979.",
    "nationality": "Israeli-American",
    "url": "https://bezambar.com/about-bez-ambar",
    "image": "https://res.cloudinary.com/dlg2mou53/image/upload/f_jpg,w_1200/v1775786208/Quadrillion_owciyv.jpg",
    "worksFor": {
      "@type": "Organization",
      "name": "Bez Ambar Inc.",
      "url": "https://bezambar.com"
    },
    "hasOccupation": {
      "@type": "Occupation",
      "name": "Fine Jewelry Designer and Diamond Cutter"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Who invented the Princess cut diamond?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The Princess cut was invented by Bez Ambar (Betzalel Ambar) in Los Angeles in 1982 under the name Quadrillion®. The patented square brilliant cut became the world's most popular diamond shape and the name Princess cut entered common use across the diamond trade."
        }
      },
      {
        "@type": "Question",
        "name": "Where is the Bez Ambar atelier located?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The Bez Ambar atelier is located at 611 Wilshire Blvd, Los Angeles, CA 90017. All cutting, setting, and finishing takes place at this single address. Private consultations are available by appointment. Contact: (213) 629-9191."
        }
      }
    ]
  }
];

const timeline = [
  {
    year: '1979',
    title: 'Los Angeles. The Beginning.',
    body: 'Bez Ambar arrives in Los Angeles and founds Ambar Diamonds Inc. He comes as a cutter, not a retailer. From the first day, the studio is where the work begins, not where finished pieces arrive from somewhere else.',
  },
  {
    year: '1982',
    title: 'The Princess Cut',
    body: 'The Quadrillion® cut is introduced: a square brilliant that delivers the fire of a round diamond inside a clean, modern geometry. The trade adopts it immediately. The world eventually calls it the Princess cut. It becomes the most popular diamond shape on Earth.',
    img: { src: 'https://res.cloudinary.com/dlg2mou53/image/upload/f_auto,q_auto,w_900/v1775786208/Quadrillion_owciyv.jpg', alt: 'The Quadrillion cut by Bez Ambar, inventor of the Princess cut' },
  },
  {
    year: '1985',
    title: 'The DeBeers Award',
    body: 'The ATW Quadrillion® ring receives the DeBeers Award, one of the diamond industry\'s most recognized honors. The cut is now an industry standard.',
  },
  {
    year: '1988',
    title: 'The Laserset Setting',
    body: 'The Laserset® is a rimless, prongless setting for square-cut diamonds. There is no metal at the edge of the stone. The diamond appears to float in the hand. It is the first setting of its kind.',
  },
  {
    year: '1992',
    title: 'The Boundless Setting',
    body: 'The same logic, applied to round diamonds. The Boundless setting removes the prong from the round brilliant, letting the stone sit clean in the hand without the visual interruption of metal at its edge.',
  },
  {
    year: '1999',
    title: 'Micro-Pave',
    body: 'A new pave technique enters the Bez Ambar atelier. The industry eventually names it Micro-Pave. It is now one of the most widely used setting styles in fine jewelry.',
  },
  {
    year: '2003',
    title: 'The Blaze® Cut',
    body: 'The Blaze® cut is patented. Thirteen precisely aligned facets produce a starburst of light visible to the naked eye under white light. This effect is specific to the Blaze® geometry. No other house in the world produces it.',
    video: 'https://res.cloudinary.com/dlg2mou53/video/upload/f_auto,q_auto/v1782855871/videos/bracelets/emerald-cut-flex-bracelet-c0834-2026.mp4',
  },
  {
    year: '2015',
    title: 'The Divine Cut',
    body: 'The Divine Cut® is introduced: a round brilliant engineered for a specific quality of dispersion, continuing the atelier\'s forty-year study of how light moves inside a cut stone.',
  },
];
---

<Layout
  title="About Bez Ambar — Artist, Designer &amp; Inventor of the Princess Cut | Los Angeles"
  description="About Bez Ambar: Israeli-American diamond artist, designer, and inventor of the Princess cut. Three patented cuts. One atelier in Los Angeles, since 1979."
  canonical="https://bezambar.com/about-bez-ambar"
  ogImage="https://res.cloudinary.com/dlg2mou53/image/upload/f_jpg,w_1200,c_fit/v1775786208/Quadrillion_owciyv.jpg"
  structuredData={structuredData}
>
  <!-- Hero -->
  <section class="ba-portrait-hero ba-portrait-hero--serif ba-portrait-hero--short" id="about-hero">
    <img
      src="https://res.cloudinary.com/dlg2mou53/image/upload/f_auto,q_auto,w_1600,c_fill,g_center/v1775786208/Quadrillion_owciyv.jpg"
      alt="The Quadrillion® Princess cut diamond, invented by Bez Ambar in Los Angeles in 1982"
      fetchpriority="high"
    />
    <div class="ba-portrait-hero__overlay">
      <p class="ba-portrait-hero__eyebrow">The Inventor</p>
      <h1 class="ba-portrait-hero__title">Bez Ambar</h1>
      <p class="ba-portrait-hero__lede">He cuts the diamond. Then he designs the piece around it. For forty-five years, those two acts have been inseparable — the artist and the craftsman working from the same hands.</p>
    </div>
  </section>

  <!-- Intro stats + prose -->
  <div class="ba-about-intro-wrap">
    <div class="ba-about-intro">
      <div class="ba-about-intro__stats">
        <div class="ba-stat">
          <div class="ba-stat__number">1979</div>
          <div class="ba-stat__label">Founded in Los Angeles</div>
        </div>
        <div class="ba-stat">
          <div class="ba-stat__number">3</div>
          <div class="ba-stat__label">Patented Diamond Cuts</div>
        </div>
        <div class="ba-stat">
          <div class="ba-stat__number">45+</div>
          <div class="ba-stat__label">Years of Innovation</div>
        </div>
        <div class="ba-stat">
          <div class="ba-stat__number">#1</div>
          <div class="ba-stat__label">Most Sold Diamond Shape</div>
        </div>
      </div>
      <div class="ba-about-intro__prose">
        <h2>Artist. Designer. Craftsman.</h2>
        <p>Bez Ambar is an Israeli-American diamond cutter, jewelry designer, and artist who has worked from a single atelier in Los Angeles since 1979. He is one of the rare figures in fine jewelry who does all three things: he cuts the stone, designs the piece, and builds it himself. That sequence is not incidental. It shapes every object that leaves his studio.</p>
        <p>Most jewelry begins with a setting and finds a stone to fit it. Bez works the other way. The stone comes first. He reads its specific geometry of light, then designs the piece to express exactly that, and nothing else. The Quadrillion® was not a commercial instinct. It was an artistic one: a shape that did something existing cuts could not. So was the Laserset®, which stripped the metal away so the stone could finally be the only thing a hand touched. So was the Blaze®, which solved for a quality of fire that no existing facet arrangement produced.</p>
        <p>The atelier at 611 Wilshire is where every stage of that process happens under one roof. Every piece leaves with his signature in the metal because the same artist who chose the stone designed the piece it lives in.</p>
        <div class="ba-cta-row">
          <a class="ba-cta-inline" href="/contact?subject=bespoke">Schedule a Private Consultation</a>
          <a class="ba-cta-inline ba-cta-inline--ghost" href="/collection">Explore the Collection</a>
        </div>
      </div>
    </div>
  </div>

  <!-- Image break -->
  <div class="ba-media-break">
    <video
      src="https://res.cloudinary.com/dlg2mou53/video/upload/f_auto,q_auto/v1783061546/videos/rings/c0747-hd-2026.mp4"
      autoplay loop muted playsinline preload="none"
    ></video>
  </div>

  <!-- Craft portrait -->
  <div class="ba-craft-section">
    <div class="ba-craft-section__prose">
      <h2>How He Works</h2>
      <p>A stone comes into the atelier. Bez picks it up, turns it under the light, tilts it slowly. He is reading the pavilion, watching how the facets distribute what enters through the table. This is not inspection. It is a conversation with the crystal, and the question he is asking is always the same: what does this particular stone want to say?</p>
      <p>The answer determines everything that follows. Not just the cut, but the piece itself. The setting is designed around the stone's specific quality of light, not the other way around. A stone with a particular warmth gets a piece that holds that warmth. A stone that scatters gets a setting that gives it room to move. The artistic decision and the technical decision are the same decision, made by the same person in the same moment.</p>
      <p>The work does not leave the atelier until every stage has been done by the same hands that started it. An artist's vision does not survive a handoff intact. The cutter, the designer, the setter are one person here. That is the only way to guarantee that what the stone offered at the beginning is still present in the finished piece.</p>
    </div>
    <div class="ba-craft-section__media">
      <img
        src="https://res.cloudinary.com/dlg2mou53/image/upload/f_auto,q_auto,w_900/v1782876014/necklaces/single-row-lifestyle.jpg"
        alt="Single row diamond necklace by Bez Ambar"
        loading="lazy"
      />
    </div>
  </div>

  <!-- Timeline -->
  <section class="ba-timeline">
    <div class="ba-timeline__header">
      <h2>The Work, In Order</h2>
      <p>Every milestone on this list began as a problem in the workshop. Several of the solutions are now so common they have lost their origin. Here is where they came from.</p>
    </div>
    <div class="ba-timeline__list">
      {timeline.map(entry => (
        <div class="ba-tl-entry">
          <div class="ba-tl-year">{entry.year}</div>
          <div class="ba-tl-content">
            <div class="ba-tl-title">{entry.title}</div>
            <div class="ba-tl-body" set:html={entry.body}></div>
            {entry.img && (
              <div class="ba-tl-media">
                <img src={entry.img.src} alt={entry.img.alt} loading="lazy" />
              </div>
            )}
            {entry.video && (
              <div class="ba-tl-media">
                <video src={entry.video} autoplay loop muted playsinline preload="none"></video>
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
    <div class="ba-timeline__ctas">
      <a class="ba-cta-inline" href="/collection">View the Full Collection</a>
      <a class="ba-cta-inline ba-cta-inline--ghost" href="/contact?subject=bespoke">Inquire About a Bespoke Piece</a>
    </div>
  </section>

  <!-- Pull quote -->
  <div class="ba-pull-quote--dark">
    <p class="ba-pull-quote__text">"The cut is not a style. It is a solution."</p>
    <p class="ba-pull-quote__attr">Bez Ambar &mdash; Los Angeles</p>
  </div>

  <!-- Proprietary cuts -->
  <section class="ba-cuts-section">
    <div class="ba-cuts-section__header">
      <h2>Three Cuts. Three Solutions.</h2>
      <p>Each one begins with a problem that the existing options could not answer. Each one is still exclusive to this atelier.</p>
    </div>
    <div class="ba-cuts-grid">
      <div class="ba-cut-card">
        <div class="ba-cut-card__media">
          <img
            src="https://res.cloudinary.com/dlg2mou53/image/upload/f_auto,q_auto,w_800/v1775786208/Quadrillion_owciyv.jpg"
            alt="The Quadrillion Princess cut diamond by Bez Ambar"
            loading="lazy"
          />
        </div>
        <div class="ba-cut-card__since">Since 1982</div>
        <div class="ba-cut-card__name">Quadrillion® — The Princess Cut</div>
        <div class="ba-cut-card__body">The original. A square brilliant that changed the industry and became the world's most popular diamond shape. Quadrillion® is what Bez named it. Princess cut is what the world calls it now.</div>
      </div>
      <div class="ba-cut-card">
        <div class="ba-cut-card__media">
          <video
            src="https://res.cloudinary.com/dlg2mou53/video/upload/f_auto,q_auto/v1782855177/videos/bracelets/asscher-cut-single-row-bracelet-c0755-2026.mp4"
            autoplay loop muted playsinline preload="none"
          ></video>
        </div>
        <div class="ba-cut-card__since">Patented 2003</div>
        <div class="ba-cut-card__name">Blaze®</div>
        <div class="ba-cut-card__body">Thirteen aligned facets. One visible starburst of light, naked to the eye. The Blaze® is a patented geometry and a registered trademark. The optical effect it creates is exclusive to this cut.</div>
      </div>
      <div class="ba-cut-card">
        <div class="ba-cut-card__media">
          <img
            src="https://res.cloudinary.com/dlg2mou53/image/upload/f_auto,q_auto,w_800/v1775549202/C0625_Baguette_band_Master_e4azkj.jpg"
            alt="Elysian Cut diamond jewelry by Bez Ambar"
            loading="lazy"
          />
        </div>
        <div class="ba-cut-card__since">Elysian Cut&trade;</div>
        <div class="ba-cut-card__name">Elysian&trade;</div>
        <div class="ba-cut-card__body">An elongated geometry that concentrates the interplay of facets along the stone's principal axis. Not every stone qualifies. Each Elysian is selected and assessed for a specific quality of light before the name is used.</div>
      </div>
    </div>
  </section>

  <!-- Atelier contact -->
  <div class="ba-atelier-wrap">
    <div class="ba-atelier">
      <div>
        <h2>The Atelier</h2>
        <p>The atelier at 611 Wilshire has been the same address since 1979. The stone comes in, the artist reads it, the piece is designed around what the stone offers. Every stage happens here. Bez Ambar's name is on the metal because he made every decision that put it there — from the first tilt of the stone under the light to the last pass of the setting wheel.</p>
        <p>Private consultations are by appointment. If you want to understand how a stone is read, or how a piece is designed around its specific character, come in. The process is not hidden.</p>
        <div class="ba-cta-row">
          <a class="ba-cta-inline" href="/contact?subject=consultation">Book a Consultation</a>
          <a class="ba-cta-inline ba-cta-inline--ghost" href="/contact?subject=bespoke">Commission a Piece</a>
        </div>
        <div class="ba-atelier__details">
          <a href="tel:+12136299191">213 629 9191</a><br />
          <a href="mailto:bez@bezambar.com">bez@bezambar.com</a><br />
          611 Wilshire Blvd, Los Angeles CA 90017
        </div>
      </div>
      <div class="ba-atelier__media">
        <video
          src="https://res.cloudinary.com/dlg2mou53/video/upload/f_auto,q_auto/v1782855871/videos/bracelets/emerald-cut-flex-bracelet-c0834-2026.mp4"
          autoplay loop muted playsinline preload="none"
        ></video>
      </div>
    </div>
  </div>
</Layout>

<script>
  (function () {
    const header = document.getElementById('baHeader');
    const hero = document.getElementById('about-hero');
    if (!header || !hero) return;
    function update() {
      header.classList.toggle('is-solid', hero.getBoundingClientRect().bottom <= 60);
    }
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
    update();
  })();
</script>
