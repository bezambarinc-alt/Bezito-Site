---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const allProducts = await getCollection('products', ({ data }) => data.status === 'live');
const bloomProducts = allProducts.filter(p => p.data.collection === 'bloom');

const calla = bloomProducts.find(p => p.data.slug === 'calla');
const camelia = bloomProducts.find(p => p.data.slug === 'camelia');

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Collections", "item": "https://bezambar.com/collection" },
      { "@type": "ListItem", "position": 2, "name": "The Bloom Collection", "item": "https://bezambar.com/collection/bloom" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "The Bloom Collection",
    "description": "One-stone pieces. Each ring built around a single exceptional diamond — the bloom rendered in a single petal of light.",
    "url": "https://bezambar.com/collection/bloom",
    "numberOfItems": bloomProducts.length,
    "brand": { "@type": "Brand", "name": "Bez Ambar" }
  }
];
---

<Layout
  title="The Bloom Collection — Bez Ambar"
  description="One-stone pieces. Each ring built around a single exceptional diamond — the bloom rendered in a single petal of light. By Bez Ambar, Los Angeles."
  canonical="https://bezambar.com/collection/bloom"
  structuredData={structuredData}
>

<style is:global>
  /* ── Hero ── */
  .bloom-hero {
    position: relative;
    width: 100%;
    height: 100svh;
    overflow: hidden;
    background: #0d0d0d;
  }
  .bloom-hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.75;
  }
  .bloom-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.65) 0%, transparent 60%);
  }
  .bloom-hero__text {
    position: absolute;
    bottom: 4rem;
    left: 50%;
    transform: translateX(-50%);
    text-align: center;
    color: #fff;
    width: 100%;
    padding: 0 20px;
  }
  .bloom-hero__eyebrow {
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: rgba(255,255,255,0.55);
    margin-bottom: 14px;
    display: block;
  }
  .bloom-hero__title {
    font-family: var(--serif, 'Cormorant Garamond', Georgia, serif);
    font-size: clamp(36px, 6vw, 68px);
    font-weight: 300;
    letter-spacing: 0.04em;
    color: #fff;
    margin: 0;
    line-height: 1.05;
  }
  .bloom-hero__lede {
    font-family: 'EB Garamond', Georgia, serif;
    font-style: italic;
    font-size: clamp(16px, 2vw, 20px);
    color: rgba(255,255,255,0.65);
    margin: 20px auto 0;
    max-width: 520px;
    line-height: 1.6;
  }

  /* ── Editorial modules ── */
  .bloom-module {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 640px;
  }
  .bloom-module--reverse { direction: rtl; }
  .bloom-module--reverse > * { direction: ltr; }

  .bloom-module__media {
    position: relative;
    overflow: hidden;
    background: #0d0d0d;
    min-height: 500px;
  }
  .bloom-module__media video,
  .bloom-module__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bloom-module__text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(48px, 7vw, 96px) clamp(40px, 6vw, 80px);
    background: #fff;
  }
  .bloom-module__eyebrow {
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--accent, #95826b);
    margin-bottom: 20px;
    display: block;
  }
  .bloom-module__heading {
    font-family: var(--serif, 'Cormorant Garamond', Georgia, serif);
    font-size: clamp(28px, 4vw, 46px);
    font-weight: 300;
    letter-spacing: 0.02em;
    color: #1a1a1a;
    line-height: 1.15;
    margin: 0 0 24px;
  }
  .bloom-module__body {
    font-family: 'EB Garamond', Georgia, serif;
    font-size: 18px;
    line-height: 1.75;
    color: #4a4a4a;
    margin-bottom: 36px;
    max-width: 420px;
  }
  .bloom-module__ref {
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    letter-spacing: 0.15em;
    color: #aaa;
    text-transform: uppercase;
    margin-bottom: 28px;
  }
  .bloom-module__link {
    display: inline-block;
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #1a1a1a;
    text-decoration: none;
    border-bottom: 1px solid var(--accent, #95826b);
    padding-bottom: 3px;
    transition: color 0.2s;
    align-self: flex-start;
  }
  .bloom-module__link:hover { color: var(--accent, #95826b); }

  /* ── Pull quote ── */
  .bloom-quote {
    padding: 100px 20px;
    text-align: center;
    background: #faf7f2;
  }
  .bloom-quote__mark {
    font-family: var(--serif, 'Cormorant Garamond', Georgia, serif);
    font-size: 48px;
    font-weight: 300;
    color: var(--accent, #95826b);
    line-height: 1;
    display: block;
    margin-bottom: 16px;
    opacity: 0.5;
  }
  .bloom-quote__text {
    font-family: var(--serif, 'Cormorant Garamond', Georgia, serif);
    font-size: clamp(22px, 4vw, 36px);
    font-weight: 300;
    font-style: italic;
    letter-spacing: 0.02em;
    color: #1a1a1a;
    max-width: 640px;
    margin: 0 auto;
    line-height: 1.4;
  }
  .bloom-quote__attr {
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #aaa;
    margin-top: 28px;
    display: block;
  }

  /* ── Pieces divider ── */
  .bloom-pieces-header {
    text-align: center;
    padding: 80px 20px 40px;
    background: #fff;
    border-top: 1px solid rgba(0,0,0,.06);
  }
  .bloom-pieces-header__eyebrow {
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: #999;
    margin-bottom: 12px;
    display: block;
  }
  .bloom-pieces-header__title {
    font-family: var(--serif, 'Cormorant Garamond', Georgia, serif);
    font-size: clamp(24px, 3.5vw, 38px);
    font-weight: 300;
    color: #1a1a1a;
    margin: 0;
  }

  /* ── Product grid ── */
  .bloom-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(12px, 2vw, 24px);
    max-width: 1200px;
    margin: 0 auto;
    padding: clamp(20px, 3vw, 40px);
    background: #fff;
  }
  .pcard {
    display: block;
    text-decoration: none;
    color: inherit;
    background: #faf7f2;
  }
  .pcard:hover .pcard__media video,
  .pcard:hover .pcard__media img { transform: scale(1.03); }
  .pcard__media {
    aspect-ratio: 4/5;
    overflow: hidden;
    background: #f0ede8;
    position: relative;
  }
  .pcard__media video,
  .pcard__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.7s ease;
  }
  .pcard--placeholder .pcard__media {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .pcard--placeholder .pcard__media::after {
    content: attr(data-label);
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #bbb;
  }
  .pcard__info {
    padding: 18px 20px 22px;
  }
  .pcard__collection {
    font-family: 'Inter', sans-serif;
    font-size: 9px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--accent, #95826b);
    margin-bottom: 6px;
  }
  .pcard__name {
    font-family: var(--serif, 'Cormorant Garamond', Georgia, serif);
    font-size: 22px;
    font-weight: 400;
    color: #1a1a1a;
    line-height: 1.2;
    margin-bottom: 4px;
  }
  .pcard__ref {
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    letter-spacing: 0.08em;
    color: #999;
  }
  .pcard--placeholder .pcard__name { color: #bbb; }
  .pcard--placeholder .pcard__ref { color: #ccc; }

  /* ── CTA ── */
  .bloom-cta {
    text-align: center;
    padding: 80px 20px;
    background: #1a1a1a;
    color: #fff;
  }
  .bloom-cta__eyebrow {
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: rgba(255,255,255,0.4);
    margin-bottom: 16px;
    display: block;
  }
  .bloom-cta__title {
    font-family: var(--serif, 'Cormorant Garamond', Georgia, serif);
    font-size: clamp(28px, 4vw, 44px);
    font-weight: 300;
    letter-spacing: 0.03em;
    color: #fff;
    margin: 0 0 16px;
    line-height: 1.15;
  }
  .bloom-cta__body {
    font-family: 'EB Garamond', Georgia, serif;
    font-size: 17px;
    color: rgba(255,255,255,0.55);
    max-width: 480px;
    margin: 0 auto 32px;
    line-height: 1.65;
  }
  .bloom-cta__btn {
    display: inline-block;
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #fff;
    text-decoration: none;
    border: 1px solid rgba(255,255,255,0.3);
    padding: 16px 40px;
    transition: border-color 0.2s, color 0.2s;
  }
  .bloom-cta__btn:hover {
    border-color: var(--accent, #95826b);
    color: var(--accent, #95826b);
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .bloom-module { grid-template-columns: 1fr; min-height: auto; }
    .bloom-module--reverse { direction: ltr; }
    .bloom-module__media { min-height: 400px; position: relative; height: 400px; }
    .bloom-module__media video,
    .bloom-module__media img { position: absolute; }
    .bloom-grid { grid-template-columns: 1fr; }
  }
</style>

<!-- ── HERO ── -->
<section class="bloom-hero">
  {calla?.data.heroVideo && (
    <video class="bloom-hero__video" src={calla.data.heroVideo} autoplay loop muted playsinline></video>
  )}
  <div class="bloom-hero__overlay"></div>
  <div class="bloom-hero__text">
    <span class="bloom-hero__eyebrow">Bez Ambar</span>
    <h1 class="bloom-hero__title">The Bloom Collection</h1>
    <p class="bloom-hero__lede">One stone. Each ring built around a single exceptional diamond.</p>
  </div>
</section>

<!-- ── MODULE 1: The Calla ── -->
{calla && (
  <div class="bloom-module">
    <div class="bloom-module__media">
      {calla.data.heroVideo
        ? <video src={calla.data.heroVideo} autoplay loop muted playsinline></video>
        : <img src={calla.data.heroImage} alt={calla.data.title} loading="lazy" />
      }
    </div>
    <div class="bloom-module__text">
      <span class="bloom-module__eyebrow">The Calla &nbsp;&middot;&nbsp; ref. {calla.data.refCode}</span>
      <h2 class="bloom-module__heading">The Petal<br />Setting</h2>
      <p class="bloom-module__ref">{calla.data.stone.carats} ct {calla.data.stone.color} {calla.data.stone.clarity} &middot; {calla.data.stone.shape} &middot; {calla.data.metal}</p>
      <p class="bloom-module__body">Beneath the 13-carat D-flawless pear, a ring of marquise-cut diamonds opens like petals around the pavilion, passing fire upward into the stone from below. The bloom is structural. The light is the design.</p>
      <a class="bloom-module__link" href={calla.data.prettyUrl}>View The Calla</a>
    </div>
  </div>
)}

<!-- ── MODULE 2: Camélia ── -->
{camelia && (
  <div class="bloom-module bloom-module--reverse">
    <div class="bloom-module__media">
      {camelia.data.heroVideo
        ? <video src={camelia.data.heroVideo} autoplay loop muted playsinline></video>
        : <img src={camelia.data.heroImage} alt={camelia.data.title} loading="lazy" />
      }
    </div>
    <div class="bloom-module__text">
      <span class="bloom-module__eyebrow">Cam&eacute;lia &nbsp;&middot;&nbsp; ref. {camelia.data.refCode}</span>
      <h2 class="bloom-module__heading">Color<br />Inside Colorless</h2>
      <p class="bloom-module__ref">{camelia.data.stone.carats} ct {camelia.data.stone.color} {camelia.data.stone.clarity} &middot; {camelia.data.stone.shape} &middot; {camelia.data.metal}</p>
      <p class="bloom-module__body">A 25-carat D VS2 colorless oval, cut without bowtie, framed entirely in fancy intense pink diamonds with matching pave down the split shank. The contrast is the design. The stone sets its own condition.</p>
      <a class="bloom-module__link" href={camelia.data.prettyUrl}>View Cam&eacute;lia</a>
    </div>
  </div>
)}

<!-- ── PULL QUOTE ── -->
<section class="bloom-quote">
  <span class="bloom-quote__mark">&ldquo;</span>
  <p class="bloom-quote__text">Every bloom begins with one stone. The setting exists only to make that stone breathe.</p>
  <span class="bloom-quote__attr">Bez Ambar</span>
</section>

<!-- ── PIECES HEADER ── -->
<div class="bloom-pieces-header">
  <span class="bloom-pieces-header__eyebrow">The Bloom Collection</span>
  <h2 class="bloom-pieces-header__title">The Pieces</h2>
</div>

<!-- ── PRODUCT GRID ── -->
<section class="bloom-grid">
  {bloomProducts.map(p => (
    <a class="pcard" href={p.data.prettyUrl}>
      <div class="pcard__media">
        {p.data.heroVideo
          ? <video src={p.data.heroVideo} autoplay loop muted playsinline></video>
          : <img src={p.data.heroImage} alt={p.data.title} loading="lazy" />
        }
      </div>
      <div class="pcard__info">
        <p class="pcard__collection">
          {p.data.category.replace(/-/g, ' ').replace(/\b\w/g, (l: string) => l.toUpperCase())}
          &nbsp;&middot;&nbsp; Bloom Collection
        </p>
        <p class="pcard__name">{p.data.title}</p>
        <p class="pcard__ref">ref. {p.data.refCode}</p>
      </div>
    </a>
  ))}
  <a class="pcard pcard--placeholder" href="#" aria-hidden="true" tabindex="-1">
    <div class="pcard__media" data-label="Coming Soon"></div>
    <div class="pcard__info">
      <p class="pcard__collection">Bloom Collection</p>
      <p class="pcard__name">Coming Soon</p>
      <p class="pcard__ref">ref. &mdash;</p>
    </div>
  </a>
  <a class="pcard pcard--placeholder" href="#" aria-hidden="true" tabindex="-1">
    <div class="pcard__media" data-label="Coming Soon"></div>
    <div class="pcard__info">
      <p class="pcard__collection">Bloom Collection</p>
      <p class="pcard__name">Coming Soon</p>
      <p class="pcard__ref">ref. &mdash;</p>
    </div>
  </a>
</section>

<!-- ── CTA ── -->
<section class="bloom-cta">
  <span class="bloom-cta__eyebrow">Don&rsquo;t See It</span>
  <h2 class="bloom-cta__title">Commission a Piece</h2>
  <p class="bloom-cta__body">If the piece you're looking for isn't here, it can be made. Every Bez Ambar piece begins with one stone and one drawing.</p>
  <a href="/contact?subject=Bespoke%20Commission%20%E2%80%94%20Inquiry" class="bloom-cta__btn">Inquire</a>
</section>

</Layout>
