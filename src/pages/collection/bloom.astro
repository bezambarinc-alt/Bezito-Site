---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const allProducts = await getCollection('products', ({ data }) => data.status === 'live');
const bloomProducts = allProducts.filter(p => p.data.collection === 'bloom');

const calla = bloomProducts.find(p => p.data.slug === 'calla');
const camelia = bloomProducts.find(p => p.data.slug === 'camelia');

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Collections", "item": "https://bezambar.com/collection" },
      { "@type": "ListItem", "position": 2, "name": "The Bloom Collection", "item": "https://bezambar.com/collection/bloom" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "The Bloom Collection",
    "description": "One-stone pieces. Each ring built around a single exceptional diamond — the bloom rendered in a single petal of light.",
    "url": "https://bezambar.com/collection/bloom",
    "numberOfItems": bloomProducts.length,
    "brand": { "@type": "Brand", "name": "Bez Ambar" }
  }
];
---

<Layout
  title="The Bloom Collection — Bez Ambar"
  description="One-stone pieces. Each ring built around a single exceptional diamond — the bloom rendered in a single petal of light. By Bez Ambar, Los Angeles."
  canonical="https://bezambar.com/collection/bloom"
  structuredData={structuredData}
>

<!-- ── HERO ── -->
<section class="ba-portrait-hero ba-portrait-hero--serif">
  {calla?.data.heroVideo && (
    <video src={calla.data.heroVideo} autoplay loop muted playsinline></video>
  )}
  <div class="ba-portrait-hero__overlay">
    <span class="ba-portrait-hero__eyebrow">Bez Ambar</span>
    <h1 class="ba-portrait-hero__title">The Bloom Collection</h1>
    <p class="ba-portrait-hero__lede">One stone. Each ring built around a single exceptional diamond.</p>
  </div>
</section>

<!-- ── MODULE 1: The Calla ── -->
{calla && (
  <div class="ba-segment">
    <div class="ba-segment__media">
      {calla.data.heroVideo
        ? <video src={calla.data.heroVideo} autoplay loop muted playsinline></video>
        : <img src={calla.data.heroImage} alt={calla.data.title} loading="lazy" />
      }
    </div>
    <div class="ba-segment__text">
      <span class="ba-eyebrow">The Calla &nbsp;&middot;&nbsp; ref. {calla.data.refCode}</span>
      <h2 class="ba-segment__heading">The Petal<br />Setting</h2>
      <p class="ba-segment__ref">{calla.data.stone.carats} ct {calla.data.stone.color} {calla.data.stone.clarity} &middot; {calla.data.stone.shape} &middot; {calla.data.metal}</p>
      <p class="ba-segment__body">Beneath the 13-carat D-flawless pear, a ring of marquise-cut diamonds opens like petals around the pavilion, passing fire upward into the stone from below. The bloom is structural. The light is the design.</p>
      <a class="ba-segment__link" href={calla.data.prettyUrl}>View The Calla</a>
    </div>
  </div>
)}

<!-- ── MODULE 2: Camélia ── -->
{camelia && (
  <div class="ba-segment ba-segment--reverse">
    <div class="ba-segment__media">
      {camelia.data.heroVideo
        ? <video src={camelia.data.heroVideo} autoplay loop muted playsinline></video>
        : <img src={camelia.data.heroImage} alt={camelia.data.title} loading="lazy" />
      }
    </div>
    <div class="ba-segment__text">
      <span class="ba-eyebrow">Cam&eacute;lia &nbsp;&middot;&nbsp; ref. {camelia.data.refCode}</span>
      <h2 class="ba-segment__heading">Color<br />Inside Colorless</h2>
      <p class="ba-segment__ref">{camelia.data.stone.carats} ct {camelia.data.stone.color} {camelia.data.stone.clarity} &middot; {camelia.data.stone.shape} &middot; {camelia.data.metal}</p>
      <p class="ba-segment__body">A 25-carat D VS2 colorless oval, cut without bowtie, framed entirely in fancy intense pink diamonds with matching pave down the split shank. The contrast is the design. The stone sets its own condition.</p>
      <a class="ba-segment__link" href={camelia.data.prettyUrl}>View Cam&eacute;lia</a>
    </div>
  </div>
)}

<!-- ── PULL QUOTE ── -->
<section class="ba-pull-quote">
  <span class="ba-pull-quote__mark">&ldquo;</span>
  <p class="ba-pull-quote__text">Every bloom begins with one stone. The setting exists only to make that stone breathe.</p>
  <span class="ba-pull-quote__attr">Bez Ambar</span>
</section>

<!-- ── PIECES HEADER ── -->
<div class="ba-section-divider">
  <span class="ba-section-divider__eyebrow">The Bloom Collection</span>
  <h2 class="ba-section-divider__title">The Pieces</h2>
</div>

<!-- ── PRODUCT GRID ── -->
<section class="ba-product-grid">
  {bloomProducts.map(p => (
    <a class="ba-card" href={p.data.prettyUrl}>
      <div class="ba-card__media">
        {p.data.heroVideo
          ? <video src={p.data.heroVideo} autoplay loop muted playsinline></video>
          : <img src={p.data.heroImage} alt={p.data.title} loading="lazy" />
        }
      </div>
      <div class="ba-card__info">
        <p class="ba-card__collection">
          {p.data.category.replace(/-/g, ' ').replace(/\b\w/g, (l: string) => l.toUpperCase())}
          &nbsp;&middot;&nbsp; Bloom Collection
        </p>
        <p class="ba-card__name">{p.data.title}</p>
        <p class="ba-card__ref">ref. {p.data.refCode}</p>
      </div>
    </a>
  ))}
  <a class="ba-card pcard--placeholder" href="#" aria-hidden="true" tabindex="-1">
    <div class="ba-card__media" data-label="Coming Soon"></div>
    <div class="ba-card__info">
      <p class="ba-card__collection">Bloom Collection</p>
      <p class="ba-card__name">Coming Soon</p>
      <p class="ba-card__ref">ref. &mdash;</p>
    </div>
  </a>
  <a class="ba-card pcard--placeholder" href="#" aria-hidden="true" tabindex="-1">
    <div class="ba-card__media" data-label="Coming Soon"></div>
    <div class="ba-card__info">
      <p class="ba-card__collection">Bloom Collection</p>
      <p class="ba-card__name">Coming Soon</p>
      <p class="ba-card__ref">ref. &mdash;</p>
    </div>
  </a>
</section>

<!-- ── CTA ── -->
<section class="ba-cta">
  <span class="ba-cta__eyebrow">Don&rsquo;t See It</span>
  <h2 class="ba-cta__title">Commission a Piece</h2>
  <p class="ba-cta__body">If the piece you're looking for isn't here, it can be made. Every Bez Ambar piece begins with one stone and one drawing.</p>
  <a href="/contact?subject=Bespoke%20Commission%20%E2%80%94%20Inquiry" class="ba-cta__btn">Inquire</a>
</section>

</Layout>
