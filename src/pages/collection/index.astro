---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const allProducts = await getCollection('products', ({ data }) => data.status === 'live');

const CATEGORIES = [
  {
    slug: 'bracelets',
    label: 'Bracelets',
    tagline: 'The patented Flex — two decades of engineering.',
    desc: 'Diamonds that move freely on the wrist, no hinge or clasp in sight. Each bracelet is built by hand in our Los Angeles atelier.',
  },
  {
    slug: 'rings',
    label: 'Rings',
    tagline: 'From fancy-color solitaires to multi-stone designs.',
    desc: 'Every ring is cut and set by hand. Fancy-color diamonds, colored stones, and precision baguettes — made to order, made to last.',
  },
  {
    slug: 'engagement-rings',
    label: 'Engagement Rings',
    tagline: 'Every ring a private commission.',
    desc: 'We source the stone, design the setting, and build the ring to your specification. No catalogue — only intention.',
  },
  {
    slug: 'wedding-bands',
    label: 'Wedding Bands',
    tagline: 'Precision-set diamonds for a lifetime.',
    desc: 'Baguette and brilliant-cut diamonds in platinum and 18K gold. Sizing and stone selection made to order.',
  },
  {
    slug: 'necklaces',
    label: 'Necklaces',
    tagline: 'Clean geometry, exceptional stones.',
    desc: 'Each necklace is designed around the diamond — the setting exists only to let the stone breathe.',
  },
  {
    slug: 'pendants',
    label: 'Pendants',
    tagline: 'A single stone. A complete statement.',
    desc: 'Shaped by the stone, not convention. Each pendant is chosen for its proportions and worn as a declaration.',
  },
  {
    slug: 'earrings',
    label: 'Earrings',
    tagline: 'Light at every turn.',
    desc: 'From quiet studs to architectural drops — each pair is made to catch the light and hold the eye.',
  },
];

// Per-category: best video + poster/fallback image + piece count
type CatMedia = { video: string | null; image: string | null; count: number };
const categoryMedia: Record<string, CatMedia> = {};
for (const cat of CATEGORIES) {
  const catProducts = allProducts.filter(p => p.data.category === cat.slug);
  const withVideo = catProducts.find(p => p.data.heroVideo);
  const withImage = catProducts.find(p => p.data.heroImage);
  categoryMedia[cat.slug] = {
    video: withVideo?.data.heroVideo ?? null,
    image: withVideo?.data.heroImage ?? withImage?.data.heroImage ?? null,
    count: catProducts.length,
  };
}

const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Collection — Bez Ambar",
  "description": "Browse the complete Bez Ambar collection — flex bracelets, engagement rings, wedding bands, necklaces, earrings and pendants. Handcrafted in Los Angeles.",
  "url": "https://bezambar.com/collection",
  "brand": { "@type": "Brand", "name": "Bez Ambar" },
};
---

<Layout
  title="Collection — Luxury Diamond Jewelry | Bez Ambar"
  description="Browse the complete Bez Ambar collection — flex bracelets, engagement rings, wedding bands, necklaces, earrings and pendants. Handcrafted in Los Angeles."
  canonical="https://bezambar.com/collection"
  structuredData={[structuredData]}
>

<section class="ba-category-hero">
  <video
    src="https://res.cloudinary.com/dlg2mou53/video/upload/q_auto/v1782941822/videos/bracelets/blue-sapphire-single-row-flex-c0825-2026.mp4"
    poster="https://res.cloudinary.com/dlg2mou53/video/upload/so_2.0,f_jpg,w_900/v1782941822/videos/bracelets/blue-sapphire-single-row-flex-c0825-2026.jpg"
    autoplay muted loop playsinline
  ></video>
  <div class="ba-category-hero__overlay"></div>
  <div class="ba-category-hero__text">
    <h1>Collection</h1>
    <p class="ba-category-hero__intro">Every piece handcrafted in our Los Angeles atelier.</p>
  </div>
</section>

<div class="ba-collection-editorial">
  {CATEGORIES.map((cat, i) => {
    const media = categoryMedia[cat.slug];
    const isFlipped = i % 2 === 1;
    const href = `/jewelry/${cat.slug}`;
    return (
      <article class={`ba-collection-tile${isFlipped ? ' ba-collection-tile--flip' : ''}`}>

        <div class="ba-collection-tile__media">
          {media.video ? (
            <video src={media.video} poster={media.image ?? undefined} autoplay muted loop playsinline></video>
          ) : media.image ? (
            <img src={media.image} alt={cat.label} loading="lazy" />
          ) : (
            <div style="width:100%;height:100%;background:var(--light-bg);" />
          )}
        </div>

        <div class="ba-collection-tile__text">
          <p class="ba-collection-tile__eyebrow">Bez Ambar</p>
          <h2 class="ba-collection-tile__title">{cat.label}</h2>
          <p class="ba-collection-tile__tagline">{cat.tagline}</p>
          <p class="ba-collection-tile__desc">{cat.desc}</p>
          {media.count > 0 && (
            <p class="ba-collection-tile__meta">{media.count} {media.count === 1 ? 'piece' : 'pieces'} available</p>
          )}
          <a href={href} class="ba-collection-tile__cta">
            {media.count > 0 ? 'Explore' : 'Inquire'}
          </a>
        </div>

      </article>
    );
  })}
</div>

</Layout>
