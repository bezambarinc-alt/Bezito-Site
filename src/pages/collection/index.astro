</style>

<script>
  function filterLV(category, label, e) {
    e.preventDefault();
    document.getElementById('catLabel').textContent = label;
    document.getElementById('catDropdown').classList.remove('open');
    document.querySelectorAll('.lv-cat-menu a').forEach(a => a.classList.remove('active-cat'));
    if (e && e.target) e.target.classList.add('active-cat');
    document.querySelectorAll('.lv-product-card').forEach(card => {
      const cats = (card.dataset.category || '').split(' ');
      if (category === 'all') {
        card.style.display = '';
      } else if (category === 'earrings') {
        card.style.display = cats.includes('earrings') ? '' : 'none';
      } else if (category === 'rings') {
        card.style.display = cats.includes('rings') ? '' : 'none';
      } else {
        card.style.display = cats.includes(category) ? '' : 'none';
      }
    });
  }

  document.addEventListener('click', function(e) {
    const dd = document.getElementById('catDropdown');
    if (dd && !dd.contains(e.target)) dd.classList.remove('open');
  });

  (function() {
    const params = new URLSearchParams(window.location.search);
    const cat = params.get('cat');
    if (!cat) return;
    const labels = {
      rings: 'Rings', pendants: 'Pendants', necklaces: 'Necklaces',
      earrings: 'Earrings', bracelets: 'Bracelets',
      'stud-earrings': 'Stud Earrings', 'hug-earrings': 'Hug Earrings',
      'hoop-earrings': 'Hoop Earrings', 'engagement-rings': 'Engagement Rings',
      'wedding-bands': 'Wedding Bands', 'mens-wedding-bands': "Men's Wedding Bands"
    };
    if (!labels[cat]) return;
    document.getElementById('catLabel').textContent = labels[cat];
    document.querySelectorAll('.lv-product-card').forEach(card => {
      const cats = (card.dataset.category || '').split(' ');
      if (cat === 'earrings') {
        card.style.display = cats.includes('earrings') ? '' : 'none';
      } else {
        card.style.display = cats.includes(cat) ? '' : 'none';
      }
    });
    document.querySelectorAll('.lv-cat-menu a').forEach(a => {
      if (a.textContent.trim() === labels[cat]) a.classList.add('active-cat');
    });
  })();
</script>

</Layout>
