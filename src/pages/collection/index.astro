---
import Layout from '../../layouts/Layout.astro';

const wishlistSvg = `<svg class="lv-card-wishlist" viewBox="0 0 24 24" fill="none"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" stroke="currentColor" stroke-width="1.5"/></svg>`;
---

<Layout
  title="Collection — Luxury Diamond Jewelry | Bez Ambar"
  description="Browse the complete Bez Ambar collection — flex bracelets, engagement rings, wedding bands, necklaces, earrings and pendants. Made in Los Angeles."
  canonical="https://bezambar.com/collection"
  theme="dark"
>


<!-- Category Bar -->
<div class="lv-collection-bar" style="padding-top:84px;">
  <div class="lv-cat-dropdown" id="catDropdown">
    <button onclick="document.getElementById('catDropdown').classList.toggle('open')">
      <span id="catLabel">All Jewelry</span>
      <svg viewBox="0 0 10 6" fill="none"><path d="M1 1 L5 5 L9 1" stroke="currentColor" stroke-width="1.2"/></svg>
    </button>
    <div class="lv-cat-menu">
      <span class="cat-label">Categories</span>
      <a href="#" class="active-cat" onclick="filterLV('all', 'All Jewelry', event)">All Jewelry</a>
      <a href="#" onclick="filterLV('rings', 'Rings', event)">Rings</a>
      <a href="#" onclick="filterLV('engagement-rings', 'Engagement Rings', event)" style="padding-left:28px;font-size:11px;">Engagement Rings</a>
      <a href="#" onclick="filterLV('wedding-bands', 'Wedding Bands', event)" style="padding-left:28px;font-size:11px;">Wedding Bands</a>
      <a href="#" onclick="filterLV('mens-wedding-bands', 'Men\'s Wedding Bands', event)" style="padding-left:28px;font-size:11px;">Men's Wedding Bands</a>
      <a href="#" onclick="filterLV('pendants', 'Pendants', event)">Pendants</a>
      <a href="#" onclick="filterLV('necklaces', 'Necklaces', event)">Necklaces</a>
      <a href="#" onclick="filterLV('earrings', 'Earrings', event)">Earrings</a>
      <a href="#" onclick="filterLV('stud-earrings', 'Stud Earrings', event)" style="padding-left:28px;font-size:11px;">Stud Earrings</a>
      <a href="#" onclick="filterLV('hug-earrings', 'Hug Earrings', event)" style="padding-left:28px;font-size:11px;">Hug Earrings</a>
      <a href="#" onclick="filterLV('hoop-earrings', 'Hoop Earrings', event)" style="padding-left:28px;font-size:11px;">Hoop Earrings</a>
      <a href="#" onclick="filterLV('bracelets', 'Bracelets', event)">Bracelets</a>
    </div>
  </div>
</div>

