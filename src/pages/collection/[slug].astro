---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  return Object.keys(COLLECTIONS).map(slug => ({ params: { slug } }));
}

interface Spotlight {
  pieceSlug: string;
  heading: string;
  body: string;
}

interface CollectionMeta {
  name: string;
  title: string;
  description: string;
  lede: string;
  quote: string;
  quoteAttr: string;
  spotlights: Spotlight[];
}

const COLLECTIONS: Record<string, CollectionMeta> = {
  bloom: {
    name: 'The Bloom Collection',
    title: 'The Bloom Collection — Bez Ambar',
    description: 'One-stone pieces. Each ring built around a single exceptional diamond — the bloom rendered in a single petal of light. By Bez Ambar, Los Angeles.',
    lede: 'One stone. Each ring built around a single exceptional diamond.',
    quote: 'Every bloom begins with one stone. The setting exists only to make that stone breathe.',
    quoteAttr: 'Bez Ambar',
    spotlights: [
      {
        pieceSlug: 'calla',
        heading: 'The Petal\nSetting',
        body: 'Beneath the 13-carat D-flawless pear, a ring of marquise-cut diamonds opens like petals around the pavilion, passing fire upward into the stone from below. The bloom is structural. The light is the design.',
      },
      {
        pieceSlug: 'camelia',
        heading: 'Color\nInside Colorless',
        body: 'A 25-carat D VS2 colorless oval, cut without bowtie, framed entirely in fancy intense pink diamonds with matching pave down the split shank. The contrast is the design. The stone sets its own condition.',
      },
    ],
  },
  dentelle: {
    name: 'Dentelle Collection',
    title: 'Dentelle Collection — Bez Ambar',
    description: 'Lace in diamond. Each piece rendered in fine baguettes and brilliant-cut stones — structure as ornament, precision as poetry. By Bez Ambar, Los Angeles.',
    lede: 'Lace in diamond. Structure as ornament, precision as poetry.',
    quote: 'Lace exists at the edge of structure and dissolution. We made it in diamond.',
    quoteAttr: 'Bez Ambar',
    spotlights: [],
  },
};

const { slug } = Astro.params;
const col = COLLECTIONS[slug];

const allProducts = await getCollection('products', ({ data }) => data.status === 'live');
const colProducts = allProducts.filter(p => p.data.collection === slug);

const spotlightProducts = col.spotlights.map(s => ({
  meta: s,
  product: colProducts.find(p => p.data.slug === s.pieceSlug),
}));

const heroProduct = colProducts[0] ?? spotlightProducts[0]?.product;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Collections', item: 'https://bezambar.com/collection' },
      { '@type': 'ListItem', position: 2, name: col.name, item: `https://bezambar.com/collection/${slug}` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: col.name,
    description: col.description,
    url: `https://bezambar.com/collection/${slug}`,
    numberOfItems: colProducts.length,
    brand: { '@type': 'Brand', name: 'Bez Ambar' },
  },
];
---

<Layout
  title={col.title}
  description={col.description}
  canonical={`https://bezambar.com/collection/${slug}`}
  structuredData={structuredData}
>

<!-- ── HERO ── -->
<section class="ba-portrait-hero">
  {heroProduct?.data.heroVideo && (
    <video src={heroProduct.data.heroVideo} autoplay loop muted playsinline></video>
  )}
  {!heroProduct?.data.heroVideo && heroProduct?.data.heroImage && (
    <img src={heroProduct.data.heroImage} alt={col.name} />
  )}
  <div class="ba-portrait-hero__overlay">
    <span class="ba-portrait-hero__eyebrow">Bez Ambar</span>
    <h1 class="ba-portrait-hero__title">{col.name}</h1>
    <p class="ba-portrait-hero__lede">{col.lede}</p>
  </div>
</section>

<!-- ── SPOTLIGHT MODULES ── -->
{spotlightProducts.map(({ meta, product }, i) => product && (
  <div class={`ba-segment${i % 2 === 1 ? ' ba-segment--reverse' : ''}`}>
    <div class="ba-segment__media">
      {product.data.heroVideo
        ? <video src={product.data.heroVideo} autoplay loop muted playsinline></video>
        : <img src={product.data.heroImage} alt={product.data.title} loading="lazy" />
      }
    </div>
    <div class="ba-segment__text">
      <span class="ba-eyebrow">{product.data.title} &nbsp;&middot;&nbsp; ref. {product.data.refCode}</span>
      <h2 class="ba-segment__heading">{meta.heading.split('\n').map((line, j) => j > 0 ? <><br />{line}</> : line)}</h2>
      <p class="ba-segment__ref">{product.data.stone?.carats} ct {product.data.stone?.color} {product.data.stone?.clarity} &middot; {product.data.stone?.shape} &middot; {product.data.metal}</p>
      <p class="ba-segment__body">{meta.body}</p>
      <a class="ba-segment__link" href={product.data.prettyUrl}>View {product.data.title}</a>
    </div>
  </div>
))}

<!-- ── PULL QUOTE ── -->
<section class="ba-pull-quote">
  <span class="ba-pull-quote__mark">&ldquo;</span>
  <p class="ba-pull-quote__text">{col.quote}</p>
  <span class="ba-pull-quote__attr">{col.quoteAttr}</span>
</section>

<!-- ── PIECES HEADER ── -->
<div class="ba-section-divider">
  <span class="ba-section-divider__eyebrow">{col.name}</span>
  <h2 class="ba-section-divider__title">The Pieces</h2>
</div>

<!-- ── PRODUCT GRID ── -->
<section class="ba-product-grid">
  {colProducts.map(p => (
    <a class="ba-card" href={p.data.prettyUrl}>
      <div class="ba-card__media">
        {p.data.heroVideo
          ? <video src={p.data.heroVideo} autoplay loop muted playsinline></video>
          : <img src={p.data.heroImage} alt={p.data.title} loading="lazy" />
        }
      </div>
      <div class="ba-card__info">
        <p class="ba-card__collection">
          {p.data.category.replace(/-/g, ' ').replace(/\b\w/g, (l: string) => l.toUpperCase())}
          &nbsp;&middot;&nbsp; {col.name}
        </p>
        <p class="ba-card__name">{p.data.title}</p>
        <p class="ba-card__ref">ref. {p.data.refCode}</p>
      </div>
    </a>
  ))}
  {colProducts.length === 0 && (
    <>
      <a class="ba-card pcard--placeholder" href="#" aria-hidden="true" tabindex="-1">
        <div class="ba-card__media" data-label="Coming Soon"></div>
        <div class="ba-card__info">
          <p class="ba-card__collection">{col.name}</p>
          <p class="ba-card__name">Coming Soon</p>
          <p class="ba-card__ref">ref. &mdash;</p>
        </div>
      </a>
      <a class="ba-card pcard--placeholder" href="#" aria-hidden="true" tabindex="-1">
        <div class="ba-card__media" data-label="Coming Soon"></div>
        <div class="ba-card__info">
          <p class="ba-card__collection">{col.name}</p>
          <p class="ba-card__name">Coming Soon</p>
          <p class="ba-card__ref">ref. &mdash;</p>
        </div>
      </a>
    </>
  )}
</section>

<!-- ── CTA ── -->
<section class="ba-cta">
  <span class="ba-cta__eyebrow">Don&rsquo;t See It</span>
  <h2 class="ba-cta__title">Commission a Piece</h2>
  <p class="ba-cta__body">If the piece you're looking for isn't here, it can be made. Every Bez Ambar piece begins with one stone and one drawing.</p>
  <a href="/contact?subject=Bespoke%20Commission%20%E2%80%94%20Inquiry" class="ba-cta__btn">Inquire</a>
</section>

</Layout>
