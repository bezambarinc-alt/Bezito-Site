---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import '../../../styles/templates/product.css';

export async function getStaticPaths() {
  const products = await getCollection('products', ({ data }) => data.status === 'live');
  return products.map(entry => ({
    params: { category: entry.data.category, slug: entry.data.slug },
    props: { product: entry.data },
  }));
}

const { product } = Astro.props;

const categoryLabel = product.category
  .replace(/-/g, ' ')
  .replace(/\b\w/g, (l: string) => l.toUpperCase());

const COLLECTION_LABELS: Record<string, string> = {
  signature: 'Signature Pieces',
  bloom: 'Bloom Collection',
  dentelle: 'Dentelle Collection',
};
const eyebrow = product.collection
  ? (COLLECTION_LABELS[product.collection] ?? `${product.collection.charAt(0).toUpperCase()}${product.collection.slice(1)} Collection`)
  : categoryLabel;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Jewelry", "item": "https://bezambar.com/collection" },
      { "@type": "ListItem", "position": 2, "name": categoryLabel, "item": `https://bezambar.com/collection?cat=${product.category}` },
      { "@type": "ListItem", "position": 3, "name": product.title, "item": `https://bezambar.com${product.prettyUrl}` }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": product.title,
    "sku": product.sku,
    "productID": product.refCode,
    "description": product.description,
    "image": product.heroImage || undefined,
    "url": `https://bezambar.com${product.prettyUrl}`,
    "brand": {
      "@type": "Brand",
      "name": "Bez Ambar",
      "url": "https://bezambar.com"
    },
    "manufacturer": {
      "@type": "Person",
      "name": "Bez Ambar",
      "jobTitle": "Master Diamond Cutter and Jewelry Designer",
      "description": "One of the original architects of the modern Princess Cut (1979); inventor of the Blaze® and the Elysian Cut™."
    },
    "offers": {
      "@type": "Offer",
      "url": `https://bezambar.com/contact?subject=${encodeURIComponent(product.inquirySubject)}`,
      "priceCurrency": "USD",
      "availability": "https://schema.org/InStock",
      "seller": { "@type": "Organization", "name": "Bez Ambar" }
    }
  }
];

const ogImage = product.heroImage
  || `https://res.cloudinary.com/dlg2mou53/image/upload/c_fill,w_1200,h_630,g_auto,f_auto,q_auto/v1775786208/Quadrillion_owciyv.jpg`;
---

<Layout
  title={`${product.title} ref. ${product.refCode} — Bez Ambar`}
  description={product.description}
  canonical={`https://bezambar.com${product.prettyUrl}`}
  ogImage={ogImage}
  ogType="product"
  pageType="product"
  structuredData={structuredData}
>
  {product.heroVideo ? (
    <div class="hero-video" id="hero-video">
      <video src={product.heroVideo} autoplay loop muted playsinline preload="auto"></video>
      <div class="hero-video__ref">
        <div class="hero-video__ref-id">{product.refCode}</div>
        <div class="hero-video__ref-name">{product.title}</div>
      </div>
    </div>
  ) : product.heroImage ? (
    <div class="hero-video" id="hero-video">
      <img src={product.heroImage} alt={product.title} loading="eager" />
      <div class="hero-video__ref">
        <div class="hero-video__ref-id">{product.refCode}</div>
        <div class="hero-video__ref-name">{product.title}</div>
      </div>
    </div>
  ) : null}

  <section class="hero">
    <nav class="breadcrumb" aria-label="breadcrumb">
      <a href="/collection">Jewelry</a>
      <span aria-hidden="true">/</span>
      <a href={`/collection?cat=${product.category}`}>{categoryLabel}</a>
      <span aria-hidden="true">/</span>
      <span>{product.title}</span>
    </nav>
    <p class="hero__eyebrow">{eyebrow}</p>
    <h1 class="hero__title">
      {product.title}
      {product.subtitle && <span class="hero__subtitle">{product.subtitle}</span>}
    </h1>
    <p class="hero__lede">{product.description}</p>
    <button class="hero__cta" id="prodInquireBtn">Inquire</button>
  </section>

  {product.images.length > 0 && (
    <div class="hero-video hero-video--secondary">
      {product.images[0].endsWith('.mp4') ? (
        <video src={product.images[0]} autoplay loop muted playsinline preload="auto"></video>
      ) : (
        <img src={product.images[0]} alt={`${product.title} — detail`} loading="lazy" />
      )}
    </div>
  )}

  <section class="technical" id="technical">
    <div class="technical__inner">
      <h2 class="technical__title">Technical Details</h2>
      <div class="technical__list">
        <details class="tech-item" open>
          <summary class="tech-item__head">Gem Stone</summary>
          <div class="tech-item__body">
            <p>
              {[
                product.stone.carats && `${product.stone.carats} carats`,
                product.stone.color,
                product.stone.clarity && `${product.stone.clarity} clarity`,
                product.stone.shape,
              ].filter(Boolean).join(' · ')}
              {product.stone.origin && ` — ${product.stone.origin}`}
            </p>
          </div>
        </details>
        <details class="tech-item">
          <summary class="tech-item__head">Metal</summary>
          <div class="tech-item__body">
            <p>{product.metal}</p>
          </div>
        </details>
        <details class="tech-item">
          <summary class="tech-item__head">Made in</summary>
          <div class="tech-item__body">
            <p>Los Angeles, California, USA. Handcrafted by Bez Ambar.</p>
          </div>
        </details>
        <details class="tech-item">
          <summary class="tech-item__head">Inquiry</summary>
          <div class="tech-item__body">
            <p>Each piece is made to specification. Pricing on request. <button class="tech-inline-btn" id="prodInquireBtn2">Send an inquiry.</button></p>
          </div>
        </details>
      </div>
    </div>
  </section>

  <section class="product-cta" id="inquire">
    <h2 class="product-cta__title">See It in Person</h2>
    <p class="product-cta__body">Every piece is available to view by appointment at our Los Angeles atelier. Call <a href="tel:2136299191">(213) 629-9191</a> or send an inquiry below.</p>
    <button class="product-cta__btn" id="prodInquireBtn3">Inquire About This Piece</button>
  </section>

  <!-- Inquiry Modal -->
  <div class="inq-backdrop" id="inqBackdrop" aria-hidden="true"></div>
  <div class="inq-modal" id="inqModal" role="dialog" aria-modal="true" hidden>
    <button class="inq-modal__close" id="inqClose" aria-label="Close">&#x2715;</button>
    <div class="inq-modal__media">
      {product.heroVideo
        ? <video class="inq-modal__video" src={product.heroVideo} autoplay loop muted playsinline></video>
        : product.heroImage
          ? <img class="inq-modal__gif" src={product.heroImage} alt={product.title} />
          : null
      }
    </div>
    <div class="inq-modal__content">
      <p class="inq-modal__eyebrow">{eyebrow}</p>
      <h2 class="inq-modal__ref">{product.title}</h2>
      <p class="inq-modal__desc">{product.description}</p>

      <!-- Share -->
      <div class="inq-share">
        <div class="inq-share__wrap">
          <button class="inq-share__trigger" id="inqShareTrigger">Share</button>
          <div class="inq-share__menu" id="inqShareMenu" hidden>
            <button class="inq-share__item" id="inqShareCopy"><span id="inqCopyLabel">Copy link</span></button>
            <a class="inq-share__item" id="inqShareEmail" href="#">Email</a>
            <a class="inq-share__item" id="inqShareWA" href="#" target="_blank" rel="noopener">WhatsApp</a>
          </div>
        </div>
      </div>

      <ul class="inq-modal__specs">
        {[
          product.stone.carats && `${product.stone.carats}ct`,
          product.stone.color,
          product.stone.clarity && `${product.stone.clarity} clarity`,
          product.stone.shape,
          product.stone.origin,
          product.metal,
        ].filter(Boolean).map(spec => <li>{spec}</li>)}
      </ul>

      <form class="inq-form" id="inqForm" novalidate>
        <div class="inq-form__row">
          <div class="inq-form__field">
            <label class="inq-form__label" for="inqName">Name</label>
            <input class="inq-form__input" type="text" id="inqName" name="name" required autocomplete="name" placeholder="Your name">
          </div>
          <div class="inq-form__field">
            <label class="inq-form__label" for="inqEmail">Email</label>
            <input class="inq-form__input" type="email" id="inqEmail" name="email" required autocomplete="email" placeholder="your@email.com">
          </div>
        </div>
        <div class="inq-form__field">
          <label class="inq-form__label" for="inqPhone">Phone <span class="inq-form__optional">(optional)</span></label>
          <input class="inq-form__input" type="tel" id="inqPhone" name="phone" autocomplete="tel" placeholder="+1 (000) 000-0000">
        </div>
        <div class="inq-form__field">
          <label class="inq-form__label" for="inqMessage">Message</label>
          <textarea class="inq-form__input inq-form__textarea" id="inqMessage" name="message" rows="3" placeholder="I'm interested in this piece..."></textarea>
        </div>
        <button class="inq-form__submit" type="submit">Send Inquiry</button>
        <p class="inq-form__confirm" id="inqConfirm" hidden>Thank you — we'll be in touch within one business day.</p>
      </form>
    </div>
  </div>
</Layout>

<script>
  // Header transparency on hero
  const hero = document.getElementById('hero-video');
  const header = document.querySelector('.ba-header');
  if (hero && header) {
    const obs = new IntersectionObserver(
      ([e]) => header.classList.toggle('is-clear', e.isIntersecting),
      { threshold: 0.1 }
    );
    obs.observe(hero);
  }

  // Inquiry modal
  const backdrop  = document.getElementById('inqBackdrop');
  const modal     = document.getElementById('inqModal');
  const closeBtn  = document.getElementById('inqClose');
  const form      = document.getElementById('inqForm');
  const confirm   = document.getElementById('inqConfirm');
  const triggers  = [
    document.getElementById('prodInquireBtn'),
    document.getElementById('prodInquireBtn2'),
    document.getElementById('prodInquireBtn3'),
  ].filter(Boolean);

  function openModal() {
    modal.hidden = false;
    backdrop.classList.add('is-active');
    requestAnimationFrame(() => modal.classList.add('is-open'));
    document.body.style.overflow = 'hidden';
  }
  function closeModal() {
    modal.classList.remove('is-open');
    backdrop.classList.remove('is-active');
    document.body.style.overflow = '';
    setTimeout(() => { modal.hidden = true; }, 400);
  }

  triggers.forEach(t => t.addEventListener('click', openModal));
  closeBtn.addEventListener('click', closeModal);
  backdrop.addEventListener('click', closeModal);
  document.addEventListener('keydown', e => { if (e.key === 'Escape' && !modal.hidden) closeModal(); });

  form.addEventListener('submit', function(e) {
    e.preventDefault();
    const name    = (document.getElementById('inqName') as HTMLInputElement).value.trim();
    const email   = (document.getElementById('inqEmail') as HTMLInputElement).value.trim();
    const phone   = (document.getElementById('inqPhone') as HTMLInputElement).value.trim();
    const message = (document.getElementById('inqMessage') as HTMLTextAreaElement).value.trim();
    const subject = encodeURIComponent(document.querySelector('.inq-modal__ref')?.textContent || 'Inquiry');
    const body = encodeURIComponent(`Name: ${name}\nEmail: ${email}${phone ? '\nPhone: ' + phone : ''}\n\n${message}`);
    window.location.href = `mailto:info@bezambar.com?subject=${subject}&body=${body}`;
    confirm.hidden = false;
  });

  // Share
  const shareTrigger = document.getElementById('inqShareTrigger');
  const shareMenu    = document.getElementById('inqShareMenu');
  const shareCopy    = document.getElementById('inqShareCopy');
  const shareEmail   = document.getElementById('inqShareEmail') as HTMLAnchorElement;
  const shareWA      = document.getElementById('inqShareWA') as HTMLAnchorElement;
  const copyLabel    = document.getElementById('inqCopyLabel');
  const pageTitle    = document.title;
  const pageUrl      = window.location.href;

  const emailSubject = encodeURIComponent('Bez Ambar — ' + document.querySelector('h1')?.textContent?.trim());
  const emailBody    = encodeURIComponent('Take a look at this piece from Bez Ambar:\n' + pageUrl);
  const waText       = encodeURIComponent('Take a look at this Bez Ambar piece: ' + pageUrl);
  shareEmail.href = 'mailto:?subject=' + emailSubject + '&body=' + emailBody;
  shareWA.href    = 'https://wa.me/?text=' + waText;

  shareTrigger.addEventListener('click', function() {
    if (navigator.share) {
      navigator.share({ title: pageTitle, url: pageUrl }).catch(() => {});
    } else {
      const open = !shareMenu.hidden;
      shareMenu.hidden = open;
      shareTrigger.setAttribute('aria-expanded', String(!open));
    }
  });

  shareCopy.addEventListener('click', function() {
    navigator.clipboard.writeText(pageUrl).then(function() {
      copyLabel.textContent = 'Copied!';
      shareMenu.hidden = true;
      setTimeout(() => { copyLabel.textContent = 'Copy link'; }, 2000);
    });
  });

  document.addEventListener('click', function(e) {
    if (!shareMenu.hidden && !(e.target as Element).closest('.inq-share__wrap')) {
      shareMenu.hidden = true;
    }
  });
</script>

