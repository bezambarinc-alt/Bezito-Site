---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

export async function getStaticPaths() {
  const products = await getCollection('products', ({ data }) => data.status === 'live');
  return products.map(entry => ({
    params: { category: entry.data.category, slug: entry.data.slug },
    props: { product: entry.data },
  }));
}

const { product } = Astro.props;

const categoryLabel = product.category
  .replace(/-/g, ' ')
  .replace(/\b\w/g, (l: string) => l.toUpperCase());

const COLLECTION_LABELS: Record<string, string> = {
  signature: 'Signature Pieces',
  bloom: 'Bloom Collection',
  dentelle: 'Dentelle Collection',
};
const eyebrow = product.collection
  ? (COLLECTION_LABELS[product.collection] ?? `${product.collection.charAt(0).toUpperCase()}${product.collection.slice(1)} Collection`)
  : categoryLabel;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Jewelry", "item": "https://bezambar.com/collection" },
      { "@type": "ListItem", "position": 2, "name": categoryLabel, "item": `https://bezambar.com/collection?cat=${product.category}` },
      { "@type": "ListItem", "position": 3, "name": product.title, "item": `https://bezambar.com${product.prettyUrl}` }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": product.title,
    "sku": product.sku,
    "productID": product.refCode,
    "description": product.description,
    "image": product.heroImage || undefined,
    "url": `https://bezambar.com${product.prettyUrl}`,
    "brand": {
      "@type": "Brand",
      "name": "Bez Ambar",
      "url": "https://bezambar.com"
    },
    "manufacturer": {
      "@type": "Person",
      "name": "Bez Ambar",
      "jobTitle": "Master Diamond Cutter and Jewelry Designer",
      "description": "One of the original architects of the modern Princess Cut (1979); inventor of the Blaze® and the Elysian Cut™."
    },
    "offers": {
      "@type": "Offer",
      "url": `https://bezambar.com/contact?subject=${encodeURIComponent(product.inquirySubject)}`,
      "priceCurrency": "USD",
      "availability": "https://schema.org/InStock",
      "seller": { "@type": "Organization", "name": "Bez Ambar" }
    }
  }
];

const ogImage = product.heroImage
  || `https://res.cloudinary.com/dlg2mou53/image/upload/c_fill,w_1200,h_630,g_auto,f_auto,q_auto/v1775786208/Quadrillion_owciyv.jpg`;
---

<Layout
  title={`${product.title} ref. ${product.refCode} — Bez Ambar`}
  description={product.description}
  canonical={`https://bezambar.com${product.prettyUrl}`}
  ogImage={ogImage}
  ogType="product"
  pageType="product"
  structuredData={structuredData}
>
  {product.heroVideo ? (
    <div class="hero-video" id="hero-video">
      <video src={product.heroVideo} autoplay loop muted playsinline preload="auto"></video>
      <div class="hero-video__ref">
        <div class="hero-video__ref-id">{product.refCode}</div>
        <div class="hero-video__ref-name">{product.title}</div>
      </div>
    </div>
  ) : product.heroImage ? (
    <div class="hero-video" id="hero-video">
      <img src={product.heroImage} alt={product.title} loading="eager" />
      <div class="hero-video__ref">
        <div class="hero-video__ref-id">{product.refCode}</div>
        <div class="hero-video__ref-name">{product.title}</div>
      </div>
    </div>
  ) : null}

  <section class="hero">
    <nav class="breadcrumb" aria-label="breadcrumb">
      <a href="/collection">Jewelry</a>
      <span aria-hidden="true">/</span>
      <a href={`/collection?cat=${product.category}`}>{categoryLabel}</a>
      <span aria-hidden="true">/</span>
      <span>{product.title}</span>
    </nav>
    <p class="hero__eyebrow">{eyebrow}</p>
    <h1 class="hero__title">
      {product.title}
      {product.subtitle && <span class="hero__subtitle">{product.subtitle}</span>}
    </h1>
    <p class="hero__lede">{product.description}</p>
    <a class="hero__cta" href={`/contact?subject=${encodeURIComponent(product.inquirySubject)}`}>Inquire</a>
  </section>

  {product.images.length > 0 && (
    <div class="hero-video hero-video--secondary">
      {product.images[0].endsWith('.mp4') ? (
        <video src={product.images[0]} autoplay loop muted playsinline preload="auto"></video>
      ) : (
        <img src={product.images[0]} alt={`${product.title} — detail`} loading="lazy" />
      )}
    </div>
  )}

  <section class="technical" id="technical">
    <div class="technical__inner">
      <h2 class="technical__title">Technical Details</h2>
      <div class="technical__list">
        <details class="tech-item" open>
          <summary class="tech-item__head">Gem Stone</summary>
          <div class="tech-item__body">
            <p>
              {[
                product.stone.carats && `${product.stone.carats} carats`,
                product.stone.color,
                product.stone.clarity && `${product.stone.clarity} clarity`,
                product.stone.shape,
              ].filter(Boolean).join(' · ')}
              {product.stone.origin && ` — ${product.stone.origin}`}
            </p>
          </div>
        </details>
        <details class="tech-item">
          <summary class="tech-item__head">Metal</summary>
          <div class="tech-item__body">
            <p>{product.metal}</p>
          </div>
        </details>
        <details class="tech-item">
          <summary class="tech-item__head">Made in</summary>
          <div class="tech-item__body">
            <p>Los Angeles, California, USA. Handcrafted by Bez Ambar.</p>
          </div>
        </details>
        <details class="tech-item">
          <summary class="tech-item__head">Inquiry</summary>
          <div class="tech-item__body">
            <p>Each piece is made to specification. Pricing on request. <a href={`/contact?subject=${encodeURIComponent(product.inquirySubject)}`}>Contact us to inquire.</a></p>
          </div>
        </details>
      </div>
    </div>
  </section>

  <section class="product-cta" id="inquire">
    <h2 class="product-cta__title">See It in Person</h2>
    <p class="product-cta__body">Every piece is available to view by appointment at our Los Angeles atelier. Call <a href="tel:2136299191">(213) 629-9191</a> or send an inquiry below.</p>
    <a class="product-cta__btn" href={`/contact?subject=${encodeURIComponent(product.inquirySubject)}`}>Inquire About This Piece</a>
  </section>
</Layout>

<script>
  const hero = document.getElementById('hero-video');
  const header = document.querySelector('.ba-header');
  if (hero && header) {
    const obs = new IntersectionObserver(
      ([e]) => header.classList.toggle('is-clear', e.isIntersecting),
      { threshold: 0.1 }
    );
    obs.observe(hero);
  }
</script>

<style>
  /* Breadcrumb */
  .breadcrumb {
    display: flex;
    gap: 8px;
    align-items: center;
    justify-content: center;
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--ink-soft, #888);
    margin-bottom: 24px;
  }
  .breadcrumb a {
    color: var(--ink-soft, #888);
    text-decoration: none;
    transition: color 0.2s;
  }
  .breadcrumb a:hover { color: var(--accent, #95826b); }
  .breadcrumb span[aria-hidden] { opacity: 0.4; }

  /* Hero video */
  .hero-video {
    position: relative;
    width: 100%;
    height: 100svh;
    overflow: hidden;
    background: #0d0d0d;
  }
  .hero-video video,
  .hero-video img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-video--secondary {
    height: 600px;
  }
  .hero-video__ref {
    position: absolute;
    bottom: 2rem;
    right: 2rem;
    text-align: right;
    color: #c9b896;
  }
  .hero-video__ref-id {
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.6;
  }
  .hero-video__ref-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 18px;
    font-weight: 300;
    letter-spacing: 0.06em;
    opacity: 0.85;
  }

  /* Hero text section */
  .hero {
    max-width: 720px;
    margin: 0 auto;
    padding: 96px 2rem 80px;
    text-align: center;
  }
  .hero__eyebrow {
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent, #95826b);
    margin-bottom: 20px;
  }
  .hero__title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(32px, 5vw, 52px);
    font-weight: 300;
    letter-spacing: 0.03em;
    color: var(--ink, #1a1a1a);
    line-height: 1.1;
    margin-bottom: 8px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: center;
  }
  .hero__subtitle {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 300;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent, #95826b);
    opacity: 0.85;
  }
  .hero__lede {
    font-family: 'EB Garamond', serif;
    font-size: 18px;
    line-height: 1.7;
    color: var(--ink, #1a1a1a);
    opacity: 0.8;
    margin-bottom: 40px;
    margin-top: 24px;
  }
  .hero__cta {
    display: inline-block;
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink, #1a1a1a);
    text-decoration: none;
    border-bottom: 1px solid var(--accent, #95826b);
    padding-bottom: 3px;
    transition: color 0.2s, border-color 0.2s;
  }
  .hero__cta:hover { color: var(--accent, #95826b); }

  /* Technical section */
  .technical {
    padding: 80px 2rem;
    max-width: 760px;
    margin: 0 auto;
  }
  .technical__title {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent, #95826b);
    margin-bottom: 32px;
  }
  .tech-item {
    border-top: 1px solid rgba(0, 0, 0, 0.08);
  }
  .tech-item:last-child {
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }
  .tech-item__head {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink, #1a1a1a);
    padding: 20px 0;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .tech-item__head::after {
    content: '+';
    font-size: 18px;
    font-weight: 300;
    color: var(--accent, #95826b);
    transition: transform 0.2s;
  }
  details[open] .tech-item__head::after {
    transform: rotate(45deg);
  }
  .tech-item__body {
    padding: 0 0 20px;
    font-family: 'EB Garamond', serif;
    font-size: 17px;
    line-height: 1.65;
    color: var(--ink, #1a1a1a);
    opacity: 0.75;
  }
  .tech-item__body a {
    color: var(--accent, #95826b);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }

  /* Product CTA */
  .product-cta {
    padding: 80px 2rem;
    text-align: center;
    background: var(--ink, #1a1a1a);
    color: #fff;
  }
  .product-cta__title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 300;
    letter-spacing: 0.04em;
    margin-bottom: 20px;
  }
  .product-cta__body {
    font-family: 'EB Garamond', serif;
    font-size: 18px;
    line-height: 1.65;
    opacity: 0.7;
    max-width: 540px;
    margin: 0 auto 36px;
  }
  .product-cta__body a { color: #c9b896; text-decoration: none; }
  .product-cta__btn {
    display: inline-block;
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #fff;
    text-decoration: none;
    border: 1px solid rgba(255,255,255,0.35);
    padding: 16px 36px;
    transition: border-color 0.2s, color 0.2s;
  }
  .product-cta__btn:hover {
    border-color: #c9b896;
    color: #c9b896;
  }
</style>
