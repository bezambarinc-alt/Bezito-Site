---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import '../../../styles/templates/product.css';
import { COLLECTION_LABELS } from '../../../config/collections';

export async function getStaticPaths() {
  const products = await getCollection('products', ({ data }) => data.status === 'live');
  return products.map(entry => ({
    params: { category: entry.data.category, slug: entry.data.slug },
    props: { product: entry.data },
  }));
}

const { product } = Astro.props;

const categoryLabel = product.category
  .replace(/-/g, ' ')
  .replace(/\b\w/g, (l: string) => l.toUpperCase());

const eyebrow = product.collection
  ? (COLLECTION_LABELS[product.collection] ?? `${product.collection.charAt(0).toUpperCase()}${product.collection.slice(1)} Collection`)
  : categoryLabel;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Jewelry", "item": "https://bezambar.com/collection" },
      { "@type": "ListItem", "position": 2, "name": categoryLabel, "item": `https://bezambar.com/collection?cat=${product.category}` },
      { "@type": "ListItem", "position": 3, "name": product.title, "item": `https://bezambar.com${product.prettyUrl}` }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": product.title,
    "sku": product.sku,
    "productID": product.refCode,
    "description": product.description,
    "image": product.heroImage || undefined,
    "url": `https://bezambar.com${product.prettyUrl}`,
    "brand": {
      "@type": "Brand",
      "name": "Bez Ambar",
      "url": "https://bezambar.com"
    },
    "manufacturer": {
      "@type": "Person",
      "name": "Bez Ambar",
      "jobTitle": "Master Diamond Cutter and Jewelry Designer",
      "description": "One of the original architects of the modern Princess Cut (1979); inventor of the Blaze® and the Elysian Cut™."
    },
    "offers": {
      "@type": "Offer",
      "url": `https://bezambar.com/contact?subject=${encodeURIComponent(product.inquirySubject)}`,
      "priceCurrency": "USD",
      "availability": "https://schema.org/InStock",
      "seller": { "@type": "Organization", "name": "Bez Ambar" }
    }
  }
];

const ogImage = product.heroImage
  || `https://res.cloudinary.com/dlg2mou53/image/upload/c_fill,w_1200,h_630,g_auto,f_auto,q_auto/v1775786208/Jewelry%20Images/Stones/Quadrillion_owciyv.jpg`;
---

<Layout
  title={`${product.title} ref. ${product.refCode} — Bez Ambar`}
  description={product.description}
  canonical={`https://bezambar.com${product.prettyUrl}`}
  ogImage={ogImage}
  ogType="product"
  pageType="product"
  structuredData={structuredData}
>
  {product.heroVideo ? (
    <div class="hero-video" id="hero-video">
      <video src={product.heroVideo} autoplay loop muted playsinline preload="auto"></video>
      <div class="hero-video__ref">
        <div class="hero-video__ref-id">{product.refCode}</div>
        <div class="hero-video__ref-name">{product.title}</div>
      </div>
    </div>
  ) : product.heroImage ? (
    <div class="hero-video" id="hero-video">
      <img src={product.heroImage} alt={product.title} loading="eager" />
      <div class="hero-video__ref">
        <div class="hero-video__ref-id">{product.refCode}</div>
        <div class="hero-video__ref-name">{product.title}</div>
      </div>
    </div>
  ) : null}

  <section class="hero">
    <nav class="breadcrumb" aria-label="breadcrumb">
      <a href="/collection">Jewelry</a>
      <span aria-hidden="true">/</span>
      <a href={`/collection?cat=${product.category}`}>{categoryLabel}</a>
      <span aria-hidden="true">/</span>
      <span>{product.title}</span>
    </nav>
    <h1 class="hero__title">{product.title}</h1>
    {product.subtitle && <p class="hero__ref-line">{product.subtitle}</p>}
    <p class="hero__lede">{product.editorial ?? product.description}</p>

    <!-- Share — sits quietly below the description -->
    <div class="prod-share">
      <div class="prod-share__wrap" data-share>
        <button class="prod-share__trigger" id="prodShareTrigger">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 12v8a2 2 0 002 2h12a2 2 0 002-2v-8"/>
            <polyline points="16 6 12 2 8 6"/>
            <line x1="12" y1="2" x2="12" y2="15"/>
          </svg>
          Share
        </button>
        <div class="prod-share__menu" id="prodShareMenu" hidden>
          <button class="prod-share__item" id="prodShareCopy"><span id="prodCopyLabel">Copy link</span></button>
          <a class="prod-share__item" id="prodShareEmail" href="#">Email</a>
          <a class="prod-share__item" id="prodShareWA" href="#" target="_blank" rel="noopener">WhatsApp</a>
        </div>
      </div>
    </div>
  </section>
  <div id="heroEnd"></div>

  {product.images.length > 0 && (
    <div class="hero-video hero-video--secondary">
      {product.images[0].endsWith('.mp4') ? (
        <video src={product.images[0]} autoplay loop muted playsinline preload="auto"></video>
      ) : (
        <img src={product.images[0]} alt={`${product.title} — detail`} loading="lazy" />
      )}
    </div>
  )}

  <section class="technical" id="technical">
    <div class="technical__inner">
      <div class="technical__list">
        <details class="tech-item" open>
          <summary class="tech-item__head">Gem Stone</summary>
          <div class="tech-item__body">
            <p>
              {[
                product.stone.carats && `${product.stone.carats} carats`,
                product.stone.color,
                product.stone.clarity && `${product.stone.clarity} clarity`,
                product.stone.shape,
              ].filter(Boolean).join(' · ')}
              {product.stone.origin && ` — ${product.stone.origin}`}
            </p>
          </div>
        </details>
        <details class="tech-item">
          <summary class="tech-item__head">Metal</summary>
          <div class="tech-item__body">
            <p>{product.metal}</p>
          </div>
        </details>
        <details class="tech-item">
          <summary class="tech-item__head">Made in</summary>
          <div class="tech-item__body">
            <p>Los Angeles, California, USA. Handcrafted by Bez Ambar.</p>
          </div>
        </details>
        <details class="tech-item">
          <summary class="tech-item__head">Inquiry</summary>
          <div class="tech-item__body">
            <p>Each piece is made to specification. Pricing on request. <a href="/contact" onclick={`openInquiryDrawer({title:${JSON.stringify(product.title)},sku:${JSON.stringify(product.sku)},intent:'collection piece'}); return false;`}>Contact us to inquire.</a></p>
          </div>
        </details>
      </div>
    </div>
  </section>

  <!-- Bottom CTA — floating pill merges into this -->
  <section class="product-cta" id="inquire">
    <h2 class="product-cta__title">See It in Person</h2>
    <p class="product-cta__body">Every piece is available to view by appointment at our Los Angeles atelier. Call <a href="tel:2136299191">(213) 629-9191</a> or send an inquiry below.</p>
    <a class="product-cta__btn" id="inquireBtn" href="/contact" onclick={`openInquiryDrawer({title:${JSON.stringify(product.title)},sku:${JSON.stringify(product.sku)},intent:'collection piece'}); return false;`}>Inquire About This Piece</a>
  </section>

  <!-- Floating Inquire pill -->
  <a class="prod-pill" id="prodPill" href="/contact" onclick={`openInquiryDrawer({title:${JSON.stringify(product.title)},sku:${JSON.stringify(product.sku)},intent:'collection piece'}); return false;`}>Inquire</a>
</Layout>

<script>
  import { initShare, updateShare } from '../../../scripts/share';

  // Header transparency
  const hero   = document.getElementById('hero-video');
  const header = document.querySelector('.ba-header');
  if (hero && header) {
    new IntersectionObserver(
      ([e]) => header.classList.toggle('is-clear', e.isIntersecting),
      { threshold: 0.1 }
    ).observe(hero);
  }

  // Floating Inquire pill — shows after hero, hides only when the inquiry button itself is visible
  const pill       = document.getElementById('prodPill') as HTMLAnchorElement | null;
  const heroEnd    = document.getElementById('heroEnd');
  const inquireBtn = document.getElementById('inquireBtn');
  if (pill && heroEnd && inquireBtn) {
    new IntersectionObserver(
      ([e]) => pill.classList.toggle('is-visible', !e.isIntersecting),
      { threshold: 0 }
    ).observe(heroEnd);
    new IntersectionObserver(
      ([e]) => pill.classList.toggle('is-hidden', e.isIntersecting),
      { threshold: 0 }
    ).observe(inquireBtn);
  }

  // Share
  const shareWrap    = document.querySelector('.prod-share__wrap');
  const shareTrigger = document.getElementById('prodShareTrigger') as HTMLButtonElement | null;
  const shareMenu    = document.getElementById('prodShareMenu') as HTMLElement | null;
  const shareCopy    = document.getElementById('prodShareCopy') as HTMLButtonElement | null;
  const shareEmail   = document.getElementById('prodShareEmail') as HTMLAnchorElement | null;
  const shareWA      = document.getElementById('prodShareWA') as HTMLAnchorElement | null;
  const copyLabel    = document.getElementById('prodCopyLabel') as HTMLElement | null;

  const pageUrl = window.location.href;
  const h1Text  = document.querySelector('h1')?.textContent?.trim() ?? document.title;

  updateShare({ emailLink: shareEmail, waLink: shareWA }, h1Text, pageUrl);

  initShare(
    { wrap: shareWrap, trigger: shareTrigger, menu: shareMenu,
      copyBtn: shareCopy, copyLabel, emailLink: shareEmail, waLink: shareWA },
    () => ({ title: document.title, url: pageUrl }),
  );
</script>

