---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const allProducts = await getCollection('products', ({ data }) => data.status === 'live');
  const KNOWN_CATEGORIES = [
    'rings', 'engagement-rings', 'wedding-bands',
    'bracelets', 'earrings', 'necklaces', 'pendants',
  ];
  const liveCategories = allProducts.map(p => p.data.category);
  const allCategories = [...new Set([...KNOWN_CATEGORIES, ...liveCategories])];
  return allCategories.map(category => ({
    params: { category },
    props: {
      products: allProducts.filter(p => p.data.category === category),
    },
  }));
}

const { category } = Astro.params;
const { products } = Astro.props;

const meta: Record<string, { label: string; title: string; description: string; intro: string }> = {
  rings: {
    label: 'Rings',
    title: 'Diamond & Gemstone Rings — Bez Ambar',
    description: 'Handcrafted diamond and colored stone rings by master jeweler Bez Ambar. Each piece is made to order in Los Angeles.',
    intro: 'From fancy-color diamond solitaires to multi-stone designs, each ring is cut and set by hand in our Los Angeles atelier.',
  },
  bracelets: {
    label: 'Bracelets',
    title: 'Diamond Flex Bracelets — Bez Ambar',
    description: 'The patented Bez Ambar Flex — diamond and gemstone bracelets engineered to move with the wrist. Made in Los Angeles.',
    intro: 'The patented Flex mechanism — two decades in development — lets diamonds move freely on the wrist without a hinge or clasp showing.',
  },
  necklaces: {
    label: 'Necklaces',
    title: 'Diamond Necklaces & Pendants — Bez Ambar',
    description: 'Diamond necklaces and single-stone pendants by Bez Ambar. Handcrafted to order in Los Angeles, California.',
    intro: 'Clean geometry, exceptional stones. Each necklace is designed around the diamond — the setting exists only to let the stone breathe.',
  },
  'wedding-bands': {
    label: 'Wedding Bands',
    title: 'Diamond Wedding Bands — Bez Ambar',
    description: 'Diamond wedding bands handcrafted in Los Angeles. Baguette and brilliant-cut designs made to specification.',
    intro: 'Precision-set baguette and brilliant diamonds in platinum and 18K gold. Made to specification — sizing and stone selection on request.',
  },
  'engagement-rings': {
    label: 'Engagement Rings',
    title: 'Engagement Rings — Bez Ambar',
    description: 'Bespoke engagement rings by Bez Ambar. Custom diamond and gemstone designs made to order in Los Angeles.',
    intro: 'Every engagement ring is a private commission. We source the stone, design the setting, and build the ring to your exact specification.',
  },
};

const page = meta[category] ?? {
  label: category.replace(/-/g, ' ').replace(/\b\w/g, l => l.toUpperCase()),
  title: `${category.replace(/-/g, ' ').replace(/\b\w/g, l => l.toUpperCase())} — Bez Ambar`,
  description: `Fine jewelry by Bez Ambar. Handcrafted in Los Angeles.`,
  intro: 'Each piece is made to order in our Los Angeles atelier.',
};

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Jewelry", "item": "https://bezambar.com/collection" },
      { "@type": "ListItem", "position": 2, "name": page.label, "item": `https://bezambar.com/jewelry/${category}` }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": page.label,
    "description": page.description,
    "url": `https://bezambar.com/jewelry/${category}`,
    "numberOfItems": products.length,
    "brand": { "@type": "Brand", "name": "Bez Ambar" }
  }
];
---

<Layout
  title={page.title}
  description={page.description}
  canonical={`https://bezambar.com/jewelry/${category}`}
  structuredData={structuredData}
>

<style is:global>
  body { background: #0d0d0d; color: #fff; }
  .ba-header { background: #1a1a1a !important; color: #fff !important; box-shadow: none !important; }
  .ba-header.is-solid { background: #1a1a1a !important; color: #fff !important; }

  .cat-hero {
    padding: 140px 20px 60px;
    text-align: center;
  }
  .cat-hero__back {
    display: block;
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #555;
    text-decoration: none;
    margin-bottom: 32px;
    transition: color 0.3s;
  }
  .cat-hero__back:hover { color: #fff; }
  .cat-hero__eyebrow {
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #888;
    margin-bottom: 16px;
  }
  .cat-hero h1 {
    font-family: var(--serif, 'Cormorant Garamond', Georgia, serif);
    font-size: 48px;
    font-weight: 400;
    color: #fff;
    margin: 0 0 20px;
  }
  .cat-hero__intro {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    color: #888;
    max-width: 560px;
    margin: 0 auto;
    line-height: 1.7;
  }
  .cat-hero__count {
    margin-top: 16px;
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #555;
  }

  .cat-grid-wrap {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 0 80px;
  }
  .cat-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: #0d0d0d;
  }
  .cat-card {
    position: relative;
    background: #141414;
    text-decoration: none;
    display: block;
    aspect-ratio: 3/4;
    overflow: hidden;
  }
  .cat-card:hover .cat-card__img { transform: scale(1.04); }
  .cat-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
    display: block;
  }
  .cat-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.75) 0%, transparent 55%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 24px 20px;
  }
  .cat-card__ref {
    font-family: 'Inter', sans-serif;
    font-size: 9px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgba(255,255,255,0.45);
    margin-bottom: 6px;
  }
  .cat-card__name {
    font-family: var(--serif, 'Cormorant Garamond', Georgia, serif);
    font-size: 22px;
    font-weight: 400;
    color: #fff;
    line-height: 1.2;
    margin-bottom: 4px;
  }
  .cat-card__sub {
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    color: rgba(255,255,255,0.5);
    letter-spacing: 0.05em;
  }
  .cat-empty {
    text-align: center;
    padding: 80px 20px;
    color: #555;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
  }

  @media (max-width: 900px) {
    .cat-grid { grid-template-columns: repeat(2, 1fr); }
    .cat-hero h1 { font-size: 36px; }
  }
  @media (max-width: 600px) {
    .cat-grid { grid-template-columns: 1fr; }
    .cat-hero { padding: 120px 20px 40px; }
  }
</style>

<section class="cat-hero">
  <a href="/collection" class="cat-hero__back">&larr; All Jewelry</a>
  <p class="cat-hero__eyebrow">Bez Ambar</p>
  <h1>{page.label}</h1>
  <p class="cat-hero__intro">{page.intro}</p>
  <p class="cat-hero__count">{products.length} {products.length === 1 ? 'piece' : 'pieces'}</p>
</section>

<div class="cat-grid-wrap">
  {products.length > 0 ? (
    <div class="cat-grid">
      {products.map(p => (
        <a href={p.data.prettyUrl} class="cat-card">
          {p.data.heroImage ? (
            <img
              src={p.data.heroImage}
              alt={p.data.title}
              class="cat-card__img"
              loading="lazy"
            />
          ) : (
            <div class="cat-card__img" style="background:#1a1a1a;" />
          )}
          <div class="cat-card__overlay">
            <p class="cat-card__ref">{p.data.refCode}</p>
            <p class="cat-card__name">{p.data.title}</p>
            {p.data.subtitle && <p class="cat-card__sub">{p.data.subtitle}</p>}
          </div>
        </a>
      ))}
    </div>
  ) : (
    <p class="cat-empty">No pieces currently available in this category.</p>
  )}
</div>

</Layout>
