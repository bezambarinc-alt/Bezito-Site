---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const allProducts = await getCollection('products', ({ data }) => data.status === 'live');
  const KNOWN_CATEGORIES = [
    'rings', 'engagement-rings', 'wedding-bands',
    'bracelets', 'earrings', 'necklaces', 'pendants',
  ];
  const liveCategories = allProducts.map(p => p.data.category);
  const allCategories = [...new Set([...KNOWN_CATEGORIES, ...liveCategories])];
  return allCategories.map(category => ({
    params: { category },
    props: {
      products: allProducts.filter(p => p.data.category === category),
    },
  }));
}

const { category } = Astro.params;
const { products } = Astro.props;
const videoProducts = products.filter(p => p.data.heroVideo).slice(0, 3);

const meta: Record<string, { label: string; title: string; description: string; intro: string }> = {
  rings: {
    label: 'Rings',
    title: 'Diamond & Gemstone Rings — Bez Ambar',
    description: 'Handcrafted diamond and colored stone rings by master jeweler Bez Ambar. Each piece is made to order in Los Angeles.',
    intro: 'From fancy-color diamond solitaires to multi-stone designs, each ring is cut and set by hand in our Los Angeles atelier.',
  },
  bracelets: {
    label: 'Bracelets',
    title: 'Diamond Flex Bracelets — Bez Ambar',
    description: 'The patented Bez Ambar Flex — diamond and gemstone bracelets engineered to move with the wrist. Made in Los Angeles.',
    intro: 'The patented Flex mechanism — two decades in development — lets diamonds move freely on the wrist without a hinge or clasp showing.',
  },
  necklaces: {
    label: 'Necklaces',
    title: 'Diamond Necklaces & Pendants — Bez Ambar',
    description: 'Diamond necklaces and single-stone pendants by Bez Ambar. Handcrafted to order in Los Angeles, California.',
    intro: 'Clean geometry, exceptional stones. Each necklace is designed around the diamond — the setting exists only to let the stone breathe.',
  },
  'wedding-bands': {
    label: 'Wedding Bands',
    title: 'Diamond Wedding Bands — Bez Ambar',
    description: 'Diamond wedding bands handcrafted in Los Angeles. Baguette and brilliant-cut designs made to specification.',
    intro: 'Precision-set baguette and brilliant diamonds in platinum and 18K gold. Made to specification — sizing and stone selection on request.',
  },
  'engagement-rings': {
    label: 'Engagement Rings',
    title: 'Engagement Rings — Bez Ambar',
    description: 'Bespoke engagement rings by Bez Ambar. Custom diamond and gemstone designs made to order in Los Angeles.',
    intro: 'Every engagement ring is a private commission. We source the stone, design the setting, and build the ring to your exact specification.',
  },
};

const page = meta[category] ?? {
  label: category.replace(/-/g, ' ').replace(/\b\w/g, l => l.toUpperCase()),
  title: `${category.replace(/-/g, ' ').replace(/\b\w/g, l => l.toUpperCase())} — Bez Ambar`,
  description: `Fine jewelry by Bez Ambar. Handcrafted in Los Angeles.`,
  intro: 'Each piece is made to order in our Los Angeles atelier.',
};

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Jewelry", "item": "https://bezambar.com/collection" },
      { "@type": "ListItem", "position": 2, "name": page.label, "item": `https://bezambar.com/jewelry/${category}` }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": page.label,
    "description": page.description,
    "url": `https://bezambar.com/jewelry/${category}`,
    "numberOfItems": products.length,
    "brand": { "@type": "Brand", "name": "Bez Ambar" }
  }
];
---

<Layout
  title={page.title}
  description={page.description}
  canonical={`https://bezambar.com/jewelry/${category}`}
  structuredData={structuredData}
>

<section class="ba-category-hero">
  <div class="ba-category-hero__reel">
    {videoProducts.map(p => (
      <div class="ba-category-hero__clip">
        <video src={p.data.heroVideo} poster={p.data.heroImage ?? undefined} autoplay muted loop playsinline></video>
      </div>
    ))}
    {videoProducts.length === 0 && (
      <div class="ba-category-hero__clip ba-category-hero__clip--empty"></div>
    )}
  </div>
  <div class="ba-category-hero__text">
    <span class="ba-inner-hero__eyebrow">Bez Ambar</span>
    <h1>{page.label}</h1>
    <p class="ba-inner-hero__intro">{page.intro}</p>
    <p class="ba-inner-hero__count">{products.length} {products.length === 1 ? 'piece' : 'pieces'}</p>
  </div>
</section>

<div class="ba-jewelry-grid-wrap">
  {products.length > 0 ? (
    <div class="ba-jewelry-grid">
      {products.map(p => (
        <a href={p.data.prettyUrl} class="ba-jewelry-card">
          {p.data.heroImage ? (
            <img src={p.data.heroImage} alt={p.data.title} class="ba-jewelry-card__img" loading="lazy" />
          ) : (
            <div class="ba-jewelry-card__img" />
          )}
          <div class="ba-jewelry-card__overlay">
            <p class="ba-jewelry-card__ref">{p.data.refCode}</p>
            <p class="ba-jewelry-card__name">{p.data.title}</p>
            {p.data.subtitle && <p class="ba-jewelry-card__sub">{p.data.subtitle}</p>}
          </div>
        </a>
      ))}
    </div>
  ) : (
    <p class="ba-jewelry-empty">No pieces currently available in this category.</p>
  )}
</div>

<button class="ba-back-to-top" id="backToTop" aria-label="Back to top">↑</button>
<script>
  const btt = document.getElementById('backToTop');
  window.addEventListener('scroll', () => {
    btt?.classList.toggle('is-visible', window.scrollY > 300);
  }, { passive: true });
  btt?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
</script>

</Layout>
