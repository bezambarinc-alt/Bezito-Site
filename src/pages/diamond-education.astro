        <div class="de-measure-item">
          <div class="de-measure-param">Table %</div>
          <div class="de-measure-ideal">52&ndash;62%</div>
          <div class="de-measure-note">Table width as percentage of diameter. Affects balance between brilliance and fire.</div>
        </div>
        <div class="de-measure-item">
          <div class="de-measure-param">Crown Angle</div>
          <div class="de-measure-ideal">34&ndash;35&deg;</div>
          <div class="de-measure-note">Angle of crown facets. Controls dispersion of light and fire intensity.</div>
        </div>
        <div class="de-measure-item">
          <div class="de-measure-param">Pavilion Angle</div>
          <div class="de-measure-ideal">40&ndash;41&deg;</div>
          <div class="de-measure-note">Angle of pavilion facets. Determines the primary path of light reflection.</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="ba-cta--paper ba-cta">
