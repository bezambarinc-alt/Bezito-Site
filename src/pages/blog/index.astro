---
import Layout from '../../layouts/Layout.astro';
import '../../styles/templates/blog.css';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog', p => p.data.status === 'live'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

if (allPosts.length === 0) {
  return Astro.redirect('/');
}

const featured = allPosts.find(p => p.slug === 'diamond-hoop-earrings-guide') ?? allPosts[0];
const picks    = allPosts.filter(p => p.slug !== featured.slug).slice(0, 2);
const gridPosts = allPosts.filter(p => p.slug !== featured.slug).slice(2);

function fmtDate(d: Date) {
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
function fmtCat(c: string) { return c.replace(/-/g, ' '); }
function thumb(url: string = '') {
  return url.replace('ar_16:9,g_auto,w_1400', 'ar_4:3,g_auto,w_800');
}
function vidThumb(url: string = '') {
  const noExt = url.replace(/\.(mp4|webm|mov|avi)$/i, '');
  return noExt
    .replace('/video/upload/', '/video/upload/so_0,q_auto,f_jpg,c_fill,ar_4:3,g_auto,w_800/')
    + '.jpg';
}
function vidThumbWide(url: string = '') {
  const noExt = url.replace(/\.(mp4|webm|mov|avi)$/i, '');
  return noExt
    .replace('/video/upload/', '/video/upload/so_0,q_auto,f_jpg,c_fill,ar_21:9,g_auto,w_1600/')
    + '.jpg';
}
---

<Layout
  title="Journal — Notes on Diamonds, Craft & Design | Bez Ambar"
  description="Notes from the Bez Ambar atelier — diamond cuts, stone sourcing, setting techniques, and the thinking behind the work."
  canonical="https://bezambar.com/blog"
>

<!-- Editorial masthead -->
<div class="journal-masthead">
  <div class="journal-masthead__inner">
    <p class="journal-masthead__eyebrow">From the Atelier</p>
    <h1 class="journal-masthead__title">Journal</h1>
    <p class="journal-masthead__lede">Notes on diamonds, craft, and design from forty-seven years of independent work.</p>
  </div>
  <div class="journal-masthead__meta">
    <span>Vol. I</span>
    <span>—</span>
    <span>Est. 1979</span>
  </div>
</div>

<!-- Full-bleed cinematic featured article -->
<a href={`/blog/${featured.slug}`} class="journal-hero-card">
  <div class="journal-hero-card__media">
    {featured.data.heroVideo
      ? <video src={featured.data.heroVideo} poster={vidThumbWide(featured.data.heroVideo)} autoplay muted loop playsinline></video>
      : <img src={featured.data.heroImage} alt={featured.data.title} loading="eager">
    }
  </div>
  <div class="journal-hero-card__overlay">
    <span class="journal-hero-card__tag">{fmtCat(featured.data.category)}</span>
    <h2 class="journal-hero-card__title">{featured.data.title}</h2>
    <p class="journal-hero-card__excerpt">{featured.data.excerpt}</p>
    <span class="journal-hero-card__cta">Read Article</span>
  </div>
</a>

<!-- Editors' picks — 2 wide cards, always visible -->
{picks.length > 0 && (
  <div class="journal-picks">
    <p class="journal-picks__label">Editors' Picks</p>
    <div class="journal-picks__grid">
      {picks.map(post => (
        <a href={`/blog/${post.slug}`} class="journal-pick-card">
          <div class="journal-pick-card__img">
            {post.data.heroVideo
              ? <video src={post.data.heroVideo} poster={vidThumb(post.data.heroVideo)} autoplay muted loop playsinline></video>
              : <img src={thumb(post.data.heroImage)} alt={post.data.title} loading="lazy">
            }
          </div>
          <div class="journal-pick-card__body">
            <span class="journal-pick-card__cat">{fmtCat(post.data.category)}</span>
            <h3 class="journal-pick-card__title">{post.data.title}</h3>
            <p class="journal-pick-card__excerpt">{post.data.excerpt}</p>
            <span class="journal-pick-card__meta">{fmtDate(post.data.date)}</span>
          </div>
        </a>
      ))}
    </div>
  </div>
)}

<hr class="blog-divider">

<!-- Archive filter -->
<div class="blog-filter">
  <button class="blog-filter__btn active" onclick="filterBlog('all', this)">All</button>
  <button class="blog-filter__btn" onclick="filterBlog('engagement-rings', this)">Engagement Rings</button>
  <button class="blog-filter__btn" onclick="filterBlog('diamonds', this)">Diamonds</button>
  <button class="blog-filter__btn" onclick="filterBlog('colored-stones', this)">Colored Stones</button>
  <button class="blog-filter__btn" onclick="filterBlog('earrings', this)">Earrings</button>
  <button class="blog-filter__btn" onclick="filterBlog('guides', this)">Guides</button>
</div>

<div class="blog-grid" id="blogGrid">
  {gridPosts.map(post => (
    <a href={`/blog/${post.slug}`} class="blog-card" data-cat={post.data.category}>
      <div class="blog-card__img">
        {post.data.heroVideo
          ? <video src={post.data.heroVideo} poster={vidThumb(post.data.heroVideo)} autoplay muted loop playsinline></video>
          : <img src={thumb(post.data.heroImage)} alt={post.data.title} loading="lazy">
        }
      </div>
      <p class="blog-card__cat">{fmtCat(post.data.category)}</p>
      <h3 class="blog-card__title">{post.data.title}</h3>
      <p class="blog-card__date">{fmtDate(post.data.date)}</p>
      <p class="blog-card__excerpt">{post.data.excerpt}</p>
    </a>
  ))}
</div>

<script>
  function filterBlog(cat: string, btn: HTMLButtonElement) {
    document.querySelectorAll('.blog-filter__btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    document.querySelectorAll<HTMLElement>('.blog-card').forEach(card => {
      const match = cat === 'all' || card.dataset.cat === cat;
      card.style.display = match ? '' : 'none';
    });
  }
  (window as any).filterBlog = filterBlog;
</script>

</Layout>
