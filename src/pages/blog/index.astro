---
import Layout from '../../layouts/Layout.astro';
import '../../styles/templates/blog.css';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog', p => p.data.status === 'live'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const featured = allPosts.find(p => p.slug === 'diamond-hoop-earrings-guide') || allPosts[0];
const gridPosts = allPosts.filter(p => p.slug !== featured.slug);

function fmtDate(d: Date) {
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
function fmtCat(c: string) {
  return c.replace(/-/g, ' ');
}
function thumb(url: string = '') {
  return url.replace('ar_16:9,g_auto,w_1400', 'ar_4:3,g_auto,w_800');
}
---

<Layout
  title="Journal — Craft & Stone | Bez Ambar"
  description="Writing on diamonds, cuts, stones, and fine jewelry from the Bez Ambar atelier in Los Angeles."
  canonical="https://bezambar.com/blog"
>

<section class="ba-inner-hero ba-inner-hero--light">
  <span class="ba-inner-hero__eyebrow">From the Atelier</span>
  <h1>The Journal</h1>
  <p class="ba-inner-hero__intro">Writing on stones, cuts, and the craft of fine jewelry — from the studio at 611 Wilshire.</p>
</section>

<div class="blog-featured">
  <a href={`/blog/${featured.slug}`} class="featured-card">
    <div class="featured-img">
      <img src={featured.data.heroImage} alt={featured.data.title} loading="eager">
    </div>
    <div class="featured-content">
      <p class="featured-content__date">{fmtDate(featured.data.date)}</p>
      <h2>{featured.data.title}</h2>
      <p class="featured-content__excerpt">{featured.data.excerpt}</p>
      <span class="featured-content__read-more">Read Article</span>
    </div>
  </a>
</div>

<hr class="blog-divider">

<div class="blog-grid">
  {gridPosts.map(post => (
    <a href={`/blog/${post.slug}`} class="blog-card">
      <div class="blog-card__img">
        <img src={thumb(post.data.heroImage)} alt={post.data.title} loading="lazy">
      </div>
      <h3 class="blog-card__title">{post.data.title}</h3>
      <p class="blog-card__date">{fmtDate(post.data.date)}</p>
      <p class="blog-card__excerpt">{post.data.excerpt}</p>
    </a>
  ))}
</div>

</Layout>
