---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog', p => p.data.status === 'live'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const featured = allPosts.find(p => p.slug === 'diamond-hoop-earrings-guide') || allPosts[0];
const gridPosts = allPosts.filter(p => p.slug !== featured.slug);

function fmtDate(d: Date) {
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
function fmtCat(c: string) {
  return c.replace(/-/g, ' ');
}
---

<Layout
  title="Blog — Diamond Education & Insights | Bez Ambar"
  description="Expert insights on diamonds, gemstones, and fine jewelry from master jeweler Bez Ambar. Guides on engagement rings, diamond cuts, colored stones, and more."
  canonical="https://bezambar.com/blog"
  theme="dark"
>

<style is:global>
  .blog-hero {
    text-align: center;
    padding: 140px 20px 60px;
    background: #0d0d0d;
  }
  .blog-hero .eyebrow {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #888;
    margin-bottom: 16px;
  }
  .blog-hero h1 {
    font-family: var(--serif, 'Cormorant Garamond', Georgia, serif);
    font-size: 48px;
    font-weight: 400;
    color: #fff;
    margin: 0 0 12px;
  }
  .blog-hero p {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    color: #888;
    max-width: 500px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* Featured */
  .blog-featured {
    max-width: 1200px;
    margin: 0 auto;
    padding: 60px 20px 40px;
  }
  .featured-card {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 60px;
    align-items: center;
    text-decoration: none;
    color: inherit;
  }
  .featured-card:hover .featured-img img { transform: scale(1.03); }
  .featured-img {
    aspect-ratio: 16/10;
    overflow: hidden;
    background: #141414;
  }
  .featured-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .featured-content .eyebrow {
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: #b8860b;
    margin-bottom: 16px;
  }
  .featured-content h2 {
    font-family: var(--serif, 'Cormorant Garamond', Georgia, serif);
    font-size: 36px;
    font-weight: 400;
    color: #fff;
    margin: 0 0 16px;
    line-height: 1.2;
  }
  .featured-content .excerpt {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    color: #888;
    line-height: 1.8;
    margin-bottom: 20px;
  }
  .featured-content .read-more {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #fff;
    border-bottom: 1px solid #fff;
    padding-bottom: 2px;
  }
  .featured-content .post-date {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    color: #888;
    margin-bottom: 8px;
  }

  /* Filter */
  .blog-filter {
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px 20px 10px;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .blog-filter button {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    padding: 8px 20px;
    border: 1px solid rgba(255,255,255,0.2);
    background: transparent;
    color: #888;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  .blog-filter button:hover,
  .blog-filter button.active {
    background: #fff;
    color: #0d0d0d;
    border-color: #fff;
  }

  /* Grid */
  .blog-grid {
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 20px 80px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px 30px;
  }
  .blog-card {
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .blog-card:hover .blog-card-img img { transform: scale(1.05); }
  .blog-card-img {
    aspect-ratio: 4/3;
    overflow: hidden;
    background: #141414;
    margin-bottom: 16px;
  }
  .blog-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .blog-card-cat {
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #b8860b;
    margin-bottom: 8px;
  }
  .blog-card-title {
    font-family: var(--serif, 'Cormorant Garamond', Georgia, serif);
    font-size: 22px;
    font-weight: 500;
    color: #fff;
    margin: 0 0 8px;
    line-height: 1.3;
  }
  .blog-card-date {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    color: #888;
  }
  .blog-card-excerpt {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    color: #888;
    line-height: 1.7;
    margin-top: 8px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .blog-card[data-hidden="true"] { display: none; }

  .blog-divider {
    max-width: 1200px;
    margin: 0 auto;
    border: none;
    border-top: 1px solid rgba(255,255,255,0.08);
  }

  @media (max-width: 900px) {
    .featured-card { grid-template-columns: 1fr; gap: 30px; }
    .blog-grid { grid-template-columns: repeat(2, 1fr); gap: 30px 20px; }
    .blog-hero h1 { font-size: 36px; }
  }
  @media (max-width: 600px) {
    .blog-grid { grid-template-columns: 1fr; }
    .featured-content h2 { font-size: 28px; }
    .blog-hero { padding: 120px 20px 40px; }
  }
</style>

<!-- Hero -->
<section class="blog-hero">
  <p class="eyebrow">Diamond Education & Insights</p>
  <h1>The Bez Ambar Blog</h1>
  <p>Expert guides on diamonds, gemstones, and fine jewelry from a master jeweler with over 40 years of experience.</p>
</section>

<!-- Featured -->
<div class="blog-featured">
  <a href={`/blog/${featured.slug}`} class="featured-card">
    <div class="featured-img">
      <img src={featured.data.heroImage} alt={featured.data.title} loading="eager">
    </div>
    <div class="featured-content">
      <p class="post-date">{fmtDate(featured.data.date)}</p>
      <p class="eyebrow">{fmtCat(featured.data.category)}</p>
      <h2>{featured.data.title}</h2>
      <p class="excerpt">{featured.data.excerpt}</p>
      <span class="read-more">Read Article</span>
    </div>
  </a>
</div>

<hr class="blog-divider">

<!-- Category Filter -->
<div class="blog-filter">
  <button class="active" onclick="filterBlog('all', this)">All</button>
  <button onclick="filterBlog('engagement-rings', this)">Engagement Rings</button>
  <button onclick="filterBlog('diamonds', this)">Diamonds</button>
  <button onclick="filterBlog('colored-stones', this)">Colored Stones</button>
  <button onclick="filterBlog('earrings', this)">Earrings</button>
  <button onclick="filterBlog('guides', this)">Guides</button>
</div>

<!-- Blog Grid -->
<div class="blog-grid" id="blogGrid">
  {gridPosts.map(post => (
    <a href={`/blog/${post.slug}`} class="blog-card" data-cat={post.data.category}>
      <div class="blog-card-img">
        <img src={post.data.heroImage} alt={post.data.title} loading="lazy">
      </div>
      <p class="blog-card-cat">{fmtCat(post.data.category)}</p>
      <h3 class="blog-card-title">{post.data.title}</h3>
      <p class="blog-card-date">{fmtDate(post.data.date)}</p>
      <p class="blog-card-excerpt">{post.data.excerpt}</p>
    </a>
  ))}
</div>

<script>
  function filterBlog(cat: string, btn: HTMLButtonElement) {
    document.querySelectorAll('.blog-filter button').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    document.querySelectorAll<HTMLElement>('.blog-card').forEach(card => {
      const match = cat === 'all' || card.dataset.cat === cat;
      card.style.display = match ? '' : 'none';
    });
  }
</script>

</Layout>
