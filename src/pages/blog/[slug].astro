---
import Layout from '../../layouts/Layout.astro';
import '../../styles/templates/blog.css';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', p => p.data.status === 'live');
  return posts.map(post => ({ params: { slug: post.slug }, props: { post } }));
}

interface Props { post: CollectionEntry<'blog'>; }
const { post } = Astro.props;
const { Content } = await post.render();

const allPosts = (await getCollection('blog', p => p.data.status === 'live'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const related = allPosts
  .filter(p => p.slug !== post.slug && p.data.category === post.data.category)
  .slice(0, 3);

function fmtDate(d: Date) {
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
function fmtCat(c: string) {
  return c.replace(/-/g, ' ');
}
function thumb(url: string = '') {
  return url.replace('ar_16:9,g_auto,w_1400', 'ar_4:3,g_auto,w_800');
}

// ── Structured data ────────────────────────────────────────────────────────

const postUrl = `https://bezambar.com/blog/${post.slug}`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${postUrl}#article`,
  headline: post.data.title,
  description: post.data.excerpt,
  datePublished: post.data.date.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.date).toISOString(),
  url: postUrl,
  author: {
    '@type': 'Person',
    name: post.data.author,
    url: 'https://bezambar.com/about-bez-ambar',
  },
  publisher: {
    '@type': 'Organization',
    '@id': 'https://bezambar.com/#organization',
    name: 'Bez Ambar',
  },
  ...(post.data.heroImage && {
    image: {
      '@type': 'ImageObject',
      url: post.data.heroImage,
      width: 1200,
      height: 800,
    },
  }),
  mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home',  item: 'https://bezambar.com' },
    { '@type': 'ListItem', position: 2, name: 'Blog',  item: 'https://bezambar.com/blog' },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: postUrl },
  ],
};

// FAQPage — parsed from markdown body when schema.faq is true
function parseFaqs(body: string) {
  const faqs: Array<{ question: string; answer: string }> = [];
  const lines = body.split('\n');
  let i = 0;
  while (i < lines.length) {
    const line = lines[i].trim();
    // FAQ question: a line that is ONLY **text** (nothing else)
    if (/^\*\*[^*]+\*\*$/.test(line)) {
      const question = line.replace(/^\*\*|\*\*$/g, '').trim();
      const answerLines: string[] = [];
      i++;
      while (i < lines.length) {
        const next = lines[i].trim();
        if (/^\*\*[^*]+\*\*$/.test(next) || next === '---') break;
        if (next) answerLines.push(next);
        i++;
      }
      // Strip markdown links → plain text for schema
      const answer = answerLines.join(' ').replace(/\[([^\]]+)\]\([^)]+\)/g, '$1').trim();
      if (answer) faqs.push({ question, answer });
    } else {
      i++;
    }
  }
  return faqs;
}

const faqSchema = post.data.schema?.faq
  ? (() => {
      const faqs = parseFaqs(post.body);
      return faqs.length ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqs.map(({ question, answer }) => ({
          '@type': 'Question',
          name: question,
          acceptedAnswer: { '@type': 'Answer', text: answer },
        })),
      } : null;
    })()
  : null;

const pageSchemas = [articleSchema, breadcrumbSchema, faqSchema].filter(Boolean);
---

<Layout
  title={`${post.data.title} | Bez Ambar`}
  description={post.data.excerpt}
  canonical={postUrl}
  ogImage={post.data.heroImage}
  ogType="article"
  pageType="article"
  structuredData={pageSchemas}
  headerLight={true}
>

<div class="ba-post-back">
  <a href="/blog">&larr; Back to Blog</a>
</div>

<section class="ba-post-hero">
  <p class="ba-post-hero__cat">{fmtCat(post.data.category)}</p>
  <h1>{post.data.title}</h1>
  <p class="ba-post-hero__meta">
    {post.data.author}
    <span>&middot;</span>
    {fmtDate(post.data.date)}
  </p>
</section>

{post.data.heroVideo ? (
  <div class="ba-post-img ba-post-img--video">
    <video autoplay muted loop playsinline>
      <source src={post.data.heroVideo} type="video/mp4">
    </video>
  </div>
) : post.data.heroImage ? (
  <div class="ba-post-img">
    <img src={post.data.heroImage} alt={post.data.heroImageAlt || post.data.title} loading="eager">
  </div>
) : null}

<div class="ba-post-content">
  <Content />
</div>

<div class="ba-post-cta">
  <div class="ba-post-cta__box">
    <h3>Interested in a Custom Piece?</h3>
    <p>Every Bez Ambar creation is made to order in our Los Angeles atelier. Schedule a private consultation to begin your bespoke jewelry journey.</p>
    <a href="/contact" onclick="openInquiryDrawer({intent:'commission a piece'}); return false;">Begin Your Commission</a>
  </div>
</div>

{related.length > 0 && (
  <section class="ba-related">
    <h2>Related Articles</h2>
    <div class="ba-related__grid">
      {related.map(p => (
        <a href={`/blog/${p.slug}`} class="ba-related__card">
          <div class="ba-related__img">
            <img src={thumb(p.data.heroImage)} alt={p.data.title} loading="lazy">
          </div>
          <h4>{p.data.title}</h4>
          <p class="ba-related__date">{fmtDate(p.data.date)}</p>
        </a>
      ))}
    </div>
  </section>
)}

</Layout>

<script>
  import Lenis from 'lenis';

  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hasPointer    = window.matchMedia('(hover: hover)').matches;

  // ── Lazy-load content images (hero img has loading="eager" in HTML)
  document.querySelectorAll('.ba-post-content img').forEach(img => {
    img.setAttribute('loading', 'lazy');
  });

  // ── Page-load reveal: H1 line-mask + cat label + meta stagger
  const h1 = document.querySelector('.ba-post-hero h1');
  const cat = document.querySelector('.ba-post-hero__cat');
  const meta = document.querySelector('.ba-post-hero__meta');
  if (h1 && !prefersReduced) {
    h1.innerHTML = `<span class="h1-inner">${h1.innerHTML}</span>`;
    requestAnimationFrame(() => requestAnimationFrame(() => {
      h1.querySelector('.h1-inner')?.classList.add('is-active');
      cat?.classList.add('is-active');
      meta?.classList.add('is-active');
    }));
  } else {
    // No-animation: ensure labels are visible
    cat?.classList.add('is-active');
    meta?.classList.add('is-active');
  }

  // ── Lenis smooth scroll + parallax (desktop pointer, no reduced-motion)
  const heroImg = document.querySelector<HTMLElement>('.ba-post-img img');
  if (hasPointer && !prefersReduced) {
    const lenis = new Lenis({
      duration: 1.2,
      easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
    });

    if (heroImg) {
      lenis.on('scroll', ({ scroll }: { scroll: number }) => {
        heroImg.style.transform = `translateY(${scroll * -0.15}px)`;
      });
    }

    (function raf(time: number) {
      lenis.raf(time);
      requestAnimationFrame(raf);
    })(0);
  } else if (heroImg && !prefersReduced) {
    window.addEventListener('scroll', () => {
      heroImg.style.transform = `translateY(${window.scrollY * -0.07}px)`;
    }, { passive: true });
  }

  // ── Scroll reveals (all via single IntersectionObserver)
  if (!prefersReduced) {
    // Figures + video: scale-settle reveal (opacity + scale 1.04→1, no lateral movement)
    document.querySelectorAll('.ba-post-content figure img, .ba-post-content video').forEach(el => {
      el.classList.add('ba-reveal-img');
    });

    // H3 → H2 pairs: stagger label then title
    document.querySelectorAll('.ba-post-content h3').forEach(h3 => {
      h3.classList.add('ba-reveal');
      const next = h3.nextElementSibling;
      if (next?.tagName === 'H2') next.classList.add('ba-reveal', 'ba-reveal-d1');
    });

    // Standalone H2s, blockquotes, CTA box, standfirst paragraph
    document.querySelectorAll(
      '.ba-post-content h2:not(.ba-reveal),' +
      '.ba-post-content blockquote,' +
      '.ba-post-cta__box'
    ).forEach(el => el.classList.add('ba-reveal'));

    // Body paragraphs: stagger groups of 3
    document.querySelectorAll('.ba-post-content > p:not(:first-of-type)').forEach((p, i) => {
      p.classList.add('ba-reveal');
      if (i % 3 === 1) p.classList.add('ba-reveal-d1');
      if (i % 3 === 2) p.classList.add('ba-reveal-d2');
    });

    const io = new IntersectionObserver((entries, obs) => {
      entries.forEach(({ target, isIntersecting }) => {
        if (isIntersecting) { target.classList.add('is-visible'); obs.unobserve(target); }
      });
    }, { threshold: 0, rootMargin: '0px 0px -8% 0px' });

    document.querySelectorAll('.ba-reveal, .ba-reveal-img').forEach(el => io.observe(el));
  }
</script>
