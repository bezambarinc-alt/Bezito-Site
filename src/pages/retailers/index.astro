---
import Layout from '../../layouts/Layout.astro';
import retailers from '../../data/retailers.json';

const regions = ['Northeast', 'Mid-Atlantic', 'Midwest', 'South', 'West'];

const byRegion = regions.reduce((acc, region) => {
  acc[region] = retailers.filter(r => r.region === region);
  return acc;
}, {} as Record<string, typeof retailers>);

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bezambar.com/' },
    { '@type': 'ListItem', position: 2, name: 'Authorized Retailers', item: 'https://bezambar.com/retailers' },
  ],
};
---

<Layout
  title="Authorized Retailers | Find Bez Ambar Diamond Jewelry Near You"
  description="Find an authorized Bez Ambar retailer near you. Select showrooms across the United States carry the full Bez Ambar collection, including the Elysian Cut™ and Blaze® diamond jewelry."
  canonical="https://bezambar.com/retailers"
  headerLight={true}
  structuredData={breadcrumb}
>
  <div class="rl-page">

    <!-- Hero -->
    <section class="rl-hero">
      <div class="rl-hero__bg"></div>
      <div class="rl-hero__content">
        <p class="rl-hero__eyebrow">Where to Find Us</p>
        <h1 class="rl-hero__title">Authorized Retailers</h1>
        <p class="rl-hero__lede">
          Select jewelers across the United States carry the Bez Ambar collection.<br>
          Each partner is chosen for their dedication to craftsmanship and client experience.
        </p>
      </div>
    </section>

    <!-- Region Nav -->
    <nav class="rl-region-nav" aria-label="Regions">
      <div class="rl-region-nav__inner">
        {regions.filter(r => byRegion[r]?.length).map(region => (
          <a class="rl-region-nav__link" href={`#${region.toLowerCase().replace(/ /, '-')}`}>{region}</a>
        ))}
      </div>
    </nav>

    <!-- Retailer Grid by Region -->
    <div class="rl-body">
      {regions.filter(r => byRegion[r]?.length).map(region => (
        <section class="rl-region" id={region.toLowerCase().replace(/ /, '-')}>
          <h2 class="rl-region__title">{region}</h2>
          <div class="rl-grid">
            {byRegion[region].map(retailer => (
              <a class="rl-card" href={`/retailers/${retailer.slug}`}>
                <div class="rl-card__inner">
                  <div class="rl-card__meta">
                    <p class="rl-card__city">{retailer.city}, {retailer.state}</p>
                    <h3 class="rl-card__name">{retailer.name}</h3>
                    <p class="rl-card__locations">
                      {retailer.locations.length === 1
                        ? retailer.locations[0].address
                        : `${retailer.locations.length} locations`}
                    </p>
                  </div>
                  <span class="rl-card__cta">Visit Showroom →</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>

    <!-- Closing CTA -->
    <section class="rl-closing">
      <div class="rl-closing__inner">
        <p class="rl-closing__eyebrow">Can't find a retailer near you?</p>
        <h2 class="rl-closing__title">Contact the Atelier Directly</h2>
        <p class="rl-closing__body">
          Bez Ambar's Los Angeles atelier accepts private appointments and ships worldwide.<br>
          Experience the collection in person with the designer.
        </p>
        <a class="rl-closing__btn" href="/contact">Request an Appointment</a>
      </div>
    </section>

  </div>
</Layout>

<style>
  /* ─── Hero ─── */
  .rl-hero {
    position: relative;
    min-height: 52vh;
    display: flex;
    align-items: flex-end;
    padding-bottom: 5rem;
    overflow: hidden;
    background: #0f0f0f;
  }
  .rl-hero__bg {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgba(0,0,0,0.15) 0%, rgba(0,0,0,0.65) 100%),
      url('https://res.cloudinary.com/dlg2mou53/image/upload/f_auto,q_auto:good,w_1800/Jewelry%20Images/Atelier/designer-portrait-2026.jpg')
      center 30% / cover no-repeat;
  }
  .rl-hero__content {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
    padding: 0 2rem;
    text-align: center;
    color: #fff;
  }
  .rl-hero__eyebrow {
    font-family: var(--sans);
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 1.2rem;
  }
  .rl-hero__title {
    font-family: var(--serif, 'Cormorant Garamond', serif);
    font-size: clamp(2.6rem, 6vw, 4.5rem);
    font-weight: 300;
    line-height: 1.08;
    letter-spacing: 0.02em;
    margin: 0 0 1.4rem;
  }
  .rl-hero__lede {
    font-family: var(--sans);
    font-size: 0.95rem;
    line-height: 1.7;
    color: rgba(255,255,255,0.78);
    max-width: 56ch;
    margin: 0 auto;
  }

  /* ─── Region Nav ─── */
  .rl-region-nav {
    background: #fff;
    border-bottom: 1px solid #e8e4de;
    position: sticky;
    top: 64px;
    z-index: 20;
  }
  .rl-region-nav__inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    gap: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .rl-region-nav__inner::-webkit-scrollbar { display: none; }
  .rl-region-nav__link {
    font-family: var(--sans);
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #5a5248;
    text-decoration: none;
    padding: 1.1rem 1.5rem;
    white-space: nowrap;
    border-bottom: 2px solid transparent;
    transition: color 0.2s, border-color 0.2s;
  }
  .rl-region-nav__link:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  /* ─── Body ─── */
  .rl-body {
    max-width: 1100px;
    margin: 0 auto;
    padding: 5rem 2rem;
  }

  /* ─── Region Section ─── */
  .rl-region {
    margin-bottom: 5rem;
  }
  .rl-region__title {
    font-family: var(--sans);
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 2rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid #e8e4de;
  }

  /* ─── Grid ─── */
  .rl-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5px;
    background: #e8e4de;
    border: 1px solid #e8e4de;
  }

  /* ─── Card ─── */
  .rl-card {
    background: #fff;
    text-decoration: none;
    display: block;
    transition: background 0.2s;
  }
  .rl-card:hover { background: #faf8f5; }
  .rl-card__inner {
    padding: 2rem 2rem 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 160px;
  }
  .rl-card__meta { flex: 1; }
  .rl-card__city {
    font-family: var(--sans);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 0.4rem;
  }
  .rl-card__name {
    font-family: var(--serif, 'Cormorant Garamond', serif);
    font-size: 1.35rem;
    font-weight: 400;
    color: #1a1a1a;
    margin: 0 0 0.5rem;
    line-height: 1.2;
  }
  .rl-card__locations {
    font-family: var(--sans);
    font-size: 0.82rem;
    color: #6b6258;
    margin: 0;
    line-height: 1.4;
  }
  .rl-card__cta {
    font-family: var(--sans);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: #1a1a1a;
    margin-top: 1.25rem;
    display: block;
    transition: color 0.2s;
  }
  .rl-card:hover .rl-card__cta { color: var(--accent); }

  /* ─── Closing CTA ─── */
  .rl-closing {
    background: #0f0f0f;
    padding: 7rem 2rem;
  }
  .rl-closing__inner {
    max-width: 660px;
    margin: 0 auto;
    text-align: center;
    color: #fff;
  }
  .rl-closing__eyebrow {
    font-family: var(--sans);
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 1.2rem;
  }
  .rl-closing__title {
    font-family: var(--serif, 'Cormorant Garamond', serif);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 300;
    margin: 0 0 1.4rem;
    line-height: 1.1;
  }
  .rl-closing__body {
    font-family: var(--sans);
    font-size: 0.95rem;
    line-height: 1.7;
    color: rgba(255,255,255,0.72);
    margin: 0 0 2.5rem;
  }
  .rl-closing__btn {
    display: inline-block;
    font-family: var(--sans);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #0f0f0f;
    background: var(--accent);
    padding: 1rem 2.5rem;
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }
  .rl-closing__btn:hover {
    background: #b09a82;
  }

  @media (max-width: 640px) {
    .rl-grid { grid-template-columns: 1fr; }
    .rl-hero { min-height: 45vh; padding-bottom: 3rem; }
    .rl-body { padding: 3rem 1.25rem; }
    .rl-region-nav__link { padding: 1rem 1rem; }
  }
</style>
