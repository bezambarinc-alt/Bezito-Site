---
import Layout from '../../layouts/Layout.astro';
import retailers from '../../data/retailers.json';

const CDN = 'https://res.cloudinary.com/dlg2mou53/image/upload';

const regions = ['Northeast', 'Mid-Atlantic', 'Midwest', 'South', 'West'];

const byRegion = regions.reduce((acc, region) => {
  acc[region] = retailers.filter(r => r.region === region);
  return acc;
}, {} as Record<string, typeof retailers>);

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bezambar.com/' },
    { '@type': 'ListItem', position: 2, name: 'Authorized Retailers', item: 'https://bezambar.com/retailers' },
  ],
};
---

<Layout
  title="Authorized Retailers | Find Bez Ambar Diamond Jewelry Near You"
  description="Find an authorized Bez Ambar retailer near you. Select showrooms across the United States carry the full Bez Ambar collection, including the Elysian Cut™ and Blaze® diamond jewelry."
  canonical="https://bezambar.com/retailers"
  headerLight={true}
  structuredData={breadcrumb}
>
  <div class="rl-page">

    <!-- Hero -->
    <section class="rl-hero">
      <div class="rl-hero__bg"></div>
      <div class="rl-hero__content">
        <p class="rl-hero__eyebrow">Where to Find Us</p>
        <h1 class="rl-hero__title">Authorized Retailers</h1>
        <p class="rl-hero__lede">
          Select jewelers across the United States carry the Bez Ambar collection.<br>
          Each partner is chosen for their dedication to craftsmanship and client experience.
        </p>
      </div>
    </section>

    <!-- Region Nav -->
    <nav class="rl-region-nav" aria-label="Regions">
      <div class="rl-region-nav__inner">
        {regions.filter(r => byRegion[r]?.length).map(region => (
          <a class="rl-region-nav__link" href={`#${region.toLowerCase().replace(/ /, '-')}`}>{region}</a>
        ))}
      </div>
    </nav>

    <!-- Retailer Grid by Region -->
    <div class="rl-body">
      {regions.filter(r => byRegion[r]?.length).map(region => (
        <section class="rl-region" id={region.toLowerCase().replace(/ /, '-')}>
          <div class="rl-region__header">
            <h2 class="rl-region__title">{region}</h2>
            <span class="rl-region__count">{byRegion[region].length} {byRegion[region].length === 1 ? 'showroom' : 'showrooms'}</span>
          </div>
          <div class="rl-grid">
            {byRegion[region].map(retailer => (
              <a class="rl-card" href={`/retailers/${retailer.slug}`}>
                <div class="rl-card__img-wrap">
                  <img
                    class="rl-card__img"
                    src={`${CDN}/c_fill,ar_3:2,w_720,g_center,f_auto,q_auto/${retailer.image}`}
                    alt={retailer.name}
                    loading="lazy"
                    width="720"
                    height="480"
                  />
                </div>
                <div class="rl-card__inner">
                  <div class="rl-card__meta">
                    <p class="rl-card__city">{retailer.city}, {retailer.state}</p>
                    <h3 class="rl-card__name">{retailer.name}</h3>
                    <p class="rl-card__locations">
                      {retailer.locations.length === 1
                        ? retailer.locations[0].address
                        : `${retailer.locations.length} locations`}
                    </p>
                  </div>
                  <span class="rl-card__cta">Visit Showroom →</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>

    <!-- Editorial break -->
    <div class="rl-editorial">
      <div class="rl-editorial__inner">
        <p class="rl-editorial__eyebrow">The Bez Ambar Collection</p>
        <p class="rl-editorial__body">
          From the original Princess Cut to the Elysian Cut™ — every piece is cut for light, crafted by hand, and certified authentic at every authorized showroom.
        </p>
        <a class="rl-editorial__link" href="/collections">Explore the Collection →</a>
      </div>
      <div class="rl-editorial__imgs">
        <img
          src={`${CDN}/c_fill,ar_1:1,w_480,g_center,f_auto,q_auto/v1775786208/Jewelry%20Images/Stones/Quadrillion_owciyv.jpg`}
          alt="The Princess Cut diamond by Bez Ambar"
          loading="lazy"
          width="480"
          height="480"
        />
        <img
          src={`${CDN}/c_fill,ar_1:1,w_480,g_center,f_auto,q_auto/v1775549202/Jewelry%20Images/Rings/C0625_Baguette_band_Master_e4azkj.jpg`}
          alt="Bez Ambar diamond band"
          loading="lazy"
          width="480"
          height="480"
        />
        <img
          src={`${CDN}/c_fill,ar_1:1,w_480,g_center,f_auto,q_auto/Jewelry%20Images/Necklaces/single-row-lifestyle.jpg`}
          alt="Bez Ambar diamond necklace"
          loading="lazy"
          width="480"
          height="480"
        />
      </div>
    </div>

    <!-- Closing CTA -->
    <section class="rl-closing">
      <div class="rl-closing__inner">
        <p class="rl-closing__eyebrow">Can't find a retailer near you?</p>
        <h2 class="rl-closing__title">Contact the Atelier Directly</h2>
        <p class="rl-closing__body">
          Bez Ambar's Los Angeles atelier accepts private appointments and ships worldwide.<br>
          Experience the collection in person with the designer.
        </p>
        <a class="rl-closing__btn" href="/contact">Request an Appointment</a>
      </div>
    </section>

  </div>
</Layout>

<style>
  /* ─── Hero ─── */
  .rl-hero {
    position: relative;
    min-height: 56vh;
    display: flex;
    align-items: flex-end;
    padding-bottom: 5.5rem;
    overflow: hidden;
    background: #0f0f0f;
  }
  .rl-hero__bg {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgba(0,0,0,0.08) 0%, rgba(0,0,0,0.72) 100%),
      url('https://res.cloudinary.com/dlg2mou53/image/upload/f_auto,q_auto:good,w_1800/Jewelry%20Images/Atelier/designer-portrait-2026.jpg')
      center 30% / cover no-repeat;
  }
  .rl-hero__content {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
    padding: 0 2rem;
    text-align: center;
    color: #fff;
  }
  .rl-hero__eyebrow {
    font-family: var(--sans);
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 1.4rem;
  }
  .rl-hero__title {
    font-family: var(--serif, 'Cormorant Garamond', serif);
    font-size: clamp(2.8rem, 6.5vw, 5rem);
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: 0.02em;
    margin: 0 0 1.6rem;
  }
  .rl-hero__lede {
    font-family: var(--sans);
    font-size: 0.95rem;
    line-height: 1.75;
    color: rgba(255,255,255,0.75);
    max-width: 56ch;
    margin: 0 auto;
  }

  /* ─── Region Nav ─── */
  .rl-region-nav {
    background: #fff;
    border-bottom: 1px solid #e8e4de;
    position: sticky;
    top: 64px;
    z-index: 20;
  }
  .rl-region-nav__inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    gap: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .rl-region-nav__inner::-webkit-scrollbar { display: none; }
  .rl-region-nav__link {
    font-family: var(--sans);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #5a5248;
    text-decoration: none;
    padding: 1.1rem 1.5rem;
    white-space: nowrap;
    border-bottom: 2px solid transparent;
    transition: color 0.2s, border-color 0.2s;
  }
  .rl-region-nav__link:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  /* ─── Body ─── */
  .rl-body {
    max-width: 1200px;
    margin: 0 auto;
    padding: 5.5rem 2rem;
  }

  /* ─── Region Section ─── */
  .rl-region {
    margin-bottom: 6rem;
  }
  .rl-region__header {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid #e8e4de;
  }
  .rl-region__title {
    font-family: var(--sans);
    font-size: 0.68rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0;
  }
  .rl-region__count {
    font-family: var(--sans);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: #b0a89e;
    text-transform: lowercase;
  }

  /* ─── Grid ─── */
  .rl-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 2px;
    background: #e8e4de;
    border: 1px solid #e8e4de;
  }

  /* ─── Card ─── */
  .rl-card {
    background: #fff;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    transition: background 0.2s;
    overflow: hidden;
  }
  .rl-card:hover { background: #faf8f5; }

  .rl-card__img-wrap {
    width: 100%;
    overflow: hidden;
    background: #1a1a1a;
  }
  .rl-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.55s ease;
  }
  .rl-card:hover .rl-card__img {
    transform: scale(1.04);
  }

  .rl-card__inner {
    padding: 1.75rem 2rem 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex: 1;
    min-height: 140px;
  }
  .rl-card__meta { flex: 1; }
  .rl-card__city {
    font-family: var(--sans);
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 0.45rem;
  }
  .rl-card__name {
    font-family: var(--serif, 'Cormorant Garamond', serif);
    font-size: 1.5rem;
    font-weight: 400;
    color: #1a1a1a;
    margin: 0 0 0.5rem;
    line-height: 1.18;
    letter-spacing: 0.01em;
  }
  .rl-card__locations {
    font-family: var(--sans);
    font-size: 0.8rem;
    color: #7a7068;
    margin: 0;
    line-height: 1.45;
  }
  .rl-card__cta {
    font-family: var(--sans);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #1a1a1a;
    margin-top: 1.4rem;
    display: block;
    transition: color 0.2s;
  }
  .rl-card:hover .rl-card__cta { color: var(--accent); }

  /* ─── Editorial Break ─── */
  .rl-editorial {
    background: #0f0f0f;
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 400px;
  }
  .rl-editorial__inner {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 5rem 4rem 5rem 6rem;
    color: #fff;
    max-width: 560px;
  }
  .rl-editorial__eyebrow {
    font-family: var(--sans);
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 1.6rem;
  }
  .rl-editorial__body {
    font-family: var(--serif, 'Cormorant Garamond', serif);
    font-size: clamp(1.4rem, 2.2vw, 1.9rem);
    font-weight: 300;
    line-height: 1.5;
    color: rgba(255,255,255,0.88);
    margin: 0 0 2.5rem;
  }
  .rl-editorial__link {
    font-family: var(--sans);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid var(--accent);
    padding-bottom: 0.2rem;
    align-self: flex-start;
    transition: opacity 0.2s;
  }
  .rl-editorial__link:hover { opacity: 0.7; }
  .rl-editorial__imgs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    overflow: hidden;
  }
  .rl-editorial__imgs img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: grayscale(20%) brightness(0.85);
  }

  /* ─── Closing CTA ─── */
  .rl-closing {
    background: #fff;
    padding: 7rem 2rem;
    border-top: 1px solid #e8e4de;
  }
  .rl-closing__inner {
    max-width: 620px;
    margin: 0 auto;
    text-align: center;
  }
  .rl-closing__eyebrow {
    font-family: var(--sans);
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 1.2rem;
  }
  .rl-closing__title {
    font-family: var(--serif, 'Cormorant Garamond', serif);
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 300;
    margin: 0 0 1.4rem;
    line-height: 1.1;
    color: #1a1a1a;
    letter-spacing: 0.01em;
  }
  .rl-closing__body {
    font-family: var(--sans);
    font-size: 0.95rem;
    line-height: 1.75;
    color: #5a5248;
    margin: 0 0 2.8rem;
  }
  .rl-closing__btn {
    display: inline-block;
    font-family: var(--sans);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #fff;
    background: #1a1a1a;
    padding: 1.1rem 2.8rem;
    text-decoration: none;
    transition: background 0.2s;
  }
  .rl-closing__btn:hover { background: var(--accent); }

  /* ─── Responsive ─── */
  @media (max-width: 1024px) {
    .rl-editorial {
      grid-template-columns: 1fr;
    }
    .rl-editorial__inner {
      padding: 4rem 3rem;
      max-width: 100%;
    }
    .rl-editorial__imgs {
      min-height: 260px;
    }
  }
  @media (max-width: 640px) {
    .rl-grid { grid-template-columns: 1fr; }
    .rl-hero { min-height: 48vh; padding-bottom: 3.5rem; }
    .rl-body { padding: 3.5rem 1.25rem; }
    .rl-region-nav__link { padding: 1rem 1rem; }
    .rl-editorial__inner { padding: 3rem 1.5rem; }
    .rl-editorial__imgs { min-height: 200px; }
  }
</style>
