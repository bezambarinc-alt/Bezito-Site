---
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import retailers from '../../data/retailers.json';

const CDN = 'https://res.cloudinary.com/dlg2mou53/image/upload';

export const getStaticPaths = (() => {
  return retailers.map(r => ({
    params: { slug: r.slug },
    props: { retailer: r },
  }));
}) satisfies GetStaticPaths;

const { retailer } = Astro.props;

// Build JSON-LD for each location
const locationSchemas = retailer.locations.map(loc => ({
  '@context': 'https://schema.org',
  '@type': ['JewelryStore', 'LocalBusiness'],
  name: retailer.name,
  url: retailer.website ?? undefined,
  telephone: loc.phone ?? undefined,
  address: {
    '@type': 'PostalAddress',
    streetAddress: loc.address,
    addressLocality: loc.city,
    addressRegion: loc.state,
    postalCode: loc.zip,
    addressCountry: 'US',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: loc.lat,
    longitude: loc.lng,
  },
  openingHours: loc.hours,
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Bez Ambar Diamond Jewelry',
    url: 'https://bezambar.com/collection',
  },
}));

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bezambar.com/' },
    { '@type': 'ListItem', position: 2, name: 'Authorized Retailers', item: 'https://bezambar.com/retailers' },
    { '@type': 'ListItem', position: 3, name: retailer.name, item: `https://bezambar.com/retailers/${retailer.slug}` },
  ],
};

const allSchemas = [breadcrumb, ...locationSchemas];
const hasMultiple = retailer.locations.length > 1;

const heroImg = `${CDN}/f_auto,q_auto:good,w_1600,c_fill,g_center/${retailer.image}`;
---

<Layout
  title={retailer.seoTitle}
  description={retailer.seoDescription}
  canonical={`https://bezambar.com/retailers/${retailer.slug}`}
  headerLight={true}
  structuredData={allSchemas}
>
  <div class="rd-page">

    <!-- Hero -->
    <section class="rd-hero" style={`--hero-img: url('${heroImg}')`}>
      <div class="rd-hero__bg"></div>
      <div class="rd-hero__content">
        <nav class="rd-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Bez Ambar</a>
          <span aria-hidden="true"> / </span>
          <a href="/retailers">Retailers</a>
          <span aria-hidden="true"> / </span>
          <span>{retailer.shortName}</span>
        </nav>
        <p class="rd-hero__eyebrow">{retailer.city}, {retailer.state}&ensp;·&ensp;Authorized Retailer</p>
        <h1 class="rd-hero__title">{retailer.name}</h1>
      </div>
    </section>

    <!-- Body -->
    <div class="rd-body">

      <!-- About + badge -->
      <div class="rd-intro">
        <div class="rd-intro__copy">
          <p class="rd-intro__eyebrow">About This Partner</p>
          <p class="rd-intro__text">{retailer.description}</p>
          {retailer.website && (
            <a class="rd-intro__link" href={retailer.website} target="_blank" rel="noopener noreferrer">
              Visit {retailer.shortName} →
            </a>
          )}
        </div>
        <div class="rd-intro__divider"></div>
        <div class="rd-intro__badge">
          <p class="rd-intro__badge-label">Authorized Bez Ambar Retailer</p>
          <img
            class="rd-intro__badge-logo"
            src="/logo.svg"
            alt="Bez Ambar"
            width="140"
            height="42"
            loading="lazy"
          />
          <p class="rd-intro__badge-note">
            Every authorized location is personally selected and trained on the Bez Ambar collection.
          </p>
        </div>
      </div>

      <!-- Locations -->
      <section class="rd-locations">
        <h2 class="rd-locations__title">{hasMultiple ? 'Showroom Locations' : 'Visit the Showroom'}</h2>

        <div class={`rd-locs-grid${hasMultiple ? ' rd-locs-grid--multi' : ''}`}>
          {retailer.locations.map(loc => (
            <div class="rd-loc">
              {loc.label && <p class="rd-loc__label">{loc.label}</p>}
              <div class="rd-loc__map-wrap">
                <iframe
                  class="rd-loc__map"
                  src={loc.mapEmbed}
                  width="600"
                  height="340"
                  style="border:0;"
                  allowfullscreen={true}
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  title={`Map for ${retailer.name}${loc.label ? ` ${loc.label}` : ''}`}
                ></iframe>
              </div>
              <div class="rd-loc__info">
                <div class="rd-loc__block">
                  <p class="rd-loc__block-label">Address</p>
                  <address class="rd-loc__address">
                    {loc.address}<br>
                    {loc.city}, {loc.state} {loc.zip}
                  </address>
                </div>
                {loc.phone && (
                  <div class="rd-loc__block">
                    <p class="rd-loc__block-label">Phone</p>
                    <a class="rd-loc__phone" href={`tel:${loc.phone.replace(/\D/g,'')}`}>{loc.phone}</a>
                  </div>
                )}
                {loc.hours && (
                  <div class="rd-loc__block">
                    <p class="rd-loc__block-label">Hours</p>
                    <p class="rd-loc__hours">{loc.hours}</p>
                  </div>
                )}
                <a
                  class="rd-loc__directions"
                  href={`https://maps.google.com/?q=${encodeURIComponent(`${loc.address}, ${loc.city}, ${loc.state} ${loc.zip}`)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Get Directions
                </a>
              </div>
            </div>
          ))}
        </div>
      </section>

    </div>

    <!-- From the Collection — full-width dark editorial strip -->
    <section class="rd-collection">
      <div class="rd-collection__inner">
        <p class="rd-collection__eyebrow">From the Collection</p>
        <h2 class="rd-collection__title">The Bez Ambar Difference</h2>
      </div>
      <div class="rd-collection__strip">
        <div class="rd-collection__item">
          <img
            src={`${CDN}/c_fill,ar_3:4,w_600,g_center,f_auto,q_auto/v1775786208/Jewelry%20Images/Stones/Quadrillion_owciyv.jpg`}
            alt="The Princess Cut diamond — the original patented by Bez Ambar"
            loading="lazy"
            width="600"
            height="800"
          />
          <div class="rd-collection__caption">
            <p class="rd-collection__caption-title">The Princess Cut</p>
            <p class="rd-collection__caption-body">The original — created by Bez Ambar in 1979. Precision-cut for maximum brilliance in a square form.</p>
          </div>
        </div>
        <div class="rd-collection__item">
          <img
            src={`${CDN}/c_fill,ar_3:4,w_600,g_center,f_auto,q_auto/v1775549202/Jewelry%20Images/Rings/C0625_Baguette_band_Master_e4azkj.jpg`}
            alt="Bez Ambar diamond baguette band"
            loading="lazy"
            width="600"
            height="800"
          />
          <div class="rd-collection__caption">
            <p class="rd-collection__caption-title">Diamond Bands</p>
            <p class="rd-collection__caption-body">Eternity and anniversary bands set with the same precision that defines every Bez Ambar piece.</p>
          </div>
        </div>
        <div class="rd-collection__item">
          <img
            src={`${CDN}/c_fill,ar_3:4,w_600,g_center,f_auto,q_auto/Jewelry%20Images/legacy/10-carat-emerald-cut-diamond-ring-with-blaze.jpg`}
            alt="Bez Ambar statement diamond ring with Blaze® cut"
            loading="lazy"
            width="600"
            height="800"
          />
          <div class="rd-collection__caption">
            <p class="rd-collection__caption-title">Statement Pieces</p>
            <p class="rd-collection__caption-body">Significant diamonds deserving significant design. Each setting engineered to let light speak first.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- What to Expect — dark panel -->
    <section class="rd-expect">
      <div class="rd-expect__inner">
        <p class="rd-expect__eyebrow">What to Expect</p>
        <h2 class="rd-expect__title">At Every Authorized Showroom</h2>
        <div class="rd-expect__grid">
          <div class="rd-expect__item">
            <p class="rd-expect__num">01</p>
            <h3 class="rd-expect__head">The Full Collection</h3>
            <p class="rd-expect__body">This authorized showroom carries Bez Ambar diamond jewelry — including the Princess Cut originals and the Elysian Cut™, the square-brilliant cut patented by Bez Ambar.</p>
          </div>
          <div class="rd-expect__item">
            <p class="rd-expect__num">02</p>
            <h3 class="rd-expect__head">Expert Guidance</h3>
            <p class="rd-expect__body">Authorized retailers are trained on the Bez Ambar collection and can walk you through cut performance, setting options, and custom sizing for any piece.</p>
          </div>
          <div class="rd-expect__item">
            <p class="rd-expect__num">03</p>
            <h3 class="rd-expect__head">Authenticity Guaranteed</h3>
            <p class="rd-expect__body">Every Bez Ambar piece sold by an authorized retailer carries the full manufacturer warranty and certificate of authenticity directly from the atelier.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Footer CTA -->
    <section class="rd-cta">
      <div class="rd-cta__inner">
        <p class="rd-cta__eyebrow">Not near {retailer.city}?</p>
        <h2 class="rd-cta__title">See All Authorized Retailers</h2>
        <div class="rd-cta__btns">
          <a class="rd-cta__btn rd-cta__btn--primary" href="/retailers">View All Locations</a>
          <a class="rd-cta__btn rd-cta__btn--ghost" href="/contact">Contact the Atelier</a>
        </div>
      </div>
    </section>

  </div>
</Layout>

<style>
  /* ─── Hero ─── */
  .rd-hero {
    position: relative;
    min-height: 52vh;
    display: flex;
    align-items: flex-end;
    padding-bottom: 4.5rem;
    overflow: hidden;
    background: #0f0f0f;
  }
  .rd-hero__bg {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgba(0,0,0,0.06) 0%, rgba(0,0,0,0.76) 100%),
      var(--hero-img) center / cover no-repeat;
  }
  .rd-hero__content {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 960px;
    margin: 0 auto;
    padding: 0 2rem;
    color: #fff;
  }
  .rd-breadcrumb {
    font-family: var(--sans);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: rgba(255,255,255,0.5);
    margin-bottom: 1.8rem;
  }
  .rd-breadcrumb a {
    color: rgba(255,255,255,0.5);
    text-decoration: none;
    transition: color 0.2s;
  }
  .rd-breadcrumb a:hover { color: var(--accent); }
  .rd-breadcrumb span[aria-hidden] { padding: 0 0.3rem; }
  .rd-hero__eyebrow {
    font-family: var(--sans);
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 1.2rem;
  }
  .rd-hero__title {
    font-family: var(--serif, 'Cormorant Garamond', serif);
    font-size: clamp(2.4rem, 5.5vw, 4.2rem);
    font-weight: 300;
    line-height: 1.08;
    letter-spacing: 0.02em;
    margin: 0;
  }

  /* ─── Body ─── */
  .rd-body {
    max-width: 1100px;
    margin: 0 auto;
    padding: 5.5rem 2rem;
  }

  /* ─── Intro ─── */
  .rd-intro {
    display: grid;
    grid-template-columns: 1fr 1px 220px;
    gap: 3.5rem;
    align-items: start;
    padding-bottom: 5rem;
    border-bottom: 1px solid #e8e4de;
    margin-bottom: 5rem;
  }
  .rd-intro__eyebrow {
    font-family: var(--sans);
    font-size: 0.66rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 1.1rem;
  }
  .rd-intro__text {
    font-family: var(--sans);
    font-size: 1.02rem;
    line-height: 1.78;
    color: #3a3530;
    margin: 0 0 1.6rem;
  }
  .rd-intro__link {
    font-family: var(--sans);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    color: #1a1a1a;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    transition: color 0.2s;
  }
  .rd-intro__link:hover { color: var(--accent); }
  .rd-intro__divider {
    background: #e8e4de;
    align-self: stretch;
  }
  .rd-intro__badge {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    align-items: flex-start;
  }
  .rd-intro__badge-label {
    font-family: var(--sans);
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #5a5248;
    margin: 0;
  }
  .rd-intro__badge-logo { opacity: 0.8; }
  .rd-intro__badge-note {
    font-family: var(--sans);
    font-size: 0.78rem;
    line-height: 1.6;
    color: #9c9188;
    margin: 0;
    border-top: 1px solid #e8e4de;
    padding-top: 1rem;
  }

  /* ─── Locations ─── */
  .rd-locations__title {
    font-family: var(--serif, 'Cormorant Garamond', serif);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 300;
    color: #1a1a1a;
    margin: 0 0 3rem;
    letter-spacing: 0.01em;
  }
  .rd-locs-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
  }
  .rd-locs-grid--multi {
    grid-template-columns: repeat(auto-fill, minmax(460px, 1fr));
    gap: 3rem;
  }
  .rd-loc { display: flex; flex-direction: column; }
  .rd-loc__label {
    font-family: var(--sans);
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 0.9rem;
  }
  .rd-loc__map-wrap {
    width: 100%;
    aspect-ratio: 16/9;
    background: #e8e4de;
    overflow: hidden;
  }
  .rd-loc__map {
    width: 100%;
    height: 100%;
    display: block;
  }
  .rd-loc__info {
    padding: 2rem 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    align-items: start;
  }
  .rd-loc__block { display: flex; flex-direction: column; gap: 0.5rem; }
  .rd-loc__block-label {
    font-family: var(--sans);
    font-size: 0.63rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #b0a89e;
    margin: 0;
  }
  .rd-loc__address {
    font-family: var(--sans);
    font-size: 0.875rem;
    line-height: 1.6;
    color: #1a1a1a;
    font-style: normal;
    margin: 0;
  }
  .rd-loc__phone {
    font-family: var(--sans);
    font-size: 0.875rem;
    color: #1a1a1a;
    text-decoration: none;
    transition: color 0.2s;
  }
  .rd-loc__phone:hover { color: var(--accent); }
  .rd-loc__hours {
    font-family: var(--sans);
    font-size: 0.82rem;
    line-height: 1.55;
    color: #3a3530;
    margin: 0;
  }
  .rd-loc__directions {
    font-family: var(--sans);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #1a1a1a;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    align-self: start;
    padding-bottom: 0.1rem;
    transition: color 0.2s;
  }
  .rd-loc__directions:hover { color: var(--accent); }

  /* ─── From the Collection ─── */
  .rd-collection {
    background: #0f0f0f;
    padding: 5.5rem 0 0;
  }
  .rd-collection__inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2rem 3.5rem;
    color: #fff;
  }
  .rd-collection__eyebrow {
    font-family: var(--sans);
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 1.2rem;
  }
  .rd-collection__title {
    font-family: var(--serif, 'Cormorant Garamond', serif);
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    font-weight: 300;
    margin: 0;
    letter-spacing: 0.01em;
    color: #fff;
  }
  .rd-collection__strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    background: #1a1a1a;
  }
  .rd-collection__item {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .rd-collection__item img {
    width: 100%;
    display: block;
    object-fit: cover;
    filter: brightness(0.88);
    transition: filter 0.4s;
  }
  .rd-collection__item:hover img { filter: brightness(1); }
  .rd-collection__caption {
    padding: 1.8rem 2rem 2.5rem;
    background: #0f0f0f;
    flex: 1;
  }
  .rd-collection__caption-title {
    font-family: var(--sans);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 0.6rem;
  }
  .rd-collection__caption-body {
    font-family: var(--sans);
    font-size: 0.82rem;
    line-height: 1.65;
    color: rgba(255,255,255,0.6);
    margin: 0;
  }

  /* ─── What to Expect ─── */
  .rd-expect {
    background: #0f0f0f;
    border-top: 1px solid rgba(255,255,255,0.08);
  }
  .rd-expect__inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 5.5rem 2rem 6rem;
  }
  .rd-expect__eyebrow {
    font-family: var(--sans);
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 1.2rem;
  }
  .rd-expect__title {
    font-family: var(--serif, 'Cormorant Garamond', serif);
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    font-weight: 300;
    color: #fff;
    margin: 0 0 4rem;
    letter-spacing: 0.01em;
  }
  .rd-expect__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3.5rem;
  }
  .rd-expect__num {
    font-family: var(--serif, 'Cormorant Garamond', serif);
    font-size: 3rem;
    font-weight: 300;
    color: rgba(255,255,255,0.1);
    margin: 0 0 1rem;
    line-height: 1;
    letter-spacing: 0.02em;
  }
  .rd-expect__head {
    font-family: var(--sans);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.9);
    margin: 0 0 0.9rem;
  }
  .rd-expect__body {
    font-family: var(--sans);
    font-size: 0.875rem;
    line-height: 1.7;
    color: rgba(255,255,255,0.5);
    margin: 0;
  }

  /* ─── Footer CTA ─── */
  .rd-cta {
    background: #fff;
    padding: 6.5rem 2rem;
    border-top: 1px solid #e8e4de;
  }
  .rd-cta__inner {
    max-width: 580px;
    margin: 0 auto;
    text-align: center;
  }
  .rd-cta__eyebrow {
    font-family: var(--sans);
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 1.1rem;
  }
  .rd-cta__title {
    font-family: var(--serif, 'Cormorant Garamond', serif);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 300;
    margin: 0 0 2.8rem;
    line-height: 1.1;
    letter-spacing: 0.01em;
    color: #1a1a1a;
  }
  .rd-cta__btns {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .rd-cta__btn {
    font-family: var(--sans);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 1rem 2.2rem;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  .rd-cta__btn--primary {
    background: #1a1a1a;
    color: #fff;
  }
  .rd-cta__btn--primary:hover { background: var(--accent); }
  .rd-cta__btn--ghost {
    border: 1px solid #ccc6be;
    color: #3a3530;
  }
  .rd-cta__btn--ghost:hover {
    border-color: #1a1a1a;
    color: #1a1a1a;
  }

  /* ─── Responsive ─── */
  @media (max-width: 1024px) {
    .rd-collection__strip { grid-template-columns: 1fr; }
    .rd-collection__item img { max-height: 420px; }
  }
  @media (max-width: 900px) {
    .rd-intro {
      grid-template-columns: 1fr;
    }
    .rd-intro__divider { display: none; }
    .rd-intro__badge { flex-direction: row; align-items: center; flex-wrap: wrap; }
    .rd-intro__badge-note { width: 100%; flex-basis: 100%; }
    .rd-locs-grid--multi { grid-template-columns: 1fr; }
    .rd-expect__grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .rd-collection__strip { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .rd-loc__info { grid-template-columns: 1fr 1fr; }
    .rd-loc__directions { grid-column: 1 / -1; }
    .rd-body { padding: 3.5rem 1.25rem; }
    .rd-hero { min-height: 44vh; padding-bottom: 3rem; }
    .rd-expect__inner { padding: 4rem 1.25rem; }
    .rd-collection__inner { padding-left: 1.25rem; padding-right: 1.25rem; }
  }
</style>
