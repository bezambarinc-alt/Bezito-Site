---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page Not Found — Bez Ambar"
  description="The page you are looking for could not be found."
  canonical="https://bezambar.com/404"
>
  <main class="not-found">
    <div class="not-found__inner">
      <p class="not-found__code">404</p>
      <h1 class="not-found__title">Page Not Found</h1>
      <p class="not-found__copy">The piece you are looking for has moved, or may not exist. Let us help you find what you need.</p>
      <nav class="not-found__links">
        <a href="/">Home</a>
        <a href="/collection">Collection</a>
        <a href="/contact">Contact</a>
      </nav>
    </div>
  </main>
</Layout>

<style>
  .not-found {
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 80px 2rem;
    text-align: center;
  }
  .not-found__inner {
    max-width: 480px;
  }
  .not-found__code {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent, #95826b);
    margin-bottom: 24px;
  }
  .not-found__title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(36px, 6vw, 56px);
    font-weight: 300;
    letter-spacing: 0.04em;
    color: var(--ink, #1a1a1a);
    margin-bottom: 20px;
    line-height: 1.15;
  }
  .not-found__copy {
    font-family: 'EB Garamond', 'Cormorant Garamond', serif;
    font-size: 18px;
    line-height: 1.7;
    color: var(--ink, #1a1a1a);
    opacity: 0.7;
    margin-bottom: 48px;
  }
  .not-found__links {
    display: flex;
    gap: 32px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .not-found__links a {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--ink, #1a1a1a);
    text-decoration: none;
    border-bottom: 1px solid var(--accent, #95826b);
    padding-bottom: 2px;
    transition: color 0.2s;
  }
  .not-found__links a:hover {
    color: var(--accent, #95826b);
  }
</style>
