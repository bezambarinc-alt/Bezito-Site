---
import Layout from '../layouts/Layout.astro';
import '../styles/templates/404.css';
---

<Layout
  title="Page Not Found — Bez Ambar"
  description="The page you are looking for could not be found."
  canonical="https://bezambar.com/404"
  noindex={true}
>
  <main class="ba-not-found">
    <div class="ba-not-found__inner">
      <p class="ba-not-found__code">404</p>
      <h1 class="ba-not-found__title">Page Not Found</h1>
      <p class="ba-not-found__copy">The piece you are looking for has moved, or may not exist. Let us help you find what you need.</p>
      <nav class="ba-not-found__links">
        <a href="/">Home</a>
        <a href="/collection">Collection</a>
        <a href="/contact">Contact</a>
      </nav>
    </div>
  </main>
</Layout>
