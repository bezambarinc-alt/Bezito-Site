---
import Layout from '../layouts/Layout.astro';
import '../styles/templates/about.css';
---

<Layout
  title="Journal — Behind the Craft | Bez Ambar"
  description="The Bez Ambar journal — behind the atelier, the craft, the stones. Latest from @bezambar on Instagram."
  canonical="https://bezambar.com/journal"
  headerLight={true}
>
  <section class="ba-light-hero">
    <p class="ba-light-hero__eyebrow">@bezambar</p>
    <h1>Journal</h1>
    <p class="ba-light-hero__intro">Behind the craft. Inside the atelier. The latest from the workbench, shared as it happens.</p>
  </section>

  <section class="feed-section">
    <div id="curator-feed-default-feed-layout">
      <a href="https://curator.io" target="_blank" class="crt-logo crt-tag">Powered by Curator.io</a>
    </div>
    <div id="journal-fallback" class="journal-fallback" style="display:none">
      <p class="journal-fallback__msg">Instagram feed is loading&hellip; if it doesn't appear, <a href="https://www.instagram.com/bezambar/" target="_blank" rel="noopener">follow us on Instagram</a>.</p>
      <div class="journal-fallback__grid">
        <a href="https://www.instagram.com/bezambar/" target="_blank" rel="noopener" class="journal-fallback__card">
          <img src="https://res.cloudinary.com/dlg2mou53/image/upload/f_auto,q_auto,w_600/Jewelry%20Images/legacy/5-carat-emerald-cut-engagement-ring-christina-ring.jpg" alt="Bez Ambar — @bezambar on Instagram" loading="lazy">
        </a>
        <a href="https://www.instagram.com/bezambar/" target="_blank" rel="noopener" class="journal-fallback__card">
          <img src="https://res.cloudinary.com/dlg2mou53/image/upload/f_auto,q_auto,w_600/Jewelry%20Images/legacy/1-Carat-Diamond-Engagement-Ring-French-Paloma-white.jpg" alt="Bez Ambar — @bezambar on Instagram" loading="lazy">
        </a>
        <a href="https://www.instagram.com/bezambar/" target="_blank" rel="noopener" class="journal-fallback__card">
          <img src="https://res.cloudinary.com/dlg2mou53/image/upload/f_auto,q_auto,w_600/Jewelry%20Images/legacy/bouquet-of-light-oval-diamond-center-engagement-ring-1bol-ov.jpg" alt="Bez Ambar — @bezambar on Instagram" loading="lazy">
        </a>
        <a href="https://www.instagram.com/bezambar/" target="_blank" rel="noopener" class="journal-fallback__card">
          <img src="https://res.cloudinary.com/dlg2mou53/image/upload/f_auto,q_auto,w_600/Jewelry%20Images/legacy/5-carat-emerald-cut-engagement-ring-christina-ring.jpg" alt="Bez Ambar — @bezambar on Instagram" loading="lazy">
        </a>
      </div>
    </div>
  </section>

  <section class="ba-follow-cta">
    <p class="ba-follow-cta__handle">@bezambar</p>
    <a class="ba-follow-cta__link" href="https://www.instagram.com/bezambar/" target="_blank" rel="noopener">Follow on Instagram &rarr;</a>
  </section>

  <section class="services-strip">
    <div class="services-inner">
      <div class="service-item">
        <h4>Bespoke Design</h4>
        <p>One-of-a-kind pieces designed with you in our LA atelier.</p>
      </div>
      <div class="service-item">
        <h4>Complimentary Shipping</h4>
        <p>Fully insured FedEx Priority delivery worldwide.</p>
      </div>
      <div class="service-item">
        <h4>Provenance Certificate</h4>
        <p>Signed certificate of authenticity with every piece.</p>
      </div>
      <div class="service-item">
        <h4>LA Atelier</h4>
        <p>Visit us by appointment. 611 Wilshire Blvd, Los Angeles.</p>
      </div>
    </div>
  </section>
</Layout>

<script>
  (function () {
    var i, e, d = document, s = 'script';
    i = d.createElement(s); i.async = 1; i.charset = 'UTF-8';
    i.src = 'https://cdn.curator.io/published/8a90bee5-25c8-4b36-a23b-0db33a392762.js';
    e = d.getElementsByTagName(s)[0]; e.parentNode.insertBefore(i, e);

    // Fallback: if curator hasn't injected feed items within 6s, show static grid
    setTimeout(function () {
      var feed = d.getElementById('curator-feed-default-feed-layout');
      var fallback = d.getElementById('journal-fallback');
      if (!feed || !fallback) return;
      var hasItems = feed.querySelectorAll('.crt-post').length > 0;
      if (!hasItems) fallback.style.display = 'block';
    }, 6000);
  })();
</script>
