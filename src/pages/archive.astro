---
import Layout from '../layouts/Layout.astro';
import '../styles/templates/editorial.css';
---

<Layout
  title="The Archive — 500+ Pieces in Motion | Bez Ambar"
  description="Watch over five hundred Bez Ambar jewelry pieces under atelier light. Rings, bands, necklaces, earrings, and bracelets — every stone in motion before you inquire."
  canonical="https://bezambar.com/archive"
  headerLight={true}
>
  <section class="vg-hero">
    <p class="vg-hero__eyebrow">The Archive</p>
    <h1 class="vg-hero__title">Every Piece in Motion</h1>
    <p class="vg-hero__lede">Over five hundred Bez Ambar pieces, filmed at the atelier in Los Angeles. Watch each stone under light before you inquire.</p>
    <!-- Pill anchor — pill starts here, floats to bottom on scroll -->
    <div class="ba-filter-pill-anchor" id="archivePillAnchor">
      <button class="ba-filter-pill" id="archiveFilterPill" aria-label="Filter pieces">
        <svg viewBox="0 0 14 10" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <line x1="0" y1="1.5" x2="14" y2="1.5"/>
          <line x1="2" y1="5" x2="12" y2="5"/>
          <line x1="4" y1="8.5" x2="10" y2="8.5"/>
        </svg>
        <span id="archivePillLabel">Filter</span>
      </button>
    </div>
  </section>

  <!-- Backdrop -->
  <div class="ba-filter-overlay" id="archiveFilterOverlay" aria-hidden="true"></div>

  <!-- Filter panel -->
  <aside class="ba-filter-panel" id="archiveFilterPanel" role="dialog" aria-label="Filter archive">
    <button class="ba-filter-panel__close" id="archiveFilterClose" aria-label="Close filters">✕</button>
    <span class="ba-filter-panel__title">Filter</span>
    <div class="ba-filter-panel__body">

      <span class="ba-filter-section-label">Collection</span>
      <div class="ba-filter-opts-row">
        <button class="ba-filter-opt is-active" data-filter-cat="all">All</button>
        <button class="ba-filter-opt" data-filter-cat="rings">Rings</button>
        <button class="ba-filter-opt" data-filter-cat="bands">Bands</button>
        <button class="ba-filter-opt" data-filter-cat="necklaces">Necklaces</button>
        <button class="ba-filter-opt" data-filter-cat="earrings">Earrings</button>
        <button class="ba-filter-opt" data-filter-cat="bracelets">Bracelets</button>
        <button class="ba-filter-opt" data-filter-cat="mens">Men's</button>
      </div>

      <span class="ba-filter-section-label">Stone Shape</span>
      <div class="ba-filter-opts-row">
        <button class="ba-filter-opt is-active" data-filter-shape="all">All</button>
        <button class="ba-filter-opt" data-filter-shape="round">Round</button>
        <button class="ba-filter-opt" data-filter-shape="oval">Oval</button>
        <button class="ba-filter-opt" data-filter-shape="pear">Pear</button>
        <button class="ba-filter-opt" data-filter-shape="princess">Princess</button>
        <button class="ba-filter-opt" data-filter-shape="fancy-color">Fancy Color</button>
      </div>

      <span class="ba-filter-section-label">Carat Weight (Total Piece)</span>
      <div class="ba-filter-range">
        <div class="ba-filter-range__field">
          <label class="ba-filter-range__label">Min</label>
          <input class="ba-filter-range__input" type="number" id="caratMin" min="0" step="0.1" placeholder="0">
        </div>
        <span class="ba-filter-range__sep">—</span>
        <div class="ba-filter-range__field">
          <label class="ba-filter-range__label">Max</label>
          <input class="ba-filter-range__input" type="number" id="caratMax" min="0" step="0.1" placeholder="Any">
        </div>
      </div>

      <span class="ba-filter-section-label">Price</span>
      <div class="ba-filter-range">
        <div class="ba-filter-range__field">
          <label class="ba-filter-range__label">Min $</label>
          <input class="ba-filter-range__input" type="number" id="priceMin" min="0" step="1000" placeholder="0">
        </div>
        <span class="ba-filter-range__sep">—</span>
        <div class="ba-filter-range__field">
          <label class="ba-filter-range__label">Max $</label>
          <input class="ba-filter-range__input" type="number" id="priceMax" min="0" step="1000" placeholder="Any">
        </div>
      </div>

    </div>
    <div class="ba-filter-panel__footer">
      <button class="ba-filter-panel__reset" id="archiveFilterReset">Clear All</button>
      <button class="ba-filter-panel__results" id="archiveFilterApply">Show Pieces</button>
    </div>
  </aside>

  <!-- Video grid -->
  <div class="vg-grid" id="vgGrid">
    <div class="grid-sizer"></div>
    <div class="gutter-sizer"></div>
    <p class="archive-loading">Loading collection…</p>
  </div>

  <!-- Archive piece modal: video left + inquiry form right -->
  <div id="am-overlay" class="am-overlay" hidden aria-modal="true" role="dialog" aria-label="Piece detail">
    <div class="am-backdrop" id="amBackdrop"></div>
    <div class="am-panel">
      <button class="am-close" id="amClose" aria-label="Close">&#x2715;</button>
      <div class="am-video-col">
        <video class="am-video" id="amVideo" autoplay muted loop playsinline></video>
      </div>
      <div class="am-form-col">
        <p class="am-eyebrow">Inquiring about</p>
        <p class="am-piece-title" id="amPieceTitle"></p>
        <h2 class="am-heading">Connect with the Atelier</h2>
        <p class="am-subhead">We respond personally within one business day.</p>
        <form id="am-form" novalidate>
          <input type="hidden" id="am-intent" name="intent" value="archive piece">
          <div class="am-fields">
            <div class="inq-form__field">
              <label class="inq-form__label" for="am-name">Your Name</label>
              <input class="inq-form__input" type="text" id="am-name" name="name" placeholder="First and Last" required autocomplete="name">
            </div>
            <div class="inq-form__field">
              <label class="inq-form__label" for="am-email">Email Address</label>
              <input class="inq-form__input" type="email" id="am-email" name="email" placeholder="you@email.com" required autocomplete="email">
            </div>
          </div>
          <p class="form-privacy">Your enquiry is private and handled directly by Bez's team.</p>
          <button type="submit" class="ba-drawer__submit" id="am-submit">
            <span class="btn-label">Send Inquiry</span>
            <span class="btn-loading" aria-hidden="true" style="display:none">Sending…</span>
          </button>
          <p class="form-error" id="am-error" role="alert" style="display:none"></p>
        </form>
        <div id="am-success" class="form-success-state" style="display:none">
          <div class="success-mark">&#10022;</div>
          <h3>Your inquiry has been received.</h3>
          <p>A member of our team will be in touch within one business day.</p>
        </div>
      </div>
    </div>
  </div>

</Layout>

<style is:global>
/* ── Archive piece modal ───────────────────────────────────── */
.am-overlay {
  position: fixed;
  inset: 0;
  z-index: 950;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.25s ease;
}
.am-overlay.is-open { opacity: 1; }
.am-overlay[hidden] { display: none !important; }
.am-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.82);
}
.am-panel {
  position: relative;
  display: grid;
  grid-template-columns: 60fr 40fr;
  width: min(1120px, 96vw);
  max-height: 90vh;
  background: #0e0e0e;
  overflow: hidden;
  box-shadow: 0 24px 80px rgba(0,0,0,0.6);
}
.am-close {
  position: absolute;
  top: 1rem;
  right: 1rem;
  z-index: 20;
  background: rgba(0,0,0,0.55);
  border: 1px solid rgba(255,255,255,0.15);
  color: #fff;
  font-size: 0.9rem;
  width: 2.25rem;
  height: 2.25rem;
  border-radius: 50%;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.15s;
}
.am-close:hover { background: rgba(0,0,0,0.85); }
.am-video-col {
  background: #000;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  max-height: 90vh;
}
.am-video {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.am-form-col {
  background: var(--white, #fff);
  padding: 2.75rem 2.25rem 2.75rem;
  overflow-y: auto;
  max-height: 90vh;
}
.am-eyebrow {
  font-family: var(--sans);
  text-transform: var(--sans-transform, none);
  letter-spacing: var(--sans-letter-spacing, normal);
  font-size: 0.6875rem;
  color: var(--ink-muted, #888);
  margin-bottom: 0.25rem;
}
.am-piece-title {
  font-size: 1rem;
  color: var(--ink, #1a1a1a);
  line-height: 1.4;
  margin-bottom: 1.75rem;
  padding-left: 0.875rem;
  border-left: 2px solid var(--accent, #95826b);
}
.am-heading {
  font-size: 1.375rem;
  font-weight: 400;
  color: var(--ink, #1a1a1a);
  margin-bottom: 0.4rem;
}
.am-subhead {
  font-family: var(--sans);
  text-transform: var(--sans-transform, none);
  letter-spacing: var(--sans-letter-spacing, normal);
  font-size: 0.8125rem;
  color: var(--ink-muted, #888);
  margin-bottom: 2rem;
  line-height: 1.5;
}
.am-fields {
  display: flex;
  flex-direction: column;
  gap: 28px;
  margin-bottom: 1.75rem;
}
@media (max-width: 680px) {
  .am-panel {
    grid-template-columns: 1fr;
    grid-template-rows: 42vw 1fr;
    width: 100%;
    max-height: 100dvh;
  }
  .am-video-col { max-height: 42vw; }
  .am-form-col { max-height: calc(100dvh - 42vw); padding: 2rem 1.5rem; }
  .am-close { top: 0.75rem; right: 0.75rem; }
}
</style>

<script>
(function() {
  var WORKER_URL = 'https://bezito-forms.bezambarinc.workers.dev';

  var HEIGHTS = ['video-card--md','video-card--lg','video-card--sm',
                 'video-card--md','video-card--sm','video-card--lg',
                 'video-card--md','video-card--sm','video-card--lg',
                 'video-card--md','video-card--lg','video-card--sm'];

  // Pill: starts inline below hero, floats to bottom when anchor scrolls out
  var pill   = document.getElementById('archiveFilterPill');
  var anchor = document.getElementById('archivePillAnchor');
  if (pill && anchor) {
    new IntersectionObserver(function(entries) {
      pill.classList.toggle('is-floating', !entries[0].isIntersecting);
    }, { threshold: 0 }).observe(anchor);
  }

  // ── Archive modal ──────────────────────────────────────────
  var amOverlay   = document.getElementById('am-overlay');
  var amBackdrop  = document.getElementById('amBackdrop');
  var amClose     = document.getElementById('amClose');
  var amVideo     = document.getElementById('amVideo');
  var amTitle     = document.getElementById('amPieceTitle');
  var amForm      = document.getElementById('am-form');
  var amSuccess   = document.getElementById('am-success');
  var amError     = document.getElementById('am-error');
  var amSubmit    = document.getElementById('am-submit');
  var amPieceSku  = '';
  var amPieceTitle = '';

  function openModal(mp4Url, title, sku) {
    amPieceTitle = title || '';
    amPieceSku   = sku   || '';
    amTitle.textContent = title || '';
    amVideo.src = mp4Url || '';
    amVideo.load();
    amVideo.play().catch(function() {});
    amForm.style.display = '';
    amSuccess.style.display = 'none';
    amError.style.display = 'none';
    amForm.reset();
    amOverlay.hidden = false;
    requestAnimationFrame(function() { amOverlay.classList.add('is-open'); });
    document.body.style.overflow = 'hidden';
    setTimeout(function() {
      var nameInput = amForm.querySelector('#am-name');
      if (nameInput) nameInput.focus();
    }, 60);
  }

  function closeModal() {
    amOverlay.classList.remove('is-open');
    document.body.style.overflow = '';
    setTimeout(function() {
      amOverlay.hidden = true;
      amVideo.pause();
      amVideo.src = '';
    }, 260);
  }

  if (amClose)   amClose.addEventListener('click', closeModal);
  if (amBackdrop) amBackdrop.addEventListener('click', closeModal);
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && amOverlay && amOverlay.classList.contains('is-open')) closeModal();
  });

  if (amForm) {
    amForm.addEventListener('submit', function(e) {
      e.preventDefault();
      var btnLabel   = amSubmit.querySelector('.btn-label');
      var btnLoading = amSubmit.querySelector('.btn-loading');
      if (btnLabel)   btnLabel.style.display   = 'none';
      if (btnLoading) btnLoading.style.display = '';
      amSubmit.disabled = true;
      amError.style.display = 'none';

      var data = new FormData(amForm);
      var fullName = (data.get('name') || '').trim();
      var spaceIdx = fullName.indexOf(' ');
      var firstName = spaceIdx > -1 ? fullName.slice(0, spaceIdx) : fullName;
      var lastName  = spaceIdx > -1 ? fullName.slice(spaceIdx + 1) : '';

      var payload = {
        firstName: firstName,
        lastName:  lastName,
        email:     data.get('email'),
        phone:     '',
        intent:    'archive piece',
        message:   '',
        pieceTitle: amPieceTitle,
        pieceSku:   amPieceSku,
        utmSource:   sessionStorage.getItem('utm_source')   || '',
        utmMedium:   sessionStorage.getItem('utm_medium')   || '',
        utmCampaign: sessionStorage.getItem('utm_campaign') || '',
      };

      fetch(WORKER_URL + '/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      })
      .then(function(res) {
        if (!res.ok) return res.json().catch(function() { return {}; }).then(function(b) {
          throw new Error(b.error || 'Submission failed. Please try again.');
        });
        amForm.style.display = 'none';
        amSuccess.style.display = '';
      })
      .catch(function(err) {
        amError.textContent = err.message || 'Something went wrong. Please email us at bez@bezambar.com.';
        amError.style.display = '';
        if (btnLabel)   btnLabel.style.display   = '';
        if (btnLoading) btnLoading.style.display = 'none';
        amSubmit.disabled = false;
      });
    });
  }

  // ── Helpers ────────────────────────────────────────────────
  function escAttr(s) {
    return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function shapeFromEntry(entry) {
    var cat = (entry.category || '').toLowerCase();
    if (cat.includes('round'))  return 'round';
    if (cat.includes('oval'))   return 'oval';
    if (cat.includes('pear'))   return 'pear';
    if (cat.includes('princess') || cat.includes('blaze')) return 'princess';
    if (cat.includes('fancy') || cat.includes('color') || cat.includes('colour')) return 'fancy-color';
    if (cat.includes('emerald')) return 'emerald';
    if (cat.includes('cushion')) return 'cushion';
    if (cat.includes('marquise')) return 'marquise';
    return 'other';
  }

  function buildCard(id, entry, idx) {
    var a = document.createElement('a');
    a.className = 'video-card ' + HEIGHTS[idx % HEIGHTS.length];
    a.href = '/archive?id=' + encodeURIComponent(id);
    a.dataset.category = entry.htmlCategory || 'rings';
    a.dataset.shape  = shapeFromEntry(entry);
    a.dataset.carats = entry.carats || '';
    a.dataset.price  = entry.price  || '';
    a.dataset.mp4  = entry.mp4Url  || '';
    a.dataset.title = entry.title || '';
    a.dataset.sku   = id;
    a.innerHTML =
      '<img class="video-thumb" loading="lazy" decoding="async"' +
      ' data-src="' + escAttr(entry.gifUrl) + '"' +
      ' alt="' + escAttr(entry.title) + '">' +
      '<div class="play-btn"><svg viewBox="0 0 24 24"><polygon points="6,3 20,12 6,21"/></svg></div>' +
      '<div class="video-overlay"><h3>' + escAttr(entry.title) + '</h3></div>';
    return a;
  }

  function initGrid(cards) {
    var byCategory = Object.create(null);
    cards.forEach(function(card) {
      var cat = card.dataset.category || 'all';
      (byCategory[cat] = byCategory[cat] || []).push(card);
    });

    var imgObserver = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        if (!e.isIntersecting) return;
        var img = e.target;
        if (img.dataset.src) {
          img.src = img.dataset.src;
          delete img.dataset.src;
          img.addEventListener('load', function() { img.classList.add('is-loaded'); }, { once: true });
        }
        imgObserver.unobserve(img);
      });
    }, { rootMargin: '800px' });

    var pauseObserver = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        var img = e.target.querySelector('.video-thumb');
        if (!img) return;
        if (e.isIntersecting) {
          if (img.dataset.paused) { img.src = img.dataset.paused; delete img.dataset.paused; }
        } else if (img.src && img.classList.contains('is-loaded')) {
          img.dataset.paused = img.src;
          img.src = '';
        }
      });
    }, { rootMargin: '100px' });

    var eagerCount = 0;
    cards.forEach(function(card) {
      var img = card.querySelector('.video-thumb');
      if (img && img.dataset.src && eagerCount < 24) {
        img.src = img.dataset.src;
        delete img.dataset.src;
        img.addEventListener('load', function() { img.classList.add('is-loaded'); }, { once: true });
        eagerCount++;
      }
    });

    cards.forEach(function(card) {
      var img = card.querySelector('.video-thumb');
      if (img && img.dataset.src) imgObserver.observe(img);
      pauseObserver.observe(card);
    });

    // Filter state
    var overlay  = document.getElementById('archiveFilterOverlay');
    var panel    = document.getElementById('archiveFilterPanel');
    var closeBtn = document.getElementById('archiveFilterClose');
    var applyBtn = document.getElementById('archiveFilterApply');
    var resetBtn = document.getElementById('archiveFilterReset');
    var catOpts   = document.querySelectorAll('[data-filter-cat]');
    var shapeOpts = document.querySelectorAll('[data-filter-shape]');
    var caratMinEl = document.getElementById('caratMin');
    var caratMaxEl = document.getElementById('caratMax');
    var priceMinEl = document.getElementById('priceMin');
    var priceMaxEl = document.getElementById('priceMax');

    var activeCategory = 'all';
    var activeShape    = 'all';

    function getNum(el) { var v = parseFloat(el && el.value); return isNaN(v) ? null : v; }

    function passesCard(card) {
      // Category
      if (activeCategory !== 'all' && card.dataset.category !== activeCategory) return false;
      // Shape — "other" cards are excluded only if a specific shape is active
      if (activeShape !== 'all') {
        var s = card.dataset.shape || 'other';
        if (s !== activeShape) return false;
      }
      // Carat range (only filter if card has carat data)
      var carats = parseFloat(card.dataset.carats);
      if (!isNaN(carats)) {
        var cMin = getNum(caratMinEl), cMax = getNum(caratMaxEl);
        if (cMin !== null && carats < cMin) return false;
        if (cMax !== null && carats > cMax) return false;
      }
      // Price range (only filter if card has price data)
      var price = parseFloat(card.dataset.price);
      if (!isNaN(price)) {
        var pMin = getNum(priceMinEl), pMax = getNum(priceMaxEl);
        if (pMin !== null && price < pMin) return false;
        if (pMax !== null && price > pMax) return false;
      }
      return true;
    }

    function applyFilter() {
      var count = 0;
      cards.forEach(function(card) {
        var show = passesCard(card);
        if (show) count++;
        card.hidden = !show;
        var img = card.querySelector('.video-thumb');
        if (!img) return;
        if (show) {
          if (img.dataset.src) imgObserver.observe(img);
          pauseObserver.observe(card);
        } else {
          if (img.src && !img.dataset.src) {
            img.dataset.src = img.src;
            img.src = '';
            img.classList.remove('is-loaded');
          }
          imgObserver.unobserve(img);
          pauseObserver.unobserve(card);
        }
      });
      var applyLabel = applyBtn && applyBtn;
      if (applyLabel) applyLabel.textContent = count + ' Piece' + (count !== 1 ? 's' : '');
    }

    function pillLabel() {
      var parts = [];
      if (activeCategory !== 'all') parts.push(activeCategory);
      if (activeShape !== 'all') parts.push(activeShape);
      var cMin = getNum(caratMinEl), cMax = getNum(caratMaxEl);
      if (cMin !== null || cMax !== null) parts.push('Carats');
      var pMin = getNum(priceMinEl), pMax = getNum(priceMaxEl);
      if (pMin !== null || pMax !== null) parts.push('Price');
      var label = parts.length ? parts.join(' · ') : 'Filter';
      var pillLabelEl = document.getElementById('archivePillLabel');
      if (pillLabelEl) pillLabelEl.textContent = label;
      if (pill) pill.classList.toggle('is-active', parts.length > 0);
    }

    function openPanel()  { applyFilter(); panel && panel.classList.add('is-open'); overlay && overlay.classList.add('is-active'); }
    function closePanel() { panel && panel.classList.remove('is-open'); overlay && overlay.classList.remove('is-active'); pillLabel(); }

    function resetFilters() {
      activeCategory = 'all';
      activeShape    = 'all';
      catOpts.forEach(function(o) { o.classList.toggle('is-active', o.dataset.filterCat === 'all'); });
      shapeOpts.forEach(function(o) { o.classList.toggle('is-active', o.dataset.filterShape === 'all'); });
      if (caratMinEl) caratMinEl.value = '';
      if (caratMaxEl) caratMaxEl.value = '';
      if (priceMinEl) priceMinEl.value = '';
      if (priceMaxEl) priceMaxEl.value = '';
      applyFilter();
    }

    if (pill)     pill.addEventListener('click', openPanel);
    if (overlay)  overlay.addEventListener('click', function() { applyFilter(); closePanel(); });
    if (closeBtn) closeBtn.addEventListener('click', function() { applyFilter(); closePanel(); });
    if (applyBtn) applyBtn.addEventListener('click', function() { applyFilter(); closePanel(); });
    if (resetBtn) resetBtn.addEventListener('click', resetFilters);

    catOpts.forEach(function(opt) {
      opt.addEventListener('click', function() {
        catOpts.forEach(function(o) { o.classList.remove('is-active'); });
        opt.classList.add('is-active');
        activeCategory = opt.dataset.filterCat || 'all';
        applyFilter();
      });
    });

    shapeOpts.forEach(function(opt) {
      opt.addEventListener('click', function() {
        shapeOpts.forEach(function(o) { o.classList.remove('is-active'); });
        opt.classList.add('is-active');
        activeShape = opt.dataset.filterShape || 'all';
        applyFilter();
      });
    });

    [caratMinEl, caratMaxEl, priceMinEl, priceMaxEl].forEach(function(el) {
      if (el) el.addEventListener('input', applyFilter);
    });

    // Card clicks → archive modal (video + form)
    cards.forEach(function(card) {
      card.addEventListener('click', function(e) {
        e.preventDefault();
        openModal(card.dataset.mp4, card.dataset.title, card.dataset.sku);
      });
    });
  }

  // Fetch and render
  var grid = document.getElementById('vgGrid');
  fetch('/archive-data.json')
    .then(function(r) { return r.json(); })
    .then(function(data) {
      var frag = document.createDocumentFragment();
      var rendered = [];
      var idx = 0;
      Object.keys(data).forEach(function(id) {
        var entry = data[id];
        if (!entry.gifUrl) return;
        var card = buildCard(id, entry, idx++);
        frag.appendChild(card);
        rendered.push(card);
      });
      var loading = grid.querySelector('.archive-loading');
      if (loading) loading.remove();
      grid.appendChild(frag);
      initGrid(rendered);
    })
    .catch(function(err) {
      var loading = grid && grid.querySelector('.archive-loading');
      if (loading) loading.textContent = 'Unable to load collection. Please refresh.';
      console.error('Archive fetch error:', err);
    });
})();
</script>
