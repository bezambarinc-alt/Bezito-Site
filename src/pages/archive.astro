---
import Layout from '../layouts/Layout.astro';
import '../styles/templates/editorial.css';
---

<Layout
  title="The Archive — 500+ Pieces in Motion | Bez Ambar"
  description="Watch over five hundred Bez Ambar jewelry pieces under atelier light. Rings, bands, necklaces, earrings, and bracelets — every stone in motion before you inquire."
  canonical="https://bezambar.com/archive"
  headerLight={true}
>
  <section class="vg-hero">
    <p class="vg-hero__eyebrow">The Archive</p>
    <h1 class="vg-hero__title">Every Piece in Motion</h1>
    <p class="vg-hero__lede">Over five hundred Bez Ambar pieces, filmed at the atelier in Los Angeles. Watch each stone under light before you inquire.</p>
    <!-- Pill anchor — pill starts here, floats to bottom on scroll -->
    <div class="ba-filter-pill-anchor" id="archivePillAnchor">
      <button class="ba-filter-pill" id="archiveFilterPill" aria-label="Filter pieces">
        <svg viewBox="0 0 14 10" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <line x1="0" y1="1.5" x2="14" y2="1.5"/>
          <line x1="2" y1="5" x2="12" y2="5"/>
          <line x1="4" y1="8.5" x2="10" y2="8.5"/>
        </svg>
        <span id="archivePillLabel">Filter</span>
      </button>
    </div>
  </section>

  <!-- Backdrop -->
  <div class="ba-filter-overlay" id="archiveFilterOverlay" aria-hidden="true"></div>

  <!-- Filter panel — styled to match nav menu drawer -->
  <aside class="ba-filter-panel" id="archiveFilterPanel" role="dialog" aria-label="Filter archive">
    <button class="ba-filter-panel__close" id="archiveFilterClose" aria-label="Close filters">✕</button>
    <span class="ba-filter-panel__title">Filter</span>
    <nav class="ba-filter-panel__body">
      <span class="ba-filter-section-label">Collection</span>
      <button class="ba-filter-opt is-active" data-filter="all">All Pieces</button>
      <button class="ba-filter-opt" data-filter="rings">Rings</button>
      <button class="ba-filter-opt" data-filter="bands">Bands</button>
      <button class="ba-filter-opt" data-filter="necklaces">Necklaces</button>
      <button class="ba-filter-opt" data-filter="earrings">Earrings</button>
      <button class="ba-filter-opt" data-filter="bracelets">Bracelets</button>
      <button class="ba-filter-opt" data-filter="mens">Men's</button>
    </nav>
    <div class="ba-filter-panel__footer">
      <button class="ba-filter-panel__results" id="archiveFilterApply">Show Pieces</button>
    </div>
  </aside>



  <!-- Video grid -->
  <div class="vg-grid" id="vgGrid">
  <div class="grid-sizer"></div>
  <div class="gutter-sizer"></div>
  <p class="archive-loading">Loading collection…</p>
  </div>
</Layout>

<script>
(function() {
  var HEIGHTS = ['video-card--md','video-card--lg','video-card--sm',
                 'video-card--md','video-card--sm','video-card--lg',
                 'video-card--md','video-card--sm','video-card--lg',
                 'video-card--md','video-card--lg','video-card--sm'];

  // Pill: starts inline below hero, floats to bottom when anchor scrolls out
  var pill   = document.getElementById('archiveFilterPill');
  var anchor = document.getElementById('archivePillAnchor');
  if (pill && anchor) {
    new IntersectionObserver(function(entries) {
      pill.classList.toggle('is-floating', !entries[0].isIntersecting);
    }, { threshold: 0 }).observe(anchor);
  }

  function escAttr(s) {
    return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function buildCard(id, entry, idx) {
    var a = document.createElement('a');
    a.className = 'video-card ' + HEIGHTS[idx % HEIGHTS.length];
    a.href = '/archive?id=' + encodeURIComponent(id);
    a.dataset.category = entry.htmlCategory || 'rings';
    a.innerHTML =
      '<img class="video-thumb" loading="lazy" decoding="async"' +
      ' data-src="' + escAttr(entry.gifUrl) + '"' +
      ' alt="' + escAttr(entry.title) + '">' +
      '<div class="play-btn"><svg viewBox="0 0 24 24"><polygon points="6,3 20,12 6,21"/></svg></div>' +
      '<div class="video-overlay"><h3>' + escAttr(entry.title) + '</h3></div>';
    return a;
  }

  function initGrid(cards) {
    var byCategory = Object.create(null);
    cards.forEach(function(card) {
      var cat = card.dataset.category || 'all';
      (byCategory[cat] = byCategory[cat] || []).push(card);
    });

    var imgObserver = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        if (!e.isIntersecting) return;
        var img = e.target;
        if (img.dataset.src) {
          img.src = img.dataset.src;
          delete img.dataset.src;
          img.addEventListener('load', function() { img.classList.add('is-loaded'); }, { once: true });
        }
        imgObserver.unobserve(img);
      });
    }, { rootMargin: '800px' });

    var pauseObserver = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        var img = e.target.querySelector('.video-thumb');
        if (!img) return;
        if (e.isIntersecting) {
          if (img.dataset.paused) { img.src = img.dataset.paused; delete img.dataset.paused; }
        } else if (img.src && img.classList.contains('is-loaded')) {
          img.dataset.paused = img.src;
          img.src = '';
        }
      });
    }, { rootMargin: '100px' });

    var eagerCount = 0;
    cards.forEach(function(card) {
      var img = card.querySelector('.video-thumb');
      if (img && img.dataset.src && eagerCount < 24) {
        img.src = img.dataset.src;
        delete img.dataset.src;
        img.addEventListener('load', function() { img.classList.add('is-loaded'); }, { once: true });
        eagerCount++;
      }
    });

    cards.forEach(function(card) {
      var img = card.querySelector('.video-thumb');
      if (img && img.dataset.src) imgObserver.observe(img);
      pauseObserver.observe(card);
    });

    // Filter
    var overlay  = document.getElementById('archiveFilterOverlay');
    var panel    = document.getElementById('archiveFilterPanel');
    var closeBtn = document.getElementById('archiveFilterClose');
    var applyBtn = document.getElementById('archiveFilterApply');
    var opts     = document.querySelectorAll('.ba-filter-opt');
    var activeCategory = 'all';

    function applyFilter() {
      var visibleSet = new Set(
        activeCategory === 'all' ? cards : (byCategory[activeCategory] || [])
      );
      cards.forEach(function(card) {
        var show = visibleSet.has(card);
        card.hidden = !show;
        var img = card.querySelector('.video-thumb');
        if (!img) return;
        if (show) {
          if (img.dataset.src) imgObserver.observe(img);
          pauseObserver.observe(card);
        } else {
          if (img.src && !img.dataset.src) {
            img.dataset.src = img.src;
            img.src = '';
            img.classList.remove('is-loaded');
          }
          imgObserver.unobserve(img);
          pauseObserver.unobserve(card);
        }
      });
    }

    function openPanel()  { panel && panel.classList.add('is-open'); overlay && overlay.classList.add('is-active'); }
    function closePanel() { panel && panel.classList.remove('is-open'); overlay && overlay.classList.remove('is-active'); }

    if (pill)     pill.addEventListener('click', openPanel);
    if (overlay)  overlay.addEventListener('click', closePanel);
    if (closeBtn) closeBtn.addEventListener('click', closePanel);
    if (applyBtn) applyBtn.addEventListener('click', closePanel);

    opts.forEach(function(opt) {
      opt.addEventListener('click', function() {
        opts.forEach(function(o) { o.classList.remove('is-active'); });
        opt.classList.add('is-active');
        activeCategory = opt.dataset.filter || 'all';
        applyFilter();
        closePanel();
      });
    });

    // Card clicks → global inquiry drawer
    cards.forEach(function(card) {
      card.addEventListener('click', function(e) {
        e.preventDefault();
        var href = card.getAttribute('href') || '';
        var match = href.match(/[?&]id=([^&]+)/);
        var pieceId = match ? decodeURIComponent(match[1]) : '';
        var h3 = card.querySelector('h3');
        var title = h3 ? h3.textContent.trim() : '';
        if (window.openInquiryDrawer) {
          window.openInquiryDrawer({ title: title, sku: pieceId, intent: 'collection piece' });
        }
      });
    });
  }

  // Fetch and render
  var grid = document.getElementById('vgGrid');
  fetch('/archive-data.json')
    .then(function(r) { return r.json(); })
    .then(function(data) {
      var frag = document.createDocumentFragment();
      var rendered = [];
      var idx = 0;
      Object.keys(data).forEach(function(id) {
        var entry = data[id];
        if (!entry.gifUrl) return;
        var card = buildCard(id, entry, idx++);
        frag.appendChild(card);
        rendered.push(card);
      });
      var loading = grid.querySelector('.archive-loading');
      if (loading) loading.remove();
      grid.appendChild(frag);
      initGrid(rendered);
    })
    .catch(function(err) {
      var loading = grid && grid.querySelector('.archive-loading');
      if (loading) loading.textContent = 'Unable to load collection. Please refresh.';
      console.error('Archive fetch error:', err);
    });
})();
</script>
