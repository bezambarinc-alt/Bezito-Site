<script>
  // ---- Hero stack scroll animation ----
  (function () {
    var stack = document.getElementById('hero-stack');
    var heroes = document.querySelectorAll('.hero-pin .hero');
    var dotsNav = document.getElementById('hero-dots-nav');
    var dots = dotsNav ? dotsNav.querySelectorAll('.hero-dots__dot') : [];
    if (!stack || !heroes.length) return;

    var vid0 = document.getElementById('hero-vid-0') as HTMLVideoElement | null;
    var vid1 = document.getElementById('hero-vid-1') as HTMLVideoElement | null;
    var prevActiveI = 0;
    var stackInView = false;

    function playActive(i: number) {
      if (!stackInView) return;
      if (i === 0) {
        vid1?.pause();
        vid0?.play().catch(function(){});
      } else {
        vid0?.pause();
        if (vid1 && vid1.readyState === 0) vid1.load();
        vid1?.play().catch(function(){});
      }
    }

    // Only play when hero stack is on screen.
    // Also kick off vid1 buffering immediately so it's ready before the user scrolls to it.
    new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        stackInView = e.isIntersecting;
        if (stackInView) {
          playActive(prevActiveI);
          // Pre-buffer slide-2 video in the background while slide-1 plays
          if (vid1 && vid1.readyState === 0) vid1.load();
        } else {
          vid0?.pause();
          vid1?.pause();
        }
      });
    }, { threshold: 0.1 }).observe(stack);

    var ticking = false;
    function update() {
      ticking = false;
      var rect = stack!.getBoundingClientRect();
      var vh = window.innerHeight;
      var progress = Math.max(0, Math.min(1, (-rect.top) / (rect.height - vh)));
      (heroes[1] as HTMLElement).style.transform = 'translateY(' + ((1 - progress) * 100) + '%)';
      var activeI = progress < 0.5 ? 0 : 1;
      dots.forEach(function (d, idx) { d.classList.toggle('is-active', idx === activeI); });
      if (activeI !== prevActiveI) {
        prevActiveI = activeI;
        playActive(activeI);
      }
    }
    function onScroll() {
      if (!ticking) { requestAnimationFrame(update); ticking = true; }
    }
    var resizeTimer: ReturnType<typeof setTimeout>;
    function onResize() { clearTimeout(resizeTimer); resizeTimer = setTimeout(onScroll, 120); }
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onResize);
    requestAnimationFrame(update);

    dots.forEach(function (d) {
      d.addEventListener('click', function () {
        var i = +(d as HTMLElement).dataset.i!;
        var r = stack!.getBoundingClientRect();
        var stackTopAbs = window.scrollY + r.top;
        var scrollable = stack!.offsetHeight - window.innerHeight;
        window.scrollTo({ top: stackTopAbs + scrollable * i, behavior: 'smooth' });
      });
    });

    // Hide dots past the stack
    var sentinel = document.createElement('div');
    sentinel.style.cssText = 'position:absolute;bottom:0;height:1px;width:100%;';
    stack.appendChild(sentinel);
    new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (dotsNav) dotsNav.classList.toggle('is-visible', e.boundingClientRect.top > 0);
      });
    }, { threshold: 0 }).observe(sentinel);
  })();

  // ---- Cinematic stack scroll animation ----
  (function () {
    var stack = document.getElementById('cinematic-stack');
    if (!stack) return;
    var panes = stack.querySelectorAll('.cinematic');
    if (panes.length < 2) return;
    var dotsNav = document.getElementById('cinematic-dots');
    var dots = dotsNav ? dotsNav.querySelectorAll('.hero-dots__dot') : [];

    var cvid0 = document.getElementById('cine-vid-0') as HTMLVideoElement | null;
    var cvid1 = document.getElementById('cine-vid-1') as HTMLVideoElement | null;
    var prevActiveI = 0;
    var stackInView = false;

    function playActive(i: number) {
      if (!stackInView) return;
      if (i === 0) {
        cvid1?.pause();
        cvid0?.play().catch(function(){});
      } else {
        cvid0?.pause();
        if (cvid1 && cvid1.readyState === 0) cvid1.load();
        cvid1?.play().catch(function(){});
      }
    }

    // Only play when cinematic stack is on screen.
    // Pre-buffer BOTH cinematic videos as soon as the section enters the viewport.
    new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        stackInView = e.isIntersecting;
        if (stackInView) {
          if (cvid0 && cvid0.readyState === 0) cvid0.load();
          if (cvid1 && cvid1.readyState === 0) cvid1.load();
          playActive(prevActiveI);
        } else {
          cvid0?.pause();
          cvid1?.pause();
        }
      });
    }, { threshold: 0.1 }).observe(stack);

    var ticking = false;
    function update() {
      ticking = false;
      var rect = stack!.getBoundingClientRect();
      var vh = window.innerHeight;
      var progress = Math.max(0, Math.min(1, (-rect.top) / (rect.height - vh)));
      (panes[1] as HTMLElement).style.transform = 'translateY(' + ((1 - progress) * 100) + '%)';
      var activeI = progress < 0.5 ? 0 : 1;
      dots.forEach(function (d, idx) { d.classList.toggle('is-active', idx === activeI); });
      if (activeI !== prevActiveI) {
        prevActiveI = activeI;
        playActive(activeI);
      }
    }
    function onScroll() {
      if (!ticking) { requestAnimationFrame(update); ticking = true; }
    }
    var resizeTimer2: ReturnType<typeof setTimeout>;
    function onResize2() { clearTimeout(resizeTimer2); resizeTimer2 = setTimeout(onScroll, 120); }
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onResize2);
    requestAnimationFrame(update);

    dots.forEach(function (d) {
      d.addEventListener('click', function () {
        var i = +(d as HTMLElement).dataset.i!;
        var r = stack!.getBoundingClientRect();
        var stackTopAbs = window.scrollY + r.top;
        var scrollable = stack!.offsetHeight - window.innerHeight;
        window.scrollTo({ top: stackTopAbs + scrollable * i, behavior: 'smooth' });
      });
    });

    if (dotsNav) {
      new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          dotsNav!.classList.toggle('is-visible', e.isIntersecting);
        });
      }, { threshold: 0.05 }).observe(stack);
    }
  })();
</script>

