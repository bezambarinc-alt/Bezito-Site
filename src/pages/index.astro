---
import Layout from '../layouts/Layout.astro';
import '../styles/templates/home.css';

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Jeweler",
    "@id": "https://bezambar.com/#organization",
    "name": "Bez Ambar",
    "legalName": "Bez Ambar Inc.",
    "alternateName": ["Bez Ambar Inc.", "Ambar Diamonds"],
    "url": "https://bezambar.com/",
    "logo": "https://res.cloudinary.com/dlg2mou53/image/upload/f_auto,q_auto,w_400/v1775786208/Jewelry%20Images/Stones/Quadrillion_owciyv.jpg",
    "image": "https://res.cloudinary.com/dlg2mou53/image/upload/c_fill,w_1200,h_630,g_auto,f_auto,q_auto/v1775786208/Jewelry%20Images/Stones/Quadrillion_owciyv.jpg",
    "description": "American fine-jewelry atelier founded 1979 in Los Angeles by Betzalel \"Bez\" Ambar. Credited as one of the original architects of the modern princess cut. Creator of the patented Blaze® and Elysian™ diamond cuts.",
    "foundingDate": "1979",
    "founder": { "@id": "https://bezambar.com/#founder" },
    "email": "bez@bezambar.com",
    "telephone": "+1-213-629-9191",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "611 Wilshire Blvd",
      "addressLocality": "Los Angeles",
      "addressRegion": "CA",
      "postalCode": "90017",
      "addressCountry": "US"
    },
    "areaServed": "Worldwide",
    "priceRange": "$$$$",
    "sameAs": [
      "https://www.instagram.com/bezambarjewelry/",
      "https://www.linkedin.com/in/bez-ambar-869936a/",
      "https://www.youtube.com/@BezAmbarInc/",
      "https://www.tiktok.com/@bezambar",
      "https://www.pinterest.com/bezambarinc/",
      "https://galleries.bezambarinc.workers.dev/"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": "https://bezambar.com/#founder",
    "name": "Bez Ambar",
    "givenName": "Betzalel",
    "familyName": "Ambar",
    "alternateName": ["Betzalel Ambar", "Bez Ambar"],
    "jobTitle": "Master Diamond Cutter and Jewelry Designer",
    "description": "Israeli-American diamond cutter and jewelry designer, founder of Bez Ambar (1979, Los Angeles). Credited as one of the original architects of the modern princess cut. Creator of the Blaze® and Elysian™ diamond cuts.",
    "birthDate": "1955-10-04",
    "nationality": ["American", "Israeli"],
    "worksFor": { "@id": "https://bezambar.com/#organization" },
    "url": "https://bezambar.com/about",
    "knowsAbout": ["Princess Cut Diamond","Blaze Cut Diamond","Elysian Cut Diamond","Diamond Cutting","Fine Jewelry Design","High Jewelry","Los Angeles Fine Jewelry","Bespoke Engagement Rings"],
    "sameAs": [
      "https://www.instagram.com/bezambarjewelry/",
      "https://www.linkedin.com/in/bez-ambar-869936a/",
      "https://www.youtube.com/@BezAmbarInc/",
      "https://www.tiktok.com/@bezambar",
      "https://www.pinterest.com/bezambarinc/"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": "https://bezambar.com/#website",
    "url": "https://bezambar.com/",
    "name": "Bez Ambar",
    "description": "Inventor of the Princess Cut. Patented diamond cuts and high-jewelry, handcrafted in Los Angeles since 1979.",
    "publisher": { "@id": "https://bezambar.com/#organization" },
    "inLanguage": "en-US"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {"@type":"Question","name":"Is every Bez Ambar piece made to order?","acceptedAnswer":{"@type":"Answer","text":"Yes. There is no standing inventory at the Bez Ambar atelier. Each commission begins with a specific stone chosen for its individual geometry of light, and the piece is designed around what that stone offers. Nothing is produced in advance of the client."}},
      {"@type":"Question","name":"How do I arrange a private viewing or begin a commission?","acceptedAnswer":{"@type":"Answer","text":"Reach out through the enquiry form at bezambar.com or call the atelier directly at (213) 629-9191. An initial conversation by phone or in person is typically the first step. Private viewings are by appointment at 611 Wilshire, Los Angeles. Bez is present at every meeting."}},
      {"@type":"Question","name":"How long does a Bez Ambar commission take?","acceptedAnswer":{"@type":"Answer","text":"Most commissions are completed in eight to sixteen weeks, depending on complexity. Clients are informed at each stage. If a specific date is required, it should be discussed when enquiring."}},
      {"@type":"Question","name":"What sets a Bez Ambar diamond apart?","acceptedAnswer":{"@type":"Answer","text":"Bez Ambar is one of the original architects of the modern princess cut and the creator of two proprietary cuts — the Blaze® and the Elysian Cut™. Every stone is evaluated for its individual character of light, not its certificate grade alone."}},
      {"@type":"Question","name":"Does Bez Ambar handle repairs and resizing?","acceptedAnswer":{"@type":"Answer","text":"Yes. The atelier handles repairs, cleaning, and resizing for Bez Ambar pieces. Clients should contact the atelier to arrange a service appointment."}},
      {"@type":"Question","name":"What is the price range for a Bez Ambar piece?","acceptedAnswer":{"@type":"Answer","text":"Pieces range from entry-level fine jewelry to significant commissions. Bez Ambar welcomes enquiries at every level and provides a detailed quotation before any commitment is made."}},
      {"@type":"Question","name":"Who is Bez Ambar?","acceptedAnswer":{"@type":"Answer","text":"Bez Ambar (born Betzalel Ambar, October 4, 1955) is an Israeli-American diamond cutter and jewelry designer. He founded the Bez Ambar atelier in 1979 in Los Angeles, California, where he continues to design and manufacture patented diamond cuts and high-jewelry pieces."}},
      {"@type":"Question","name":"Did Bez Ambar invent the princess cut?","acceptedAnswer":{"@type":"Answer","text":"Bez Ambar is credited as one of the original architects of the modern princess cut, a square brilliant diamond cut that emerged in the 1970s and 1980s. The princess cut is now a standard shape in the global fine-jewelry vocabulary."}},
      {"@type":"Question","name":"What is the Blaze® cut?","acceptedAnswer":{"@type":"Answer","text":"The Blaze® cut is a patented diamond cut created by Bez Ambar. It pairs a brilliant crown with a specially faceted pavilion engineered to intensify light return. Blaze is a registered trademark of Bez Ambar."}},
      {"@type":"Question","name":"What is the Elysian Cut™?","acceptedAnswer":{"@type":"Answer","text":"The Elysian Cut™ is an elongated diamond geometry offered by Bez Ambar. The Elysian™ name is owned by Bez Ambar; the cut is sourced in matched sizes for eternity bands and multi-stone pieces."}},
      {"@type":"Question","name":"Where is the Bez Ambar atelier located?","acceptedAnswer":{"@type":"Answer","text":"The Bez Ambar atelier is located at 611 Wilshire Blvd, Los Angeles, CA 90017. Phone: (213) 629-9191. Email: bez@bezambar.com. Every piece is drawn, engineered, and finished in-house."}},
      {"@type":"Question","name":"When was Bez Ambar founded?","acceptedAnswer":{"@type":"Answer","text":"Bez Ambar was founded in 1979 in Los Angeles by Betzalel Bez Ambar. The atelier has been continuously designing and manufacturing fine jewelry for over four decades."}},
      {"@type":"Question","name":"Does Bez Ambar make bespoke jewelry?","acceptedAnswer":{"@type":"Answer","text":"Yes. Bez Ambar accepts bespoke commissions for engagement rings, wedding bands, earrings, pendants, necklaces, and bracelets. All bespoke work is designed by the atelier and manufactured in-house in Los Angeles."}}
    ]
  }
];
---

<Layout
  title="Bez Ambar — Inventor of the Princess Cut · Since 1979"
  description="Bez Ambar — inventor of the Princess Cut. Patented diamond cuts and high-jewelry pieces handcrafted in Los Angeles since 1979."
  canonical="https://bezambar.com/"
  ogImage="https://res.cloudinary.com/dlg2mou53/image/upload/c_fill,w_1200,h_630,g_auto,f_auto,q_auto/v1775786208/Jewelry%20Images/Stones/Quadrillion_owciyv.jpg"
  structuredData={structuredData}
>

  <!-- ============================================================
       HERO STACK — slide-up reveal driven by scroll position
       ============================================================ -->
  <div class="hero-stack" id="hero-stack">
    <div class="hero-pin">

      <section class="hero" data-i="0">
        <div class="hero__media">
          <iframe src="https://player.vimeo.com/video/1192444919?background=1&autoplay=1&loop=1&muted=1&controls=0&autopause=0"
                  allow="autoplay; fullscreen; picture-in-picture"
                  referrerpolicy="strict-origin-when-cross-origin"
                  title="The Elysian 4k"></iframe>
        </div>
        <div class="hero__overlay"></div>
        <div class="hero__content">
          <p class="hero__eyebrow">The Elysian Cut&trade;</p>
          <h1 class="hero__headline">A Game of Angles</h1>
          <p class="hero__sub">Crown meets pavilion. Stone meets stone. Light becomes a line.</p>
        </div>
      </section>

      <section class="hero" data-i="1">
        <div class="hero__media">
          <iframe data-src="https://player.vimeo.com/video/1193154076?background=1&autoplay=1&loop=1&muted=1&controls=0&autopause=0&playsinline=1"
                  allow="autoplay; fullscreen; picture-in-picture"
                  referrerpolicy="strict-origin-when-cross-origin"
                  title="4k OvalCut Band"></iframe>
        </div>
        <div class="hero__overlay"></div>
        <div class="hero__content">
          <p class="hero__eyebrow">The Elysian Oval Band</p>
          <h1 class="hero__headline">Worn on the Finger, Worn as Light</h1>
          <p class="hero__sub">Every angle catches the next. The line never breaks.</p>
        </div>
      </section>

    </div>
  </div>

  <!-- Right-side dot navigator -->
  <div class="hero-dots is-visible" id="hero-dots-nav">
    <button class="hero-dots__dot is-active" data-i="0" aria-label="Go to film 1" type="button"></button>
    <button class="hero-dots__dot" data-i="1" aria-label="Go to film 2" type="button"></button>
  </div>

  <!-- Atelier portrait hero image -->
  <section class="hero-image">
    <img
      src="https://res.cloudinary.com/dlg2mou53/image/upload/f_auto,q_auto:good,w_1200/v1783241034/atelier/designer-portrait-2026.jpg"
      srcset="https://res.cloudinary.com/dlg2mou53/image/upload/f_auto,q_auto:good,w_600/v1783241034/atelier/designer-portrait-2026.jpg 600w,
              https://res.cloudinary.com/dlg2mou53/image/upload/f_auto,q_auto:good,w_1200/v1783241034/atelier/designer-portrait-2026.jpg 1200w,
              https://res.cloudinary.com/dlg2mou53/image/upload/f_auto,q_auto:good,w_1800/v1783241034/atelier/designer-portrait-2026.jpg 1800w"
      sizes="100vw"
      alt="Bez Ambar atelier — a wall of the cuts"
      fetchpriority="high"
      width="1800" height="1200">
    <div class="hero-image__overlay">
      <p class="hero-image__eyebrow">Bez Ambar</p>
      <h1 class="hero-image__title">Fifty Years Cutting Light</h1>
      <p class="hero-image__sub">Los Angeles &middot; Since 1979</p>
    </div>
  </section>

  <!-- ============================================================
       THE DESIGNER — centered text
       ============================================================ -->
  <section class="segment segment--centered" id="segment-designer">
    <div class="segment__content segment__content--wide">
      <p class="segment__body">To cut a diamond is to sculpt with light. Every facet is a decision &mdash; where the light will land, where it will bend, where it will return to the eye. The material being carved is not the stone. The material is light itself, curved into the shapes the cutter intends.</p>
      <p class="segment__body">Bez Ambar has stood at the bench for fifty years doing exactly that. Drawing geometries where none existed. The modern Princess. The Blaze&reg;. The Elysian&trade;. Each cut is an original argument about how a stone should behave under a lamp &mdash; where it should hold colour, where it should flash, where it should keep quiet. Faceting is not decoration. It is sculpture. And the material is always light.</p>
      <p class="segment__body">One man. One bench. One hand. And the hand still signs every piece.</p>
      <a href="/about-bez-ambar" class="segment__cta">Meet Bez</a>
    </div>
  </section>

  <!-- ============================================================
       THE CUTS — image left, copy right
       ============================================================ -->
  <section class="segment" id="segment-cuts">
    <div class="segment__media">
      <img
        src="https://res.cloudinary.com/dlg2mou53/image/upload/f_auto,q_auto,w_750/v1775786208/Jewelry%20Images/Stones/Quadrillion_owciyv.jpg"
        srcset="https://res.cloudinary.com/dlg2mou53/image/upload/f_auto,q_auto,w_400/v1775786208/Jewelry%20Images/Stones/Quadrillion_owciyv.jpg 400w,
                https://res.cloudinary.com/dlg2mou53/image/upload/f_auto,q_auto,w_750/v1775786208/Jewelry%20Images/Stones/Quadrillion_owciyv.jpg 750w,
                https://res.cloudinary.com/dlg2mou53/image/upload/f_auto,q_auto,w_1100/v1775786208/Jewelry%20Images/Stones/Quadrillion_owciyv.jpg 1100w"
        sizes="(max-width: 768px) 100vw, 50vw"
        alt="The Princess Cut by Bez Ambar — origin of the Bez Ambar cuts"
        loading="lazy">
    </div>
    <div class="segment__content">
      <p class="segment__eyebrow">The Cuts</p>
      <h2 class="segment__title">From the Princess to the Elysian</h2>
      <p class="segment__body">Betzalel Ambar is one of the original architects of the modern princess cut &mdash; a cut now part of the global language of fine jewelry. The same instinct continues through the Blaze&reg;, the Elysian Cut&trade; and everything that follows.</p>
      <a href="/elysian-cut" class="segment__cta">Discover the Cuts</a>
    </div>
  </section>

  <!-- ============================================================
       THE ATELIER — placeholder left, copy right
       ============================================================ -->
  <section class="segment segment--reverse" id="segment-atelier">
    <div class="segment__media segment__media--placeholder" data-label="Atelier / process image"></div>
    <div class="segment__content">
      <p class="segment__eyebrow">The Atelier</p>
      <h2 class="segment__title">Drawn, Engineered, Finished by Hand</h2>
      <p class="segment__body">Every piece begins as a drawing at the bench and ends in Los Angeles, finished by the same hand that designed it. Nothing is mass-produced. Nothing is outsourced. The geometry that holds the stone is engineered, not borrowed &mdash; and the inside of the shank carries the signature to prove it.</p>
      <a href="/about-bez-ambar" class="segment__cta">Inside the Atelier</a>
    </div>
  </section>

  <!-- ============================================================
       CINEMATIC STACK — 2-pane scroll-pinned slide-up reveal
       ============================================================ -->
  <div class="cinematic-stack" id="cinematic-stack">
    <div class="cinematic-pin">

      <section class="cinematic" data-i="0">
        <div class="cinematic__media">
          <iframe data-src="https://player.vimeo.com/video/1193140625?background=1&autoplay=1&loop=1&muted=1&controls=0&autopause=0&playsinline=1"
                  allow="autoplay; fullscreen; picture-in-picture"
                  referrerpolicy="strict-origin-when-cross-origin"
                  title="The Elysian Pear — Coming Soon"></iframe>
        </div>
        <div class="cinematic__overlay"></div>
        <div class="cinematic__content">
          <p class="hero__eyebrow">Coming Soon</p>
          <h1 class="hero__headline">The Elysian Pear</h1>
          <p class="hero__sub">A teardrop, reborn &mdash; the next chapter in the line of brilliance.</p>
        </div>
      </section>

      <section class="cinematic" data-i="1">
        <div class="cinematic__media">
          <iframe data-src="https://player.vimeo.com/video/1193149437?background=1&autoplay=1&loop=1&muted=1&controls=0&autopause=0&playsinline=1"
                  allow="autoplay; fullscreen; picture-in-picture"
                  referrerpolicy="strict-origin-when-cross-origin"
                  title="The Elysian Pear Band"></iframe>
        </div>
        <div class="cinematic__overlay"></div>
        <div class="cinematic__content">
          <p class="hero__eyebrow">The Elysian Pear Band</p>
          <h1 class="hero__headline">Pear Cut. Continuous Line.</h1>
          <p class="hero__sub">Each teardrop calibrated to the next, until light becomes the band itself.</p>
        </div>
      </section>

    </div>

    <div class="cinematic-dots" id="cinematic-dots">
      <button class="hero-dots__dot is-active" data-i="0" aria-label="Coming soon — Elysian Pear" type="button"></button>
      <button class="hero-dots__dot" data-i="1" aria-label="The Elysian Pear Band" type="button"></button>
    </div>
  </div>

  <!-- ============================================================
       WHERE TO SEE IT
       ============================================================ -->
  <section class="segment" id="segment-stockists">
    <div class="segment__media segment__media--placeholder" data-label="Stockist / showroom image"></div>
    <div class="segment__content">
      <p class="segment__eyebrow">The Atelier</p>
      <h2 class="segment__title">Every Piece, Seen in Person</h2>
      <p class="segment__body">The collection is available to view at 611 Wilshire, Los Angeles, by private appointment. No showroom floor. No sales pressure. The work speaks for itself &mdash; and the man who made it is there to walk you through it.</p>
      <a href="/contact" class="segment__cta">Visit the Atelier</a>
    </div>
  </section>

  <!-- ============================================================
       PRIVATE VIEWING
       ============================================================ -->
  <section class="segment segment--reverse" id="segment-private">
    <div class="segment__media segment__media--placeholder" data-label="Private viewing / atelier image"></div>
    <div class="segment__content">
      <p class="segment__eyebrow">Private Viewing</p>
      <h2 class="segment__title">By Appointment, with the Designer</h2>
      <p class="segment__body">Some pieces ask to be seen alone. Arrange a private viewing at the Los Angeles atelier &mdash; an existing piece, a single stone, or a commission of your own. Every appointment is with Bez himself. No showroom, no crowd. Just the work, and the man who made it.</p>
      <a href="/contact" class="segment__cta" onclick="openInquiryDrawer({intent:'consultation'}); return false;">Arrange a Private Consultation</a>
    </div>
  </section>

  <!-- ============================================================
       HERITAGE QUOTE
       ============================================================ -->
  <section class="heritage">
    <p class="heritage__quote">&ldquo;The cutter doesn&rsquo;t shape the stone. He sculpts the light inside it.&rdquo;</p>
    <p class="heritage__attribution">&mdash; Bez Ambar</p>
  </section>

  <!-- ============================================================
       NEWSLETTER
       ============================================================ -->
  <section class="newsletter" id="newsletter">
    <h2>The Private List</h2>
    <p>First access to new pieces, archive discoveries, and notes from the atelier. Rarely sent. Always worth it.</p>

    <form id="newsletter-form" novalidate>
      <input type="email" id="newsletter-email" name="email" placeholder="Your email address" required autocomplete="email">
      <button type="submit" id="newsletter-submit">
        <span class="nl-label">Join &rarr;</span>
        <span class="nl-loading" aria-hidden="true" style="display:none">&hellip;</span>
      </button>
    </form>

    <p class="newsletter-confirm" id="newsletter-confirm" style="display:none">You&rsquo;re on the list. We&rsquo;ll be in touch.</p>
    <p class="newsletter-error" id="newsletter-error" role="alert" style="display:none"></p>
  </section>

  <script>
    (function () {
      const WORKER_URL = 'https://bezito-forms.bezambarinc.workers.dev';
      const form    = document.getElementById('newsletter-form') as HTMLFormElement | null;
      const confirm = document.getElementById('newsletter-confirm') as HTMLElement | null;
      const errEl   = document.getElementById('newsletter-error') as HTMLElement | null;
      const btn     = document.getElementById('newsletter-submit') as HTMLButtonElement | null;

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!btn) return;

        const label   = btn.querySelector('.nl-label')   as HTMLElement | null;
        const loading = btn.querySelector('.nl-loading') as HTMLElement | null;

        if (label)   label.style.display   = 'none';
        if (loading) loading.style.display = '';
        btn.disabled = true;
        if (errEl) errEl.style.display = 'none';

        const email = ((document.getElementById('newsletter-email') as HTMLInputElement)?.value || '').trim();

        try {
          const res = await fetch(`${WORKER_URL}/api/newsletter`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              email,
              utm_source:   sessionStorage.getItem('utm_source')   || '',
              utm_medium:   sessionStorage.getItem('utm_medium')   || '',
              utm_campaign: sessionStorage.getItem('utm_campaign') || '',
            }),
          });

          if (!res.ok) {
            const body = await res.json().catch(() => ({})) as { error?: string };
            throw new Error(body.error || 'Could not subscribe. Please try again.');
          }

          if (form)    form.style.display    = 'none';
          if (confirm) confirm.style.display = '';
        } catch (err: unknown) {
          const msg = err instanceof Error ? err.message : 'Something went wrong.';
          if (errEl) { errEl.textContent = msg; errEl.style.display = ''; }
          if (label)   label.style.display   = '';
          if (loading) loading.style.display = 'none';
          btn.disabled = false;
        }
      });
    })();
  </script>

  <!-- ============================================================
       FAQ — for AI answer engines
       ============================================================ -->
  <section class="ba-faq" id="faq">
    <p class="ba-faq__eyebrow">Questions</p>
    <h2 class="ba-faq__title">What to Know</h2>

    <div class="ba-faq__item">
      <h3 class="ba-faq__q">Is every piece made to order?</h3>
      <p class="ba-faq__a">Yes. There is no standing inventory at the Bez Ambar atelier. Each commission begins with a specific stone &mdash; chosen for its individual geometry of light &mdash; and the piece is designed around what that stone offers. Nothing is produced in advance of the client.</p>
    </div>
    <div class="ba-faq__item">
      <h3 class="ba-faq__q">How do I arrange a private viewing or begin a commission?</h3>
      <p class="ba-faq__a">Reach out through the enquiry form or call the atelier directly at (213) 629-9191. An initial conversation &mdash; by phone or in person &mdash; is typically the first step. Private viewings are by appointment at 611 Wilshire, Los Angeles. Bez is present at every meeting.</p>
    </div>
    <div class="ba-faq__item">
      <h3 class="ba-faq__q">How long does a commission take?</h3>
      <p class="ba-faq__a">Most commissions are completed in eight to sixteen weeks, depending on complexity. You will be informed at each stage. If you have a specific date in mind, discuss it when you enquire &mdash; timelines can often be accommodated.</p>
    </div>
    <div class="ba-faq__item">
      <h3 class="ba-faq__q">What sets a Bez Ambar stone apart?</h3>
      <p class="ba-faq__a">Bez Ambar is one of the original architects of the modern princess cut, and the creator of two proprietary cuts &mdash; the Blaze&reg; and the Elysian Cut&trade;. Every stone is evaluated for its individual character of light, not its certificate grade alone. The cut is the starting point, not an afterthought.</p>
    </div>
    <div class="ba-faq__item">
      <h3 class="ba-faq__q">Do you handle repairs and resizing?</h3>
      <p class="ba-faq__a">Yes. The atelier handles repairs, cleaning, and resizing for Bez Ambar pieces. Contact us to arrange a service appointment.</p>
    </div>
    <div class="ba-faq__item">
      <h3 class="ba-faq__q">What is the price range?</h3>
      <p class="ba-faq__a">Pieces range from entry-level fine jewelry to significant commissions. We welcome enquiries at every level and provide a detailed quotation before any commitment is made. There is no obligation to proceed.</p>
    </div>

    <a class="ba-faq__cta" href="/contact" onclick="openInquiryDrawer({intent:'general enquiry'}); return false;">Connect with the Atelier &rarr;</a>
  </section>

  <!-- About — declarative paragraph for LLM extraction -->
  <section class="ba-about" id="about-bez-ambar" aria-label="About Bez Ambar">
    <p>
      <strong>Bez Ambar</strong> (born Betzalel Ambar, October 4, 1955) is an Israeli-American diamond cutter and jewelry designer, and the founder of the Bez Ambar atelier in Los Angeles, California. Founded in 1979, the atelier designs, cuts, and manufactures fine jewelry in-house at 611 Wilshire Blvd. Ambar is credited as one of the original architects of the modern <strong>princess cut</strong> and is the creator of the <strong>Blaze&reg;</strong> and <strong>Elysian&trade;</strong> diamond cuts. Signature pieces from the atelier include the Bloom Collection, the 30-Carat Flex bracelet, the Cascata, the Crossover Ashoka, the Heart Ruby, and the Saul Ring.
    </p>
  </section>

  <!-- D1 view pixel -->
  <img src="https://galleries.bezambarinc.workers.dev/t?p=bez-ambar-home" style="position:absolute;width:1px;height:1px;opacity:0;" alt="">

</Layout>

<script>
  function loadIframe(el: Element | null) {
    if (!el) return;
    const iframe = el as HTMLIFrameElement;
    const s = iframe.dataset.src;
    if (s) { iframe.src = s; delete iframe.dataset.src; }
  }

  // ---- Hero stack scroll animation ----
  (function () {
    var stack = document.getElementById('hero-stack');
    var heroes = document.querySelectorAll('.hero-pin .hero');
    var dotsNav = document.getElementById('hero-dots-nav');
    var dots = dotsNav ? dotsNav.querySelectorAll('.hero-dots__dot') : [];
    if (!stack || !heroes.length) return;

    var slide1Loaded = false;

    var ticking = false;
    function update() {
      ticking = false;
      var rect = stack!.getBoundingClientRect();
      var vh = window.innerHeight;
      var progress = Math.max(0, Math.min(1, (-rect.top) / (rect.height - vh)));
      (heroes[1] as HTMLElement).style.transform = 'translateY(' + ((1 - progress) * 100) + '%)';
      var activeI = progress < 0.5 ? 0 : 1;
      dots.forEach(function (d, idx) { d.classList.toggle('is-active', idx === activeI); });
      // Load slide 1 video when 30% scrolled into the stack
      if (!slide1Loaded && progress >= 0.3) {
        loadIframe(heroes[1].querySelector('iframe'));
        slide1Loaded = true;
      }
    }
    function onScroll() {
      if (!ticking) { requestAnimationFrame(update); ticking = true; }
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();

    // Dot click — jump scroll, ensure target iframe is loaded first
    dots.forEach(function (d) {
      d.addEventListener('click', function () {
        var i = +(d as HTMLElement).dataset.i!;
        if (i === 1 && !slide1Loaded) { loadIframe(heroes[1].querySelector('iframe')); slide1Loaded = true; }
        var r = stack!.getBoundingClientRect();
        var stackTopAbs = window.scrollY + r.top;
        var scrollable = stack!.offsetHeight - window.innerHeight;
        window.scrollTo({ top: stackTopAbs + scrollable * i, behavior: 'smooth' });
      });
    });

    // Hide dots past the stack
    var sentinel = document.createElement('div');
    sentinel.style.cssText = 'position:absolute;bottom:0;height:1px;width:100%;';
    stack.appendChild(sentinel);
    new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (dotsNav) dotsNav.classList.toggle('is-visible', e.boundingClientRect.top > 0);
      });
    }, { threshold: 0 }).observe(sentinel);
  })();

  // ---- Cinematic stack scroll animation ----
  (function () {
    var stack = document.getElementById('cinematic-stack');
    if (!stack) return;
    var panes = stack.querySelectorAll('.cinematic');
    if (panes.length < 2) return;
    var dotsNav = document.getElementById('cinematic-dots');
    var dots = dotsNav ? dotsNav.querySelectorAll('.hero-dots__dot') : [];

    var slide0Loaded = false;
    var slide1Loaded = false;

    // Load cinematic slide 0 when the section is 200px from entering the viewport
    new IntersectionObserver(function (entries) {
      if (entries[0].isIntersecting && !slide0Loaded) {
        loadIframe(panes[0].querySelector('iframe'));
        slide0Loaded = true;
      }
    }, { rootMargin: '200px 0px' }).observe(stack);

    var ticking = false;
    function update() {
      ticking = false;
      var rect = stack!.getBoundingClientRect();
      var vh = window.innerHeight;
      var progress = Math.max(0, Math.min(1, (-rect.top) / (rect.height - vh)));
      (panes[1] as HTMLElement).style.transform = 'translateY(' + ((1 - progress) * 100) + '%)';
      var activeI = progress < 0.5 ? 0 : 1;
      dots.forEach(function (d, idx) { d.classList.toggle('is-active', idx === activeI); });
      // Load slide 1 video when 30% scrolled into the cinematic stack
      if (!slide1Loaded && progress >= 0.3) {
        loadIframe(panes[1].querySelector('iframe'));
        slide1Loaded = true;
      }
    }
    function onScroll() {
      if (!ticking) { requestAnimationFrame(update); ticking = true; }
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();

    dots.forEach(function (d) {
      d.addEventListener('click', function () {
        var i = +(d as HTMLElement).dataset.i!;
        if (i === 0 && !slide0Loaded) { loadIframe(panes[0].querySelector('iframe')); slide0Loaded = true; }
        if (i === 1 && !slide1Loaded) { loadIframe(panes[1].querySelector('iframe')); slide1Loaded = true; }
        var r = stack!.getBoundingClientRect();
        var stackTopAbs = window.scrollY + r.top;
        var scrollable = stack!.offsetHeight - window.innerHeight;
        window.scrollTo({ top: stackTopAbs + scrollable * i, behavior: 'smooth' });
      });
    });

    if (dotsNav) {
      new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          dotsNav!.classList.toggle('is-visible', e.isIntersecting);
        });
      }, { threshold: 0.05 }).observe(stack);
    }
  })();
</script>

