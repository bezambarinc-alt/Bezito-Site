---
// Nav.astro
const currentPath = Astro.url.pathname;
---

<div class="menu-backdrop" id="menuBackdrop" onclick="toggleMenu()"></div>

<nav class="menu-overlay" id="menuOverlay" aria-hidden="true" aria-label="Site navigation">
  <button class="menu-overlay__close" onclick="toggleMenu()" aria-label="Close menu">&times;</button>
  <a class="menu-overlay__logo" href="/">BEZ AMBAR</a>

  <ul class="menu-col menu-col--root" role="list">
    <li><button class="menu-item menu-item--has-sub" data-target="jewelry" type="button">Jewelry</button></li>
    <li><button class="menu-item menu-item--has-sub" data-target="atelier" type="button">Atelier</button></li>
    <li><a class="menu-item" href="/blog">Blog</a></li>
    <li><a class="menu-item" href="/archive">The Archive</a></li>
    <li><button class="menu-item menu-item--has-sub" data-target="service" type="button">Service</button></li>
    <li class="menu-cta-item">
      <a href="/contact?subject=consultation" class="menu-cta">Book a Consultation</a>
    </li>
  </ul>

  <!-- Jewelry: Named collections first, then category browse -->
  <ul class="menu-col menu-col--sub" data-col="jewelry">
    <li class="menu-back"><button onclick="resetMenuCols()" class="menu-back__btn">&#8592; Back</button></li>
    <li class="menu-section-label">Collections</li>
    <li><a class="menu-item menu-item--collection" href="/collection/bloom">Bloom Collection</a></li>
    <li><span class="menu-item menu-item--soon">Dentelle Collection</span></li>
    <li class="menu-divider"></li>
    <li class="menu-section-label">Browse</li>
    <li><a class="menu-item" href="/jewelry/rings">Rings</a></li>
    <li><a class="menu-item" href="/jewelry/engagement-rings">Engagement Rings</a></li>
    <li><a class="menu-item" href="/jewelry/wedding-bands">Wedding Bands</a></li>
    <li><a class="menu-item" href="/jewelry/bracelets">Bracelets</a></li>
    <li><a class="menu-item" href="/jewelry/earrings">Earrings</a></li>
    <li><a class="menu-item" href="/jewelry/necklaces">Necklaces</a></li>
    <li><a class="menu-item" href="/jewelry/pendants">Pendants</a></li>
    <li class="menu-divider"></li>
    <li class="menu-section-label">Signature Pieces</li>
    <li><a class="menu-item" href="/jewelry/pendants/heart-ruby">The Heart Ruby</a></li>
    <li><a class="menu-item" href="/jewelry/bracelets/30-carat-flex">The 30-Carat Flex</a></li>
    <li><a class="menu-item" href="/jewelry/wedding-bands/elysian-band-50">Elysian Band</a></li>
    <li><span class="menu-item menu-item--soon">Cascata</span></li>
    <li><span class="menu-item menu-item--soon">Crossover Ashoka&reg;</span></li>
    <li class="menu-divider"></li>
    <li><a class="menu-item" href="/catalogs">View Catalogs</a></li>
  </ul>

  <!-- Atelier: brand story + resources -->
  <ul class="menu-col menu-col--sub" data-col="atelier">
    <li class="menu-back"><button onclick="resetMenuCols()" class="menu-back__btn">&#8592; Back</button></li>
    <li><a class="menu-item" href="/about-bez-ambar">About Bez Ambar</a></li>
    <li><a class="menu-item" href="/diamond-education">Diamond Education</a></li>
    <li><a class="menu-item" href="/elysian-cut">Elysian Cut&trade;</a></li>
    <li><a class="menu-item" href="/press">Press</a></li>
    <li><a class="menu-item" href="/journal">Journal</a></li>
    <li class="menu-divider"></li>
    <li class="menu-section-label">Resources</li>
    <li><a class="menu-item" href="/ring-size-chart">Ring Size Guide</a></li>
    <li><a class="menu-item" href="/catalogs">Catalogs</a></li>
  </ul>

  <!-- Service -->
  <ul class="menu-col menu-col--sub" data-col="service">
    <li class="menu-back"><button onclick="resetMenuCols()" class="menu-back__btn">&#8592; Back</button></li>
    <li><a class="menu-item" href="/contact">Contact Us</a></li>
    <li><a class="menu-item" href="/contact?subject=bespoke">Bespoke Design</a></li>
    <li><a class="menu-item" href="/contact?subject=repairs">Repairs &amp; Cleaning</a></li>
    <li><a class="menu-item" href="/contact?subject=resize">Ring Resizing</a></li>
    <li class="menu-divider"></li>
    <li><a class="menu-item" href="/warranty">Warranty &amp; Policies</a></li>
  </ul>
</nav>

<script>
  function toggleMenu(forceClose = false) {
    const overlay = document.getElementById('menuOverlay');
    const backdrop = document.getElementById('menuBackdrop');
    const isOpen = overlay.classList.contains('is-open');
    const shouldOpen = forceClose ? false : !isOpen;

    overlay.classList.toggle('is-open', shouldOpen);
    backdrop.classList.toggle('is-open', shouldOpen);
    document.body.classList.toggle('menu-open', shouldOpen);
    overlay.setAttribute('aria-hidden', String(!shouldOpen));

    if (!shouldOpen) resetMenuCols();
    if (shouldOpen) {
      const firstItem = overlay.querySelector('.menu-item');
      if (firstItem) firstItem.focus();
    }
  }

  function resetMenuCols() {
    document.querySelectorAll('.menu-col--sub').forEach(col => col.classList.remove('is-active'));
    document.querySelector('.menu-col--root')?.classList.remove('sub-open');
    document.getElementById('menuOverlay')?.classList.remove('has-sub');
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.menu-item--has-sub').forEach(btn => {
      btn.addEventListener('click', () => {
        const target = btn.dataset.target;
        resetMenuCols();
        const sub = document.querySelector(`.menu-col--sub[data-col="${target}"]`);
        if (sub) {
          sub.classList.add('is-active');
          document.querySelector('.menu-col--root')?.classList.add('sub-open');
          document.getElementById('menuOverlay')?.classList.add('has-sub');
        }
      });
    });

    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && document.getElementById('menuOverlay')?.classList.contains('is-open')) {
        toggleMenu(true);
      }
    });
  });

  window.toggleMenu = toggleMenu;
  window.resetMenuCols = resetMenuCols;
</script>
