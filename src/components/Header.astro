---
// Header.astro — transparent at top, solid on scroll (all pages)
---

<header class="ba-header" id="baHeader">
  <div class="ba-header__menu" id="menuToggle" onclick="toggleMenu()" role="button" tabindex="0" aria-label="Open menu">Menu</div>
  <a class="ba-header__logo" href="/">Bez Ambar</a>
  <div class="ba-header__right"><a href="/contact">Contact</a></div>
</header>

<style>
  .ba-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 2rem;
    height: 64px;
    transition: background 0.3s ease, box-shadow 0.3s ease, color 0.3s ease;
    color: #fff;
  }

  .ba-header.is-solid {
    background: #fff;
    box-shadow: 0 1px 0 rgba(0,0,0,.08);
    color: var(--ink, #1a1a1a);
  }

  .ba-header__menu {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    color: inherit;
  }

  .ba-header__logo {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 300;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    color: inherit;
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }

  .ba-header__right {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .ba-header__right a {
    color: inherit;
    text-decoration: none;
  }

  .ba-header__right a:hover {
    opacity: 0.6;
  }
</style>

<script>
  (function () {
    const header = document.getElementById('baHeader');
    if (!header) return;

    function update() {
      if (window.scrollY > 20) {
        header.classList.add('is-solid');
      } else {
        header.classList.remove('is-solid');
      }
    }

    window.addEventListener('scroll', update, { passive: true });
    update();
  })();
</script>
