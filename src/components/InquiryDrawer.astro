---
// InquiryDrawer.astro — slide-right inquiry panel, present on every page via Layout.
// Open from anywhere: window.openInquiryDrawer({ title?, sku?, intent? })
import SocialLinks from './SocialLinks.astro';
---

<div id="inquiry-drawer" class="ba-drawer" role="dialog" aria-modal="true" aria-labelledby="ba-drawer-heading" hidden>
  <div class="ba-drawer__backdrop" id="drawerBackdrop"></div>
  <div class="ba-drawer__panel">

    <button class="ba-drawer__close" id="drawerClose" aria-label="Close inquiry panel">&#x2715;</button>

    <div class="ba-drawer__context" id="drawerContext" hidden>
      <p class="ba-drawer__context-label">Inquiring about</p>
      <p class="ba-drawer__context-title" id="drawerContextTitle"></p>
    </div>

    <div class="ba-drawer__body">
      <h2 id="ba-drawer-heading" class="ba-drawer__heading">Connect with the Atelier</h2>
      <p class="ba-drawer__subhead">We respond personally within one business day.</p>

      <form id="drawer-form" novalidate>

        <div class="ba-drawer__fields">

          <!-- Row 1: Name + Email -->
          <div class="inq-form__row">
            <div class="inq-form__field">
              <label class="inq-form__label" for="d-name">Your Name</label>
              <input class="inq-form__input" type="text" id="d-name" name="name" placeholder="First and Last" required autocomplete="name">
            </div>
            <div class="inq-form__field">
              <label class="inq-form__label" for="d-email">Email Address</label>
              <input class="inq-form__input" type="email" id="d-email" name="email" placeholder="you@email.com" required autocomplete="email">
            </div>
          </div>

          <!-- Row 2: Phone + How Can We Help -->
          <div class="inq-form__row">
            <div class="inq-form__field">
              <label class="inq-form__label" for="d-phone">Phone <span class="form-optional">(optional)</span></label>
              <input class="inq-form__input" type="tel" id="d-phone" name="phone" placeholder="(xxx) xxx-xxxx" autocomplete="tel">
            </div>
            <div class="inq-form__field inq-form__field--select">
              <label class="inq-form__label" for="d-intent">How Can We Help</label>
              <select class="inq-form__input inq-form__select" id="d-intent" name="intent" required>
                <option value="">Select…</option>
                <option value="commission a piece">Commission a Piece</option>
                <option value="consultation">Private Consultation</option>
                <option value="atelier visit">Visit the Atelier</option>
                <option value="collection piece">A Piece from the Collection</option>
                <option value="repairs">Repair &amp; Cleaning</option>
                <option value="resize">Ring Resizing</option>
              </select>
            </div>
          </div>

          <!-- Message (default, hidden for resize) -->
          <div class="inq-form__field" id="d-message-wrap">
            <label class="inq-form__label" for="d-message">Message <span class="form-optional">(optional)</span></label>
            <textarea class="inq-form__input inq-form__textarea" id="d-message" name="message" rows="3" placeholder="Tell us what you have in mind…"></textarea>
          </div>

          <!-- Preferred Date (visit only) -->
          <div class="inq-form__field" id="d-date-wrap" style="display:none">
            <label class="inq-form__label" for="d-date">Preferred Date <span class="form-optional">(optional)</span></label>
            <input class="inq-form__input" type="text" id="d-date" name="preferred_date" placeholder="e.g. Mon or Tue afternoon">
          </div>

          <!-- Ring Resizing fields (resize only) -->
          <div id="d-resize-wrap" style="display:none">
            <div class="inq-form__row">
              <div class="inq-form__field">
                <label class="inq-form__label" for="d-size-current">Current Ring Size</label>
                <input class="inq-form__input" type="text" id="d-size-current" name="current_ring_size" placeholder="e.g. 6">
              </div>
              <div class="inq-form__field">
                <label class="inq-form__label" for="d-size-desired">Desired Ring Size</label>
                <input class="inq-form__input" type="text" id="d-size-desired" name="desired_ring_size" placeholder="e.g. 6.5">
              </div>
            </div>
          </div>

        </div>

        <p class="form-privacy">Your enquiry is private and handled directly by Bez's team.</p>

        <button type="submit" class="ba-drawer__submit" id="drawer-submit-btn">
          <span class="btn-label">Send Inquiry</span>
          <span class="btn-loading" aria-hidden="true" style="display:none">Sending…</span>
        </button>

        <p class="form-error" id="drawer-form-error" role="alert" style="display:none"></p>
      </form>

      <!-- Contact block — always visible below the form -->
      <div class="ba-drawer__contact">
        <hr class="ba-drawer__contact-rule">
        <div class="ba-drawer__contact-row">
          <span class="ba-drawer__contact-label">Tel</span>
          <a href="tel:2136299191" class="ba-drawer__contact-value">(213) 629-9191</a>
        </div>
        <div class="ba-drawer__contact-row">
          <span class="ba-drawer__contact-label">Atelier</span>
          <span class="ba-drawer__contact-value">611 Wilshire Blvd<br>Los Angeles, CA 90017</span>
        </div>
        <div class="ba-drawer__contact-row ba-drawer__contact-row--social">
          <span class="ba-drawer__contact-label">Follow</span>
          <SocialLinks class="ba-drawer__socials" />
        </div>
      </div>

      <div id="drawer-success" class="form-success-state" style="display:none">
        <div class="success-mark">&#10022;</div>
        <h3>Your inquiry has been received.</h3>
        <p>A member of our team will be in touch within one business day. We look forward to connecting with you.</p>
      </div>
    </div>
  </div>
</div>

<style is:global>
/* ── Inquiry Drawer ──────────────────────────────────────── */
.ba-drawer {
  position: fixed;
  inset: 0;
  z-index: 900;
  pointer-events: none;
}
.ba-drawer.is-open {
  pointer-events: auto;
}
.ba-drawer__backdrop {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  opacity: 0;
  transition: opacity 0.3s ease;
}
.ba-drawer.is-open .ba-drawer__backdrop {
  opacity: 1;
}
.ba-drawer__panel {
  position: absolute;
  top: 0;
  right: 0;
  height: 100%;
  width: min(480px, 100vw);
  background: var(--white);
  box-shadow: -4px 0 32px rgba(0, 0, 0, 0.12);
  transform: translateX(100%);
  transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  padding: 3rem 2.25rem 3rem;
}
.ba-drawer.is-open .ba-drawer__panel {
  transform: translateX(0);
}
.ba-drawer__close {
  position: absolute;
  top: 1.25rem;
  right: 1.5rem;
  background: none;
  border: none;
  font-size: 1.125rem;
  cursor: pointer;
  color: var(--ink-muted);
  line-height: 1;
  padding: 0.375rem;
  transition: color 0.15s;
}
.ba-drawer__close:hover { color: var(--ink); }
.ba-drawer__context {
  border-left: 2px solid var(--accent);
  padding-left: 0.875rem;
  margin-bottom: 1.75rem;
}
.ba-drawer__context-label {
  font-family: var(--sans);
  text-transform: var(--sans-transform, none);
  letter-spacing: var(--sans-letter-spacing, normal);
  font-size: 0.6875rem;
  color: var(--ink-muted);
  margin-bottom: 0.2rem;
}
.ba-drawer__context-title {
  font-size: 1rem;
  color: var(--ink);
  line-height: 1.4;
}
.ba-drawer__body {
  margin-top: 0.5rem;
}
.ba-drawer__heading {
  font-size: 1.5rem;
  font-weight: 400;
  color: var(--ink);
  margin-bottom: 0.4rem;
}
.ba-drawer__subhead {
  font-family: var(--sans);
  text-transform: var(--sans-transform, none);
  letter-spacing: var(--sans-letter-spacing, normal);
  font-size: 0.8125rem;
  color: var(--ink-muted);
  margin-bottom: 2rem;
  line-height: 1.5;
}
.ba-drawer__fields {
  display: flex;
  flex-direction: column;
  gap: 28px;
  margin-bottom: 1.75rem;
}
.ba-drawer__submit {
  width: 100%;
  font-family: var(--sans);
  text-transform: var(--sans-transform, none);
  letter-spacing: var(--sans-letter-spacing, normal);
  font-size: 11px;
  font-weight: 500;
  color: var(--white);
  background: var(--ink);
  border: none;
  padding: 16px 32px;
  cursor: pointer;
  transition: background 0.2s, color 0.2s;
  min-height: 52px;
  -webkit-tap-highlight-color: transparent;
}
.ba-drawer__submit:hover { background: var(--accent); color: var(--ink); }
.ba-drawer__submit:disabled { opacity: 0.5; cursor: not-allowed; }

/* ── Drawer contact block ─────────────────────────────────── */
.ba-drawer__contact {
  margin-top: 2rem;
}
.ba-drawer__contact-rule {
  width: 100%;
  height: 1px;
  background: var(--border-warm);
  border: none;
  margin-bottom: 1.5rem;
}
.ba-drawer__contact-row {
  display: grid;
  grid-template-columns: 48px 1fr;
  gap: 12px;
  align-items: start;
  margin-bottom: 1.25rem;
}
.ba-drawer__contact-label {
  font-family: var(--sans);
  text-transform: var(--sans-transform, none);
  letter-spacing: var(--sans-letter-spacing, normal);
  font-size: 9px;
  font-weight: 500;
  color: var(--accent);
  padding-top: 3px;
}
.ba-drawer__contact-value {
  font-family: var(--serif);
  font-size: 15px;
  color: var(--ink-soft);
  line-height: 1.6;
  text-decoration: none;
  transition: color 0.2s;
}
a.ba-drawer__contact-value:hover { color: var(--ink); }

.ba-drawer__socials { gap: 16px; }
.ba-drawer__socials .social-links__icon { color: var(--ink-soft); }

/* shared form atoms used by both drawer and contact page */
.form-optional {
  font-size: 0.8em;
  color: var(--ink-muted);
  font-weight: 400;
}
.form-privacy {
  font-family: var(--sans);
  text-transform: var(--sans-transform, none);
  letter-spacing: var(--sans-letter-spacing, normal);
  font-size: 0.75rem;
  color: var(--ink-muted);
  margin-bottom: 1.25rem;
}
.form-error {
  font-family: var(--sans);
  text-transform: var(--sans-transform, none);
  letter-spacing: var(--sans-letter-spacing, normal);
  font-size: 0.8125rem;
  color: #c0392b;
  margin-top: 0.75rem;
}
.form-success-state {
  text-align: center;
  padding: 2rem 1rem;
}
.success-mark {
  font-size: 2rem;
  color: var(--accent);
  margin-bottom: 1rem;
}
.form-success-state h3 {
  font-size: 1.25rem;
  font-weight: 400;
  margin-bottom: 0.75rem;
}
.form-success-state p {
  font-family: var(--sans);
  text-transform: var(--sans-transform, none);
  letter-spacing: var(--sans-letter-spacing, normal);
  font-size: 0.875rem;
  color: var(--ink-muted);
  line-height: 1.6;
}
</style>

<script>
  const WORKER_URL = 'https://bezito-forms.bezambarinc.workers.dev';

  const drawer    = document.getElementById('inquiry-drawer') as HTMLElement;
  const backdrop  = document.getElementById('drawerBackdrop') as HTMLElement;
  const closeBtn  = document.getElementById('drawerClose') as HTMLButtonElement;
  const contextEl = document.getElementById('drawerContext') as HTMLElement;
  const contextTitleEl = document.getElementById('drawerContextTitle') as HTMLElement;
  const intentInput    = document.getElementById('d-intent') as HTMLInputElement;
  const form      = document.getElementById('drawer-form') as HTMLFormElement;
  const successEl = document.getElementById('drawer-success') as HTMLElement;
  const errorEl   = document.getElementById('drawer-form-error') as HTMLElement;
  const submitBtn = document.getElementById('drawer-submit-btn') as HTMLButtonElement;

  let drawerPieceTitle = '';
  let drawerPieceSku   = '';

  const intentSelect  = document.getElementById('d-intent')   as HTMLSelectElement;
  const messageWrap   = document.getElementById('d-message-wrap') as HTMLElement;
  const dateWrap      = document.getElementById('d-date-wrap')    as HTMLElement;
  const resizeWrap    = document.getElementById('d-resize-wrap')  as HTMLElement;
  const drawerHeading = document.getElementById('ba-drawer-heading') as HTMLElement;

  const HEADING_MAP: Record<string, string> = {
    'commission a piece': 'Commission a Piece',
    'consultation':       'Private Consultation',
    'atelier visit':      'Visit the Atelier',
    'collection piece':   'A Piece from the Collection',
    'repairs':            'Repair &amp; Cleaning',
    'resize':             'Ring Resizing',
  };

  function updateFormFields() {
    const val = intentSelect?.value || '';
    const isResize = val === 'resize';
    const isVisit  = val === 'atelier visit';

    if (messageWrap) messageWrap.style.display = isResize ? 'none' : '';
    if (resizeWrap)  resizeWrap.style.display  = isResize ? '' : 'none';
    if (dateWrap)    dateWrap.style.display    = isVisit  ? '' : 'none';

    if (drawerHeading) {
      drawerHeading.innerHTML = HEADING_MAP[val] || 'Connect with the Atelier';
    }
  }

  intentSelect?.addEventListener('change', updateFormFields);

  function openDrawer(opts: { title?: string; sku?: string; intent?: string } = {}) {
    drawerPieceTitle = opts.title || '';
    drawerPieceSku   = opts.sku   || '';

    if (drawerPieceTitle) {
      contextTitleEl.textContent = drawerPieceTitle;
      contextEl.hidden = false;
    } else {
      contextEl.hidden = true;
    }

    // reset form state
    form.style.display = '';
    successEl.style.display = 'none';
    errorEl.style.display = 'none';
    form.reset();

    // pre-select intent and update fields
    if (intentSelect) intentSelect.value = opts.intent || '';
    updateFormFields();

    drawer.hidden = false;
    requestAnimationFrame(() => drawer.classList.add('is-open'));
    document.body.style.overflow = 'hidden';

    const nameInput = form.querySelector('#d-name') as HTMLInputElement | null;
    setTimeout(() => nameInput?.focus(), 60);
  }

  function closeDrawer() {
    drawer.classList.remove('is-open');
    document.body.style.overflow = '';
    setTimeout(() => { drawer.hidden = true; }, 360);
  }

  closeBtn.addEventListener('click', closeDrawer);
  backdrop.addEventListener('click', closeDrawer);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer.classList.contains('is-open')) closeDrawer();
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const btnLabel   = submitBtn.querySelector('.btn-label')   as HTMLElement | null;
    const btnLoading = submitBtn.querySelector('.btn-loading') as HTMLElement | null;

    if (btnLabel)   btnLabel.style.display   = 'none';
    if (btnLoading) btnLoading.style.display = '';
    submitBtn.disabled = true;
    errorEl.style.display = 'none';

    const data = new FormData(form);
    const fullName = ((data.get('name') as string) || '').trim();
    const spaceIdx = fullName.indexOf(' ');
    const firstName = spaceIdx > -1 ? fullName.slice(0, spaceIdx) : fullName;
    const lastName  = spaceIdx > -1 ? fullName.slice(spaceIdx + 1) : '';

    const intent        = (data.get('intent') as string) || '';
    const currentSize   = (data.get('current_ring_size') as string) || '';
    const desiredSize   = (data.get('desired_ring_size') as string) || '';
    const preferredDate = (data.get('preferred_date')    as string) || '';
    let   message       = (data.get('message')           as string) || '';

    // For resize: build message from size fields
    if (intent === 'resize' && (currentSize || desiredSize)) {
      message = `Current size: ${currentSize || 'not provided'}. Desired size: ${desiredSize || 'not provided'}.`;
    }
    // For atelier visit: prepend preferred date if provided
    if (intent === 'atelier visit' && preferredDate) {
      message = `Preferred date/time: ${preferredDate}${message ? '\n' + message : ''}`;
    }

    const payload = {
      firstName,
      lastName,
      email:      data.get('email') as string,
      phone:      (data.get('phone') as string) || '',
      intent,
      message,
      pieceTitle: drawerPieceTitle,
      pieceSku:   drawerPieceSku,
      utmSource:   sessionStorage.getItem('utm_source')   || '',
      utmMedium:   sessionStorage.getItem('utm_medium')   || '',
      utmCampaign: sessionStorage.getItem('utm_campaign') || '',
    };

    try {
      const res = await fetch(`${WORKER_URL}/api/contact`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      if (!res.ok) {
        const body = await res.json().catch(() => ({})) as { error?: string };
        throw new Error(body.error || 'Submission failed. Please try again.');
      }

      form.style.display = 'none';
      successEl.style.display = '';
    } catch (err: unknown) {
      const msg = err instanceof Error ? err.message : 'Something went wrong. Please email us at bez@bezambar.com.';
      errorEl.textContent = msg;
      errorEl.style.display = '';
      if (btnLabel)   btnLabel.style.display   = '';
      if (btnLoading) btnLoading.style.display = 'none';
      submitBtn.disabled = false;
    }
  });

  // Global trigger API
  (window as any).openInquiryDrawer = openDrawer;
</script>
