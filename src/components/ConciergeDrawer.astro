---
// ConciergeDrawer.astro — Luxury contact channel panel (Tiffany-style).
// Global API: window.openConciergeDrawer() / window.closeConciergeDrawer()
---

<div id="concierge-drawer" class="cg-drawer" role="dialog" aria-modal="true" aria-label="Contact Us" hidden>
  <div class="cg-drawer__backdrop" id="cgBackdrop"></div>
  <div class="cg-drawer__panel">

    <button class="cg-drawer__close" id="cgClose" aria-label="Close">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
      </svg>
    </button>

    <h2 class="cg-drawer__heading">Contact Us</h2>

    <ul class="cg-list" role="list">

      <!-- Send a Message -->
      <li>
        <button class="cg-row" data-action="message">
          <span class="cg-row__icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
              <path d="M17 2H3a1 1 0 00-1 1v10a1 1 0 001 1h4l3 3 3-3h4a1 1 0 001-1V3a1 1 0 00-1-1z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
            </svg>
          </span>
          <span class="cg-row__label">Send a Message</span>
          <span class="cg-row__chevron" aria-hidden="true">
            <svg width="7" height="12" viewBox="0 0 7 12" fill="none">
              <path d="M1 1l5 5-5 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </button>
      </li>

      <!-- Call Us -->
      <li>
        <a class="cg-row" href="tel:2136299191">
          <span class="cg-row__icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
              <path d="M4.5 2.5c-.3 0-.6.1-.8.3L2.4 4.1C1.5 5 1.5 6.4 2.3 7.5c1.5 2.2 3.4 4.1 5.5 5.5 1.2.8 2.6.8 3.5-.1l1.3-1.3c.4-.4.4-1.1 0-1.5l-1.7-1.7c-.4-.4-1.1-.4-1.5 0l-.6.6c-.2.2-.5.2-.7.1-1-.6-1.9-1.5-2.5-2.5-.1-.2-.1-.5.1-.7l.6-.6c.4-.4.4-1.1 0-1.5L4.5 2.5z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
            </svg>
          </span>
          <span class="cg-row__label">Call Us (213) 629-9191</span>
          <span class="cg-row__chevron" aria-hidden="true">
            <svg width="7" height="12" viewBox="0 0 7 12" fill="none">
              <path d="M1 1l5 5-5 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </a>
      </li>

      <!-- Book an Appointment -->
      <li>
        <button class="cg-row" data-action="appointment">
          <span class="cg-row__icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
              <rect x="2" y="4" width="16" height="14" rx="1.5" stroke="currentColor" stroke-width="1.2"/>
              <path d="M2 8h16" stroke="currentColor" stroke-width="1.2"/>
              <path d="M6 2v4M14 2v4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
              <circle cx="7" cy="13" r="1" fill="currentColor"/>
              <circle cx="10" cy="13" r="1" fill="currentColor"/>
              <circle cx="13" cy="13" r="1" fill="currentColor"/>
            </svg>
          </span>
          <span class="cg-row__label">Book an Appointment</span>
          <span class="cg-row__chevron" aria-hidden="true">
            <svg width="7" height="12" viewBox="0 0 7 12" fill="none">
              <path d="M1 1l5 5-5 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </button>
      </li>

      <!-- Commission a Piece -->
      <li>
        <button class="cg-row" data-action="commission">
          <span class="cg-row__icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
              <path d="M10 2l2.2 4.5 5 .7-3.6 3.5.85 4.95L10 13.4l-4.45 2.35.85-4.95L2.8 7.2l5-.7L10 2z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
            </svg>
          </span>
          <span class="cg-row__label">Commission a Piece</span>
          <span class="cg-row__chevron" aria-hidden="true">
            <svg width="7" height="12" viewBox="0 0 7 12" fill="none">
              <path d="M1 1l5 5-5 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </button>
      </li>

    </ul>

  </div>
</div>

<style is:global>
/* ── Concierge Drawer ───────────────────────────────────── */
.cg-drawer {
  position: fixed;
  inset: 0;
  z-index: 950;
  pointer-events: none;
}
.cg-drawer.is-open {
  pointer-events: auto;
}
.cg-drawer__backdrop {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.35);
  opacity: 0;
  transition: opacity 0.3s ease;
}
.cg-drawer.is-open .cg-drawer__backdrop {
  opacity: 1;
}
.cg-drawer__panel {
  position: absolute;
  top: 0;
  right: 0;
  height: 100%;
  width: min(380px, 100vw);
  background: #fff;
  transform: translateX(100%);
  transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  overflow-y: auto;
  padding: 3rem 2rem 3rem;
  box-shadow: -2px 0 24px rgba(0, 0, 0, 0.08);
}
.cg-drawer.is-open .cg-drawer__panel {
  transform: translateX(0);
}

/* Close */
.cg-drawer__close {
  position: absolute;
  top: 1.5rem;
  left: 1.5rem;
  background: none;
  border: 1px solid rgba(0,0,0,0.15);
  border-radius: 50%;
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ink);
  cursor: pointer;
  transition: border-color 0.15s, color 0.15s;
}
.cg-drawer__close:hover {
  border-color: var(--ink);
}

/* Heading */
.cg-drawer__heading {
  font-family: var(--serif);
  font-size: 1.375rem;
  font-weight: 400;
  color: var(--ink);
  margin: 3rem 0 2rem;
  letter-spacing: 0.01em;
}

/* List */
.cg-list {
  list-style: none;
  padding: 0;
  margin: 0;
  border-top: 1px solid rgba(0,0,0,0.1);
}

/* Rows */
.cg-row {
  display: flex;
  align-items: center;
  gap: 1rem;
  width: 100%;
  padding: 1.125rem 0;
  border: none;
  border-bottom: 1px solid rgba(0,0,0,0.1);
  background: none;
  cursor: pointer;
  text-decoration: none;
  text-align: left;
  color: var(--ink);
  transition: color 0.15s;
}
.cg-row:hover { color: var(--accent); }

.cg-row__icon {
  flex-shrink: 0;
  width: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: inherit;
}
.cg-row__label {
  flex: 1;
  font-family: var(--sans);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: inherit;
}
.cg-row__chevron {
  flex-shrink: 0;
  color: rgba(0,0,0,0.3);
  transition: transform 0.15s, color 0.15s;
}
.cg-row:hover .cg-row__chevron {
  transform: translateX(2px);
  color: var(--accent);
}
</style>

<script>
  const cgDrawer   = document.getElementById('concierge-drawer') as HTMLElement;
  const cgBackdrop = document.getElementById('cgBackdrop') as HTMLElement;
  const cgClose    = document.getElementById('cgClose') as HTMLButtonElement;

  function openConciergeDrawer() {
    cgDrawer.hidden = false;
    requestAnimationFrame(() => cgDrawer.classList.add('is-open'));
    document.body.style.overflow = 'hidden';
  }

  function closeConciergeDrawer() {
    cgDrawer.classList.remove('is-open');
    document.body.style.overflow = '';
    setTimeout(() => { cgDrawer.hidden = true; }, 360);
  }

  cgClose.addEventListener('click', closeConciergeDrawer);
  cgBackdrop.addEventListener('click', closeConciergeDrawer);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && cgDrawer.classList.contains('is-open')) closeConciergeDrawer();
  });

  // Action map → InquiryDrawer intents
  const ACTION_MAP: Record<string, string> = {
    message:     '',
    appointment: 'atelier visit',
    commission:  'commission a piece',
  };

  cgDrawer.querySelectorAll<HTMLElement>('[data-action]').forEach(btn => {
    btn.addEventListener('click', () => {
      const action = btn.dataset.action || '';
      const intent = ACTION_MAP[action] ?? '';
      closeConciergeDrawer();
      setTimeout(() => {
        (window as any).openInquiryDrawer?.({ intent });
      }, 200);
    });
  });

  (window as any).openConciergeDrawer  = openConciergeDrawer;
  (window as any).closeConciergeDrawer = closeConciergeDrawer;
</script>
