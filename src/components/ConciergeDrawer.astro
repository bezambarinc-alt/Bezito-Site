---
// ConciergeDrawer.astro — Luxury concierge contact panel.
// Global API: window.openConciergeDrawer() / window.closeConciergeDrawer()
---

<div id="concierge-drawer" class="cg-drawer" role="dialog" aria-modal="true" aria-label="Contact Us" hidden>
  <div class="cg-drawer__backdrop" id="cgBackdrop"></div>
  <div class="cg-drawer__panel">

    <button class="cg-drawer__close" id="cgClose" aria-label="Close">
      <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
        <path d="M1 1l10 10M11 1L1 11" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
      </svg>
    </button>

    <h2 class="cg-drawer__heading">Contact Us</h2>

    <!-- Reach Us -->
    <p class="cg-cat">Reach Us</p>
    <ul class="cg-list" role="list">
      <li>
        <button class="cg-row" data-action="chat">
          <span class="cg-row__icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M15 2H3a1 1 0 00-1 1v9a1 1 0 001 1h3.5l2.5 2.5 2.5-2.5H15a1 1 0 001-1V3a1 1 0 00-1-1z" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"/></svg>
          </span>
          <span class="cg-row__label">Chat Online</span>
          <span class="cg-row__chevron" aria-hidden="true">›</span>
        </button>
      </li>
      <li>
        <a class="cg-row" href="tel:2136299191">
          <span class="cg-row__icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M4 2.5c-.3 0-.5.1-.7.3L2.1 4c-.8.8-.8 2 0 2.9 1.3 2 3 3.7 5 5 1 .7 2.3.7 3.1-.1l1.2-1.2c.4-.4.4-1 0-1.4L9.8 7.6c-.4-.4-1-.4-1.4 0l-.5.5c-.2.2-.4.2-.6 0C6.5 7.4 5.8 6.7 5.4 6c-.2-.2-.2-.4 0-.6l.5-.5c.4-.4.4-1 0-1.4L4.7 2.8c-.2-.2-.4-.3-.7-.3z" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"/></svg>
          </span>
          <span class="cg-row__label">Call Us &nbsp;(213) 629-9191</span>
          <span class="cg-row__chevron" aria-hidden="true">›</span>
        </a>
      </li>
      <li>
        <button class="cg-row" data-action="message">
          <span class="cg-row__icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><rect x="2" y="3" width="14" height="10" rx="1.2" stroke="currentColor" stroke-width="1.1"/><path d="M2 5l7 5 7-5" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/></svg>
          </span>
          <span class="cg-row__label">Send a Message</span>
          <span class="cg-row__chevron" aria-hidden="true">›</span>
        </button>
      </li>
    </ul>

    <!-- Visit -->
    <p class="cg-cat">Visit</p>
    <ul class="cg-list" role="list">
      <li>
        <button class="cg-row" data-action="appointment">
          <span class="cg-row__icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><rect x="2" y="4" width="14" height="12" rx="1.2" stroke="currentColor" stroke-width="1.1"/><path d="M2 8h14" stroke="currentColor" stroke-width="1.1"/><path d="M6 2v3M12 2v3" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/><circle cx="6.5" cy="12" r=".9" fill="currentColor"/><circle cx="9" cy="12" r=".9" fill="currentColor"/><circle cx="11.5" cy="12" r=".9" fill="currentColor"/></svg>
          </span>
          <span class="cg-row__label">Book an Appointment</span>
          <span class="cg-row__chevron" aria-hidden="true">›</span>
        </button>
      </li>
      <li>
        <button class="cg-row" data-action="virtual">
          <span class="cg-row__icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><rect x="2" y="5" width="11" height="8" rx="1.2" stroke="currentColor" stroke-width="1.1"/><path d="M13 8l3-2v6l-3-2V8z" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"/></svg>
          </span>
          <span class="cg-row__label">Book a Virtual Appointment</span>
          <span class="cg-row__chevron" aria-hidden="true">›</span>
        </button>
      </li>
    </ul>

    <!-- Bespoke -->
    <p class="cg-cat">Bespoke</p>
    <ul class="cg-list" role="list">
      <li>
        <button class="cg-row" data-action="commission">
          <span class="cg-row__icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M9 2l1.8 3.6 4 .6-2.9 2.8.7 4-3.6-1.9-3.6 1.9.7-4L3.2 6.2l4-.6L9 2z" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"/></svg>
          </span>
          <span class="cg-row__label">Commission a Piece</span>
          <span class="cg-row__chevron" aria-hidden="true">›</span>
        </button>
      </li>
      <li>
        <button class="cg-row" data-action="consultation">
          <span class="cg-row__icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><circle cx="9" cy="7" r="3.5" stroke="currentColor" stroke-width="1.1"/><path d="M2.5 16c0-3 2.9-5 6.5-5s6.5 2 6.5 5" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/></svg>
          </span>
          <span class="cg-row__label">Private Consultation</span>
          <span class="cg-row__chevron" aria-hidden="true">›</span>
        </button>
      </li>
    </ul>

    <!-- Services -->
    <p class="cg-cat">Services</p>
    <ul class="cg-list cg-list--last" role="list">
      <li>
        <button class="cg-row" data-action="repairs">
          <span class="cg-row__icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M13.5 2.5a3 3 0 00-2.8 4l-6.5 6.5a1.5 1.5 0 002.1 2.1l6.5-6.5a3 3 0 004-2.8 3 3 0 00-.4-1.5l-1.9 1.9-1.5-1.5 1.9-1.9a3 3 0 00-1.4-.3z" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"/></svg>
          </span>
          <span class="cg-row__label">Repair &amp; Cleaning</span>
          <span class="cg-row__chevron" aria-hidden="true">›</span>
        </button>
      </li>
      <li>
        <button class="cg-row" data-action="resize">
          <span class="cg-row__icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><circle cx="9" cy="9" r="5" stroke="currentColor" stroke-width="1.1"/><circle cx="9" cy="9" r="2" stroke="currentColor" stroke-width="1.1"/></svg>
          </span>
          <span class="cg-row__label">Ring Resizing</span>
          <span class="cg-row__chevron" aria-hidden="true">›</span>
        </button>
      </li>
    </ul>

  </div>
</div>

<style is:global>
/* ── Concierge Drawer ───────────────────────────────────── */
.cg-drawer {
  position: fixed;
  inset: 0;
  z-index: 950;
  pointer-events: none;
}
.cg-drawer.is-open { pointer-events: auto; }

.cg-drawer__backdrop {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.3);
  opacity: 0;
  transition: opacity 0.3s ease;
}
.cg-drawer.is-open .cg-drawer__backdrop { opacity: 1; }

.cg-drawer__panel {
  position: absolute;
  top: 0;
  right: 0;
  height: 100%;
  width: min(400px, 100vw);
  background: #faf8f5;
  transform: translateX(100%);
  transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  overflow-y: auto;
  padding: 2.5rem 2.25rem 3rem;
  box-shadow: -2px 0 32px rgba(0,0,0,0.06);
}
.cg-drawer.is-open .cg-drawer__panel { transform: translateX(0); }

/* Close */
.cg-drawer__close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 30px;
  height: 30px;
  border: 1px solid rgba(0,0,0,0.18);
  border-radius: 50%;
  background: none;
  cursor: pointer;
  color: #555;
  transition: border-color 0.15s, color 0.15s;
  margin-bottom: 2rem;
}
.cg-drawer__close:hover { border-color: var(--accent); color: var(--accent); }

/* Heading */
.cg-drawer__heading {
  font-family: var(--serif);
  font-size: 1.625rem;
  font-weight: 300;
  color: var(--ink);
  letter-spacing: 0.02em;
  margin-bottom: 2rem;
}

/* Category label */
.cg-cat {
  font-family: var(--serif);
  font-style: italic;
  font-size: 0.75rem;
  font-weight: 400;
  color: var(--accent);
  letter-spacing: 0.06em;
  margin: 1.5rem 0 0;
  opacity: 0.8;
}

/* List */
.cg-list {
  list-style: none;
  padding: 0;
  margin: 0.5rem 0 0;
  border-top: 1px solid rgba(0,0,0,0.08);
}
.cg-list--last { border-bottom: 1px solid rgba(0,0,0,0.08); }

/* Rows */
.cg-row {
  display: flex;
  align-items: center;
  gap: 0.875rem;
  width: 100%;
  padding: 1rem 0;
  border: none;
  border-bottom: 1px solid rgba(0,0,0,0.06);
  background: none;
  cursor: pointer;
  text-decoration: none;
  color: var(--ink);
  transition: color 0.15s;
}
.cg-list--last li:last-child .cg-row { border-bottom: none; }
.cg-row:hover { color: var(--accent); }

.cg-row__icon {
  flex-shrink: 0;
  width: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.6;
  color: inherit;
  transition: opacity 0.15s;
}
.cg-row:hover .cg-row__icon { opacity: 1; }

.cg-row__label {
  flex: 1;
  font-family: var(--sans);
  font-size: 12px;
  font-weight: 400;
  letter-spacing: 0.04em;
  color: inherit;
}

.cg-row__chevron {
  font-family: var(--serif);
  font-size: 1.125rem;
  color: rgba(0,0,0,0.2);
  line-height: 1;
  transition: transform 0.15s, color 0.15s;
}
.cg-row:hover .cg-row__chevron {
  transform: translateX(2px);
  color: var(--accent);
}
</style>

<script>
  const cgDrawer   = document.getElementById('concierge-drawer') as HTMLElement;
  const cgBackdrop = document.getElementById('cgBackdrop') as HTMLElement;
  const cgClose    = document.getElementById('cgClose') as HTMLButtonElement;

  function openConciergeDrawer() {
    cgDrawer.hidden = false;
    requestAnimationFrame(() => cgDrawer.classList.add('is-open'));
    document.body.style.overflow = 'hidden';
  }

  function closeConciergeDrawer() {
    cgDrawer.classList.remove('is-open');
    document.body.style.overflow = '';
    setTimeout(() => { cgDrawer.hidden = true; }, 360);
  }

  cgClose.addEventListener('click', closeConciergeDrawer);
  cgBackdrop.addEventListener('click', closeConciergeDrawer);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && cgDrawer.classList.contains('is-open')) closeConciergeDrawer();
  });

  const ACTION_INTENTS: Record<string, string> = {
    message:      '',
    appointment:  'atelier visit',
    virtual:      'consultation',
    commission:   'commission a piece',
    consultation: 'consultation',
    repairs:      'repairs',
    resize:       'resize',
  };

  cgDrawer.querySelectorAll<HTMLElement>('[data-action]').forEach(btn => {
    btn.addEventListener('click', () => {
      const action = btn.dataset.action || '';

      if (action === 'chat') {
        // Freshchat — open widget when available, else fall back to message form
        if ((window as any).fcWidget?.isOpen !== undefined) {
          closeConciergeDrawer();
          (window as any).fcWidget.open();
        } else {
          closeConciergeDrawer();
          setTimeout(() => (window as any).openInquiryDrawer?.({ intent: '' }), 200);
        }
        return;
      }

      const intent = ACTION_INTENTS[action] ?? '';
      closeConciergeDrawer();
      setTimeout(() => (window as any).openInquiryDrawer?.({ intent }), 200);
    });
  });

  (window as any).openConciergeDrawer  = openConciergeDrawer;
  (window as any).closeConciergeDrawer = closeConciergeDrawer;
</script>
