---
// ConciergeDrawer.astro — Luxury concierge contact panel.
// Global API: window.openConciergeDrawer() / window.closeConciergeDrawer()
---

<div id="concierge-drawer" class="cg-drawer" role="dialog" aria-modal="true" aria-label="Contact Us" hidden>
  <div class="cg-drawer__backdrop" id="cgBackdrop"></div>
  <div class="cg-drawer__panel">

    <button class="cg-drawer__close" id="cgClose" aria-label="Close">
      <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
        <path d="M1 1l10 10M11 1L1 11" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
      </svg>
    </button>

    <h2 class="cg-drawer__heading">Contact Us</h2>

    <ul class="cg-list" role="list">

      <!-- Atelier Chat -->
      <li>
        <button class="cg-row" data-action="chat">
          <span class="cg-row__icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M15 2H3a1 1 0 00-1 1v9a1 1 0 001 1h3.5l2.5 2.5 2.5-2.5H15a1 1 0 001-1V3a1 1 0 00-1-1z" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"/></svg>
          </span>
          <span class="cg-row__label">Atelier Chat</span>
          <span class="cg-row__chevron" aria-hidden="true">›</span>
        </button>
      </li>

      <!-- Call Us -->
      <li>
        <button class="cg-row" data-action="call">
          <span class="cg-row__icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M4 2.5c-.3 0-.5.1-.7.3L2.1 4c-.8.8-.8 2 0 2.9 1.3 2 3 3.7 5 5 1 .7 2.3.7 3.1-.1l1.2-1.2c.4-.4.4-1 0-1.4L9.8 7.6c-.4-.4-1-.4-1.4 0l-.5.5c-.2.2-.4.2-.6 0C6.5 7.4 5.8 6.7 5.4 6c-.2-.2-.2-.4 0-.6l.5-.5c.4-.4.4-1 0-1.4L4.7 2.8c-.2-.2-.4-.3-.7-.3z" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"/></svg>
          </span>
          <span class="cg-row__label">Call Us</span>
          <span class="cg-row__chevron" aria-hidden="true">›</span>
        </button>
      </li>

      <!-- Book an Appointment — expandable -->
      <li class="cg-appt-wrap">
        <button class="cg-row cg-appt-trigger" id="cgApptTrigger" aria-expanded="false">
          <span class="cg-row__icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><rect x="2" y="4" width="14" height="12" rx="1.2" stroke="currentColor" stroke-width="1.1"/><path d="M2 8h14" stroke="currentColor" stroke-width="1.1"/><path d="M6 2v3M12 2v3" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/><circle cx="6.5" cy="12" r=".9" fill="currentColor"/><circle cx="9" cy="12" r=".9" fill="currentColor"/><circle cx="11.5" cy="12" r=".9" fill="currentColor"/></svg>
          </span>
          <span class="cg-row__label">Book an Appointment</span>
          <span class="cg-row__chevron cg-appt-chevron" aria-hidden="true">›</span>
        </button>
        <ul class="cg-appt-sub" id="cgApptSub" role="list">
          <li>
            <button class="cg-row cg-row--sub" data-action="appointment">
              <span class="cg-row__label">In Person</span>
              <span class="cg-row__chevron" aria-hidden="true">›</span>
            </button>
          </li>
          <li>
            <button class="cg-row cg-row--sub" data-action="virtual">
              <span class="cg-row__label">Virtual</span>
              <span class="cg-row__chevron" aria-hidden="true">›</span>
            </button>
          </li>
        </ul>
      </li>

      <!-- Services — expandable -->
      <li class="cg-appt-wrap" id="cgServicesWrap">
        <button class="cg-row cg-appt-trigger" id="cgServicesTrigger" aria-expanded="false">
          <span class="cg-row__icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M13.5 2.5a3 3 0 00-2.8 4l-6.5 6.5a1.5 1.5 0 002.1 2.1l6.5-6.5a3 3 0 004-2.8 3 3 0 00-.4-1.5l-1.9 1.9-1.5-1.5 1.9-1.9a3 3 0 00-1.4-.3z" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"/></svg>
          </span>
          <span class="cg-row__label">Services</span>
          <span class="cg-row__chevron cg-appt-chevron" aria-hidden="true">›</span>
        </button>
        <ul class="cg-appt-sub" id="cgServicesSub" role="list">
          <li>
            <button class="cg-row cg-row--sub" data-action="repairs">
              <span class="cg-row__label">Repair &amp; Cleaning</span>
              <span class="cg-row__chevron" aria-hidden="true">›</span>
            </button>
          </li>
          <li>
            <button class="cg-row cg-row--sub" data-action="resize">
              <span class="cg-row__label">Ring Resizing</span>
              <span class="cg-row__chevron" aria-hidden="true">›</span>
            </button>
          </li>
        </ul>
      </li>

    </ul>

  </div>
</div>

<style is:global>
/* ── Concierge Drawer ───────────────────────────────────── */
.cg-drawer {
  position: fixed;
  inset: 0;
  z-index: 950;
  pointer-events: none;
}
.cg-drawer.is-open { pointer-events: auto; }

.cg-drawer__backdrop {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.3);
  opacity: 0;
  transition: opacity 0.3s ease;
}
.cg-drawer.is-open .cg-drawer__backdrop { opacity: 1; }

.cg-drawer__panel {
  position: absolute;
  top: 0;
  right: 0;
  height: 100%;
  width: min(400px, 100vw);
  background: #faf8f5;
  transform: translateX(100%);
  transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  overflow-y: auto;
  padding: 2.5rem 2.25rem 3rem;
  box-shadow: -2px 0 32px rgba(0,0,0,0.06);
}
.cg-drawer.is-open .cg-drawer__panel { transform: translateX(0); }

/* Close */
.cg-drawer__close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 30px;
  height: 30px;
  border: 1px solid rgba(0,0,0,0.18);
  border-radius: 50%;
  background: none;
  cursor: pointer;
  color: #555;
  transition: border-color 0.15s, color 0.15s;
  margin-bottom: 2rem;
}
.cg-drawer__close:hover { border-color: var(--accent); color: var(--accent); }

/* Heading */
.cg-drawer__heading {
  font-family: var(--serif);
  font-size: 1.625rem;
  font-weight: 300;
  color: var(--ink);
  letter-spacing: 0.02em;
  margin-bottom: 2rem;
}

/* List */
.cg-list {
  list-style: none;
  padding: 0;
  margin: 0;
  border-top: 1px solid rgba(0,0,0,0.08);
  border-bottom: 1px solid rgba(0,0,0,0.08);
}

/* Rows */
.cg-row {
  display: flex;
  align-items: center;
  gap: 0.875rem;
  width: 100%;
  padding: 1rem 0;
  border: none;
  border-bottom: 1px solid rgba(0,0,0,0.06);
  background: none;
  cursor: pointer;
  text-decoration: none;
  color: var(--ink);
  transition: color 0.15s;
  box-sizing: border-box;
  font-size: inherit;
  line-height: inherit;
}
.cg-list > li:last-child > .cg-row { border-bottom: none; }
.cg-row:hover { color: var(--accent); }

.cg-row__icon {
  flex-shrink: 0;
  width: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.6;
  color: inherit;
  transition: opacity 0.15s;
}
.cg-row:hover .cg-row__icon { opacity: 1; }

.cg-row__label {
  flex: 1;
  font-family: var(--sans);
  font-size: 12px;
  font-weight: 400;
  letter-spacing: 0.04em;
  color: inherit;
  text-align: left;
}

.cg-row__chevron {
  font-family: var(--serif);
  font-size: 1.125rem;
  color: rgba(0,0,0,0.2);
  line-height: 1;
  transition: transform 0.15s, color 0.15s;
}
.cg-row:hover .cg-row__chevron {
  transform: translateX(2px);
  color: var(--accent);
}

/* ── Appointment sub-menu ──────────────────────────────── */
.cg-appt-chevron {
  transition: transform 0.25s ease, color 0.15s !important;
}
.cg-appt-wrap.is-open .cg-appt-chevron {
  transform: rotate(90deg) !important;
}

.cg-appt-sub {
  list-style: none;
  padding: 0;
  margin: 0;
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.25s ease;
  background: rgba(0,0,0,0.025);
}
.cg-appt-sub.is-open {
  max-height: 160px;
}

/* Sub-rows: indented past icon + gap */
.cg-row--sub {
  padding-left: calc(18px + 0.875rem + 0.75rem);
  padding-top: 0.75rem;
  padding-bottom: 0.75rem;
  border-bottom: 1px solid rgba(0,0,0,0.04);
  font-size: 11px;
}
.cg-appt-sub li:last-child .cg-row--sub {
  border-bottom: 1px solid rgba(0,0,0,0.06);
}
</style>

<script>
  const cgDrawer      = document.getElementById('concierge-drawer') as HTMLElement;
  const cgBackdrop    = document.getElementById('cgBackdrop') as HTMLElement;
  const cgClose       = document.getElementById('cgClose') as HTMLButtonElement;
  const cgApptTrigger      = document.getElementById('cgApptTrigger') as HTMLButtonElement;
  const cgApptSub          = document.getElementById('cgApptSub') as HTMLElement;
  const cgApptWrap         = cgApptTrigger?.closest('.cg-appt-wrap') as HTMLElement | null;
  const cgServicesTrigger  = document.getElementById('cgServicesTrigger') as HTMLButtonElement;
  const cgServicesSub      = document.getElementById('cgServicesSub') as HTMLElement;
  const cgServicesWrap     = document.getElementById('cgServicesWrap') as HTMLElement | null;

  function openConciergeDrawer() {
    cgDrawer.hidden = false;
    requestAnimationFrame(() => cgDrawer.classList.add('is-open'));
    document.body.style.overflow = 'hidden';
  }

  function closeConciergeDrawer() {
    cgDrawer.classList.remove('is-open');
    document.body.style.overflow = '';
    setTimeout(() => { cgDrawer.hidden = true; }, 360);
  }

  function toggleExpand(trigger: HTMLButtonElement, sub: HTMLElement, wrap: HTMLElement | null) {
    const isOpen = wrap?.classList.contains('is-open');
    if (isOpen) {
      wrap?.classList.remove('is-open');
      sub?.classList.remove('is-open');
      trigger.setAttribute('aria-expanded', 'false');
    } else {
      wrap?.classList.add('is-open');
      sub?.classList.add('is-open');
      trigger.setAttribute('aria-expanded', 'true');
    }
  }

  cgApptTrigger?.addEventListener('click', () => toggleExpand(cgApptTrigger, cgApptSub, cgApptWrap));
  cgServicesTrigger?.addEventListener('click', () => toggleExpand(cgServicesTrigger, cgServicesSub, cgServicesWrap));

  cgClose.addEventListener('click', closeConciergeDrawer);
  cgBackdrop.addEventListener('click', closeConciergeDrawer);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && cgDrawer.classList.contains('is-open')) closeConciergeDrawer();
  });

  const ACTION_INTENTS: Record<string, string> = {
    appointment: 'atelier visit',
    virtual:     'virtual appointment',
    repairs:     'repairs',
    resize:      'resize',
  };

  cgDrawer.querySelectorAll<HTMLElement>('[data-action]').forEach(btn => {
    btn.addEventListener('click', () => {
      const action = btn.dataset.action || '';

      if (action === 'chat') {
        closeConciergeDrawer();
        if ((window as any).fcWidget?.isOpen !== undefined) {
          (window as any).fcWidget.open();
        } else {
          setTimeout(() => (window as any).openInquiryDrawer?.({ intent: '', fromConcierge: true }), 200);
        }
        return;
      }

      if (action === 'call') {
        window.location.href = 'tel:2136299191';
        return;
      }

      const intent = ACTION_INTENTS[action] ?? '';
      closeConciergeDrawer();
      setTimeout(() => (window as any).openInquiryDrawer?.({ intent, fromConcierge: true }), 200);
    });
  });

  (window as any).openConciergeDrawer  = openConciergeDrawer;
  (window as any).closeConciergeDrawer = closeConciergeDrawer;
</script>
