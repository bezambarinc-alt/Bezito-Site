---
// ConciergeDrawer.astro — Luxury concierge panel, triggered from nav + service links.
// Global API: window.openConciergeDrawer() / window.closeConciergeDrawer()
---

<div id="concierge-drawer" class="cg-drawer" role="dialog" aria-modal="true" aria-label="Atelier Concierge" hidden>
  <div class="cg-drawer__backdrop" id="cgBackdrop"></div>
  <div class="cg-drawer__panel">

    <div class="cg-drawer__header">
      <span class="cg-drawer__eyebrow">Bez Ambar</span>
      <h2 class="cg-drawer__title">Atelier Concierge</h2>
      <button class="cg-drawer__close" id="cgClose" aria-label="Close concierge panel">&#x2715;</button>
    </div>

    <div class="cg-drawer__body">

      <!-- Begin a Conversation -->
      <div class="cg-section">
        <p class="cg-section__label">Begin a Conversation</p>
        <ul class="cg-menu" role="list">
          <li>
            <button class="cg-menu__item" data-intent="commission a piece">
              <span class="cg-menu__text">Commission a Piece</span>
              <span class="cg-menu__arrow">&#8594;</span>
            </button>
          </li>
          <li>
            <button class="cg-menu__item" data-intent="consultation">
              <span class="cg-menu__text">Private Consultation</span>
              <span class="cg-menu__arrow">&#8594;</span>
            </button>
          </li>
          <li>
            <button class="cg-menu__item" data-intent="atelier visit">
              <span class="cg-menu__text">Visit the Atelier</span>
              <span class="cg-menu__arrow">&#8594;</span>
            </button>
          </li>
          <li>
            <button class="cg-menu__item" data-intent="collection piece">
              <span class="cg-menu__text">A Piece from the Collection</span>
              <span class="cg-menu__arrow">&#8594;</span>
            </button>
          </li>
        </ul>
      </div>

      <hr class="cg-rule">

      <!-- Services -->
      <div class="cg-section">
        <p class="cg-section__label">Services</p>
        <ul class="cg-menu" role="list">
          <li>
            <button class="cg-menu__item" data-intent="repairs">
              <span class="cg-menu__text">Repair &amp; Cleaning</span>
              <span class="cg-menu__arrow">&#8594;</span>
            </button>
          </li>
          <li>
            <button class="cg-menu__item" data-intent="resize">
              <span class="cg-menu__text">Ring Resizing</span>
              <span class="cg-menu__arrow">&#8594;</span>
            </button>
          </li>
        </ul>
      </div>

      <hr class="cg-rule">

      <!-- Connect -->
      <div class="cg-section">
        <p class="cg-section__label">Connect</p>
        <div class="cg-contact">
          <div class="cg-contact__row">
            <span class="cg-contact__key">Tel</span>
            <a href="tel:2136299191" class="cg-contact__val">(213) 629-9191</a>
          </div>
          <div class="cg-contact__row">
            <span class="cg-contact__key">Email</span>
            <a href="mailto:bez@bezambar.com" class="cg-contact__val">bez@bezambar.com</a>
          </div>
          <div class="cg-contact__row">
            <span class="cg-contact__key">Atelier</span>
            <span class="cg-contact__val">611 Wilshire Blvd<br>Los Angeles, CA 90017<br><span class="cg-contact__note">By appointment only</span></span>
          </div>
        </div>
      </div>

      <hr class="cg-rule">

      <!-- Policies -->
      <div class="cg-section">
        <p class="cg-section__label">Policies</p>
        <ul class="cg-menu" role="list">
          <li>
            <a class="cg-menu__item" href="/warranty">
              <span class="cg-menu__text">Warranty &amp; Provenance</span>
              <span class="cg-menu__arrow">&#8594;</span>
            </a>
          </li>
          <li>
            <a class="cg-menu__item" href="/shipping">
              <span class="cg-menu__text">Shipping &amp; Insurance</span>
              <span class="cg-menu__arrow">&#8594;</span>
            </a>
          </li>
        </ul>
      </div>

    </div>
  </div>
</div>

<style is:global>
/* ── Concierge Drawer ───────────────────────────────────── */
.cg-drawer {
  position: fixed;
  inset: 0;
  z-index: 950;
  pointer-events: none;
}
.cg-drawer.is-open {
  pointer-events: auto;
}
.cg-drawer__backdrop {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  opacity: 0;
  transition: opacity 0.3s ease;
}
.cg-drawer.is-open .cg-drawer__backdrop {
  opacity: 1;
}
.cg-drawer__panel {
  position: absolute;
  top: 0;
  right: 0;
  height: 100%;
  width: min(400px, 100vw);
  background: #111009;
  transform: translateX(100%);
  transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  overflow-y: auto;
  display: flex;
  flex-direction: column;
}
.cg-drawer.is-open .cg-drawer__panel {
  transform: translateX(0);
}

/* Header */
.cg-drawer__header {
  padding: 2.5rem 2rem 1.75rem;
  border-bottom: 1px solid rgba(149, 130, 107, 0.2);
  position: relative;
}
.cg-drawer__eyebrow {
  display: block;
  font-family: var(--sans);
  font-size: 9px;
  font-weight: 500;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 0.4rem;
}
.cg-drawer__title {
  font-family: var(--serif);
  font-size: 1.375rem;
  font-weight: 400;
  color: #e8ddd0;
  letter-spacing: 0.01em;
}
.cg-drawer__close {
  position: absolute;
  top: 1.5rem;
  right: 1.5rem;
  background: none;
  border: none;
  color: rgba(232, 221, 208, 0.4);
  font-size: 1rem;
  cursor: pointer;
  line-height: 1;
  padding: 0.375rem;
  transition: color 0.15s;
}
.cg-drawer__close:hover { color: var(--accent); }

/* Body */
.cg-drawer__body {
  padding: 0 0 3rem;
  flex: 1;
}

/* Sections */
.cg-section {
  padding: 1.5rem 2rem 0.5rem;
}
.cg-section__label {
  font-family: var(--sans);
  font-size: 9px;
  font-weight: 500;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 0.875rem;
}

/* Rule */
.cg-rule {
  margin: 0.75rem 2rem;
  border: none;
  border-top: 1px solid rgba(149, 130, 107, 0.15);
}

/* Menu items */
.cg-menu {
  list-style: none;
  padding: 0;
  margin: 0;
}
.cg-menu__item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 0.75rem 0;
  background: none;
  border: none;
  border-bottom: 1px solid rgba(149, 130, 107, 0.08);
  cursor: pointer;
  text-decoration: none;
  text-align: left;
  transition: border-color 0.15s;
}
.cg-menu__item:last-child { border-bottom: none; }
.cg-menu__item:hover .cg-menu__text { color: var(--accent); }
.cg-menu__item:hover .cg-menu__arrow { color: var(--accent); transform: translateX(3px); }
.cg-menu__text {
  font-family: var(--serif);
  font-size: 1rem;
  font-weight: 400;
  color: #c8bbad;
  line-height: 1.4;
  transition: color 0.15s;
}
.cg-menu__arrow {
  font-size: 0.875rem;
  color: rgba(149, 130, 107, 0.4);
  transition: color 0.15s, transform 0.15s;
  flex-shrink: 0;
  margin-left: 1rem;
}

/* Contact block */
.cg-contact {
  display: flex;
  flex-direction: column;
  gap: 0.875rem;
}
.cg-contact__row {
  display: grid;
  grid-template-columns: 44px 1fr;
  gap: 12px;
  align-items: start;
}
.cg-contact__key {
  font-family: var(--sans);
  font-size: 9px;
  font-weight: 500;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--accent);
  padding-top: 2px;
}
.cg-contact__val {
  font-family: var(--serif);
  font-size: 0.9375rem;
  color: #c8bbad;
  line-height: 1.6;
  text-decoration: none;
  transition: color 0.15s;
}
a.cg-contact__val:hover { color: var(--accent); }
.cg-contact__note {
  font-family: var(--sans);
  font-size: 0.6875rem;
  color: rgba(200, 187, 173, 0.5);
  letter-spacing: 0.04em;
}
</style>

<script>
  const cgDrawer  = document.getElementById('concierge-drawer') as HTMLElement;
  const cgBackdrop = document.getElementById('cgBackdrop') as HTMLElement;
  const cgClose   = document.getElementById('cgClose') as HTMLButtonElement;

  function openConciergeDrawer() {
    cgDrawer.hidden = false;
    requestAnimationFrame(() => cgDrawer.classList.add('is-open'));
    document.body.style.overflow = 'hidden';
  }

  function closeConciergeDrawer() {
    cgDrawer.classList.remove('is-open');
    document.body.style.overflow = '';
    setTimeout(() => { cgDrawer.hidden = true; }, 360);
  }

  cgClose.addEventListener('click', closeConciergeDrawer);
  cgBackdrop.addEventListener('click', closeConciergeDrawer);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && cgDrawer.classList.contains('is-open')) closeConciergeDrawer();
  });

  // Wire intent buttons → close concierge, open inquiry drawer with intent pre-filled
  cgDrawer.querySelectorAll<HTMLElement>('[data-intent]').forEach(btn => {
    btn.addEventListener('click', () => {
      const intent = btn.dataset.intent || '';
      closeConciergeDrawer();
      // Brief delay so concierge finishes sliding out before inquiry slides in
      setTimeout(() => {
        (window as any).openInquiryDrawer?.({ intent });
      }, 200);
    });
  });

  (window as any).openConciergeDrawer  = openConciergeDrawer;
  (window as any).closeConciergeDrawer = closeConciergeDrawer;
</script>
