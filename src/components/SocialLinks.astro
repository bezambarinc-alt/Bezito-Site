---
// SocialLinks.astro — icon-only social row, used in footer, contact page, and inquiry drawer.
interface Props {
  class?: string;
}
const { class: cls } = Astro.props;
---

<div class:list={['social-links', cls]}>
  <!-- Instagram -->
  <a href="https://www.instagram.com/bezambarjewelry/" target="_blank" rel="noopener" aria-label="Instagram" class="social-links__icon">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
      <circle cx="12" cy="12" r="4"/>
      <circle cx="17.5" cy="6.5" r="0.75" fill="currentColor" stroke="none"/>
    </svg>
  </a>

  <!-- Pinterest -->
  <a href="https://www.pinterest.com/bezambarinc/" target="_blank" rel="noopener" aria-label="Pinterest" class="social-links__icon">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 2C6.477 2 2 6.477 2 12c0 4.188 2.516 7.789 6.153 9.32-.085-.745-.162-1.888.034-2.702.175-.74 1.17-4.96 1.17-4.96s-.298-.597-.298-1.481c0-1.387.806-2.425 1.807-2.425.853 0 1.266.64 1.266 1.407 0 .857-.547 2.14-.828 3.33-.235.995.498 1.805 1.476 1.805 1.771 0 3.135-1.866 3.135-4.559 0-2.384-1.715-4.05-4.163-4.05-2.836 0-4.502 2.126-4.502 4.327 0 .857.33 1.775.74 2.277a.3.3 0 01.07.285l-.275 1.12c-.044.18-.146.218-.336.132C5.985 15.882 5 13.997 5 12c0-2.21 1.628-4.997 5.996-4.997C15 7 18 9.476 18 13.07c0 4.002-2.52 7.218-6.024 7.218-1.177 0-2.285-.613-2.664-1.335l-.724 2.707c-.262.997-.97 2.246-1.44 3.007A10 10 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
    </svg>
  </a>

  <!-- YouTube -->
  <a href="https://www.youtube.com/@BezAmbarInc/" target="_blank" rel="noopener" aria-label="YouTube" class="social-links__icon">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M22 7s-.3-2-1.2-2.8C19.6 3.1 18.4 3 17.8 3 14.6 2.9 12 2.9 12 2.9s-2.6 0-5.8.1c-.6.1-1.8.1-2 1.2C4 5 4 7 4 12s0 5 .2 6c.2 1.1 1.4 1.1 2 1.2 3.2.1 5.8.1 5.8.1s2.6 0 5.8-.1c.6-.1 1.8-.1 2-1.2C20 17 20 15 20 12s0-5-.2-5.8L22 7z"/>
      <polygon points="10,9 10,15 16,12" fill="currentColor" stroke="none"/>
    </svg>
  </a>

  <!-- TikTok -->
  <a href="https://www.tiktok.com/@bezambar" target="_blank" rel="noopener" aria-label="TikTok" class="social-links__icon">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M9 12a4 4 0 104 4V4a5 5 0 005 5"/>
    </svg>
  </a>

  <!-- LinkedIn -->
  <a href="https://www.linkedin.com/in/bez-ambar-869936a/" target="_blank" rel="noopener" aria-label="LinkedIn" class="social-links__icon">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="2" y="2" width="20" height="20" rx="4"/>
      <path d="M8 11v6"/>
      <path d="M8 8v.01"/>
      <path d="M12 17v-6"/>
      <path d="M16 17v-3a2 2 0 00-4 0"/>
    </svg>
  </a>
</div>

<style is:global>
.social-links {
  display: flex;
  align-items: center;
  gap: 20px;
}
.social-links__icon {
  color: var(--ink-muted);
  display: flex;
  align-items: center;
  transition: color 0.2s;
  -webkit-tap-highlight-color: transparent;
}
.social-links__icon:hover { color: var(--accent); }
</style>
