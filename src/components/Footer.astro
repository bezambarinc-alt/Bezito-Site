---
// Footer.astro
import SocialLinks from './SocialLinks.astro';
---

<footer class="ba-footer" id="inquire">
  <div class="ba-footer__inner">
    <div class="ba-footer__cols">

      <!-- Brand identity — always visible, no accordion -->
      <div class="ba-footer__brand">
        <p class="ba-footer__wordmark">Bez Ambar</p>
        <p class="ba-footer__tagline">Inventor of the Princess Cut</p>
        <p class="ba-footer__estab">Los Angeles &middot; Est. 1979</p>
        <SocialLinks class="ba-footer__social" />
        <p class="ba-footer__featuring">Featuring the Blaze&reg; Cut</p>
      </div>

      <!-- Shop -->
      <div class="ba-footer__col">
        <button class="ba-footer__toggle" type="button" aria-expanded="false">
          Shop
          <svg class="ba-footer__chevron" width="12" height="7" viewBox="0 0 12 7" fill="none" aria-hidden="true">
            <path d="M1 1l5 5 5-5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <div class="ba-footer__col-links">
          <a href="/collection/bloom">Bloom Collection</a>
          <a href="/jewelry/rings">Rings</a>
          <a href="/jewelry/engagement-rings">Engagement Rings</a>
          <a href="/jewelry/wedding-bands">Wedding Bands</a>
          <a href="/jewelry/bracelets">Bracelets</a>
          <a href="/jewelry/earrings">Earrings</a>
          <a href="/jewelry/necklaces">Necklaces</a>
          <a href="/jewelry/pendants">Pendants</a>
        </div>
      </div>

      <!-- Discover -->
      <div class="ba-footer__col">
        <button class="ba-footer__toggle" type="button" aria-expanded="false">
          Discover
          <svg class="ba-footer__chevron" width="12" height="7" viewBox="0 0 12 7" fill="none" aria-hidden="true">
            <path d="M1 1l5 5 5-5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <div class="ba-footer__col-links">
          <a href="/about-bez-ambar">About Bez Ambar</a>
          <a href="/diamond-education">Diamond Education</a>
          <a href="/elysian-cut">Elysian Cut&trade;</a>
          <a href="/press">Press</a>
          <a href="/journal">Journal</a>
          <a href="/ring-size-chart">Ring Size Guide</a>
        </div>
      </div>

      <!-- Service -->
      <div class="ba-footer__col">
        <button class="ba-footer__toggle" type="button" aria-expanded="false">
          Service
          <svg class="ba-footer__chevron" width="12" height="7" viewBox="0 0 12 7" fill="none" aria-hidden="true">
            <path d="M1 1l5 5 5-5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <div class="ba-footer__col-links">
          <a href="/contact">Contact Us</a>
          <a href="/contact" onclick="openInquiryDrawer({intent:'commission a piece'}); return false;">Bespoke Design</a>
          <a href="/contact" onclick="openInquiryDrawer({intent:'repairs'}); return false;">Repairs &amp; Cleaning</a>
          <a href="/contact" onclick="openInquiryDrawer({intent:'resize'}); return false;">Ring Resizing</a>
          <a href="/warranty">Warranty</a>
        </div>
      </div>

      <!-- Visit -->
      <div class="ba-footer__col ba-footer__col--visit">
        <button class="ba-footer__toggle" type="button" aria-expanded="false">
          Visit the Atelier
          <svg class="ba-footer__chevron" width="12" height="7" viewBox="0 0 12 7" fill="none" aria-hidden="true">
            <path d="M1 1l5 5 5-5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <div class="ba-footer__col-links">
          <address class="ba-footer__address-block">
            611 Wilshire Blvd<br>
            Los Angeles, CA 90017
          </address>
          <a href="tel:2136299191" class="ba-footer__contact-link">(213) 629-9191</a>
          <a href="mailto:bez@bezambar.com" class="ba-footer__contact-link">bez@bezambar.com</a>
          <p class="ba-footer__hours">Mon &ndash; Fri, 10am &ndash; 6pm PT</p>
          <p class="ba-footer__appt">By appointment only</p>
        </div>
      </div>

    </div>

    <div class="ba-footer__bottom">
      <p class="ba-footer__copy">&copy; 2026 Bez Ambar Inc. All rights reserved.</p>
      <nav class="ba-footer__legal" aria-label="Legal">
        <a href="/privacy-policy">Privacy Policy</a>
        <a href="/terms">Terms of Service</a>
        <a href="/warranty">Warranty</a>
      </nav>
    </div>
  </div>
</footer>

<script>
  document.querySelectorAll<HTMLElement>('.ba-footer__toggle').forEach(btn => {
    btn.addEventListener('click', () => {
      if (window.innerWidth >= 768) return;
      const col = btn.closest('.ba-footer__col');
      const isOpen = col?.classList.toggle('is-open');
      btn.setAttribute('aria-expanded', String(isOpen ?? false));
    });
  });
</script>
