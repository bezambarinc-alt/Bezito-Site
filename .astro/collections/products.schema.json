{
  "$ref": "#/definitions/products",
  "definitions": {
    "products": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string"
        },
        "sku": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "editorial": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "enum": [
            "rings",
            "engagement-rings",
            "wedding-bands",
            "earrings",
            "pendants",
            "necklaces",
            "bracelets"
          ]
        },
        "collection": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "status": {
          "type": "string",
          "enum": [
            "live",
            "draft",
            "archived"
          ]
        },
        "refCode": {
          "type": "string"
        },
        "stone": {
          "type": "object",
          "properties": {
            "shape": {
              "type": "string"
            },
            "carats": {
              "type": [
                "number",
                "string"
              ]
            },
            "color": {
              "type": "string"
            },
            "clarity": {
              "type": "string"
            },
            "origin": {
              "type": "string"
            }
          },
          "required": [
            "shape",
            "carats"
          ],
          "additionalProperties": false
        },
        "metal": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "heroVideo": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "heroImage": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "images": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "default": []
        },
        "inquirySubject": {
          "type": "string"
        },
        "prettyUrl": {
          "type": "string"
        }
      },
      "required": [
        "slug",
        "sku",
        "title",
        "category",
        "status",
        "refCode",
        "stone",
        "metal",
        "description",
        "inquirySubject",
        "prettyUrl"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}