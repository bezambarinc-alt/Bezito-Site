    <script>
        // LV-style category filter — supports subcategories via data-category (space-separated)
        function filterLV(category, label, e) {
            e.preventDefault();
            document.getElementById('catLabel').textContent = label;
            document.getElementById('catDropdown').classList.remove('open');

            // Update dropdown active state
            document.querySelectorAll('.lv-cat-menu a').forEach(a => a.classList.remove('active-cat'));
            if (e.target.closest('.lv-cat-menu')) {
                e.target.classList.add('active-cat');
            }

            // Update subcategory thumbnail bar active state
            document.querySelectorAll('.lv-subcat-item').forEach(item => item.classList.remove('active'));
            const clickedSubcat = e.target.closest('.lv-subcat-item');
            if (clickedSubcat) clickedSubcat.classList.add('active');

            // Filter products
            document.querySelectorAll('.lv-product-card').forEach(card => {
                const cats = card.dataset.category.split(' ');
                if (category === 'all') {
                    card.style.display = '';
                } else if (category === 'earrings') {
                    card.style.display = cats.includes('earrings') ? '' : 'none';
                } else if (category === 'rings') {
                    card.style.display = cats.includes('rings') ? '' : 'none';
                } else {
                    card.style.display = cats.includes(category) ? '' : 'none';
                }
            });
        }

        // Close dropdown when clicking outside
        document.addEventListener('click', function(e) {
            const dropdown = document.getElementById('catDropdown');
            if (!dropdown.contains(e.target)) {
                dropdown.classList.remove('open');
            }
        });

        // Handle URL params for category pre-filtering
        (function() {
            const params = new URLSearchParams(window.location.search);
            const cat = params.get('cat');
            if (cat) {
                const labels = {
                    rings: 'Rings', pendants: 'Pendants', necklaces: 'Necklaces',
                    earrings: 'Earrings', bracelets: 'Bracelets',
                    'stud-earrings': 'Stud Earrings', 'hug-earrings': 'Hug Earrings', 'hoop-earrings': 'Hoop Earrings',
                    'engagement-rings': 'Engagement Rings',
                    'wedding-bands': 'Wedding Bands',
                    'mens-wedding-bands': "Men's Wedding Bands"
                };
                if (labels[cat]) {
                    document.getElementById('catLabel').textContent = labels[cat];
                    document.querySelectorAll('.lv-cat-menu a').forEach(a => a.classList.remove('active-cat'));
                    document.querySelectorAll('.lv-product-card').forEach(card => {
                        const cats = card.dataset.category.split(' ');
                        if (cat === 'earrings') {
                            card.style.display = cats.includes('earrings') ? '' : 'none';
                        } else {
                            card.style.display = cats.includes(cat) ? '' : 'none';
                        }
                    });
                    // Mark the correct dropdown item as active
                    document.querySelectorAll('.lv-cat-menu a').forEach(a => {
                        if (a.textContent.trim() === labels[cat]) a.classList.add('active-cat');
                    });
                }
            }
        })();
    </script>

    <script>
    function toggleMobileNav() {
        document.querySelector('.mobile-nav-toggle').classList.toggle('open');
        document.getElementById('mobileNav').classList.toggle('open');
        document.body.style.overflow = document.getElementById('mobileNav').classList.contains('open') ? 'hidden' : '';
    }
    </script>
</body>
