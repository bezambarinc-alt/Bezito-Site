# Bez Ambar — Next.js environment variables
# Copy to .env.local for local development.
# All variables are required in production unless marked optional.

# ── Database ──────────────────────────────────────────────────────────────────
# Neon Postgres connection string (pooled endpoint recommended for Vercel)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Auth ──────────────────────────────────────────────────────────────────────
# JWT signing secret — shared by admin session + client portal session tokens.
# Generate: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-here

# ── Cron / Bezito agent ───────────────────────────────────────────────────────
# Vercel injects Authorization: Bearer <CRON_SECRET> on scheduled cron calls.
# Must match the value Vercel has for this project.
CRON_SECRET=your-cron-secret-here

# Bezito AI agent uses this to manually trigger cron endpoints (e.g. Plytix sync).
# Keep separate from CRON_SECRET so you can rotate each independently.
BEZITO_SECRET=your-bezito-secret-here

# ── Plytix (Product Information Management) ───────────────────────────────────
# API credentials from Plytix → Settings → API Keys.
PLYTIX_API_KEY=your-plytix-api-key
PLYTIX_API_PASSWORD=your-plytix-api-password

# ── Freshsales (CRM) ──────────────────────────────────────────────────────────
# API key from Freshsales → Settings → API Settings.
# Used by /api/lead to push inquiry leads to CRM (best-effort — failure is non-fatal).
FRESHSALES_API_KEY=your-freshsales-api-key

# ── Analytics ─────────────────────────────────────────────────────────────────
# Secret used to verify analytics tracking calls from the browser.
# Generate: openssl rand -base64 32
TRACK_SECRET=your-track-secret-here

# ── App URL (optional) ────────────────────────────────────────────────────────
# Canonical site URL — used for absolute URLs where needed.
# Defaults to https://bezambar.com in production. Override in dev if needed.
# APP_URL=http://localhost:3000
