        // Load product from URL param
        (function() {
            const params = new URLSearchParams(window.location.search);
            const id = params.get('id');
            const product = products[id];
            if (!product) return;

            // Update page title
            document.title = product.title + ' — Bez Ambar | Luxury Diamond Jewelry';
            document.getElementById('pdpSku').textContent = product.sku;
            document.getElementById('pdpTitle').textContent = product.title;
            document.getElementById('pdpPrice').textContent = product.price;
            document.getElementById('pdpDesc').textContent = product.desc;
            document.getElementById('pdpSpecs').innerHTML = product.specs;

            // Update CTA
            const ctaBtn = document.getElementById('pdpCta');
            ctaBtn.textContent = product.cta;
            ctaBtn.href = 'mailto:bez@bezambar.com?subject=Inquiry%20-%20' + encodeURIComponent(product.title);

            // Update back link to return to correct category
            const backLink = document.querySelector('.pdp-back');
            if (product.category === 'earrings') {
                backLink.href = 'collection.html?cat=stud-earrings';
            } else {
                backLink.href = 'collection.html?cat=' + product.category;
            }

            // Show product image (real or placeholder)
            const imgSlot = document.getElementById('pdpMainImgSlot');
            if (product.img) {
                imgSlot.innerHTML = '<img src="' + CLD + product.img + '" alt="' + product.title + '" style="width:100%;display:block;">';
            } else {
                imgSlot.innerHTML = '<div class="image-placeholder tall"><p>' + product.title + '</p></div>';
            }

            // Show read-more button if description is long
            if (product.desc.length > 200) {
                document.getElementById('readMoreBtn').style.display = '';
            }

            // Build related products grid
            if (product.related) {
                const grid = document.getElementById('relatedGrid');
                grid.innerHTML = '';
                product.related.forEach(relId => {
                    const rel = products[relId];
                    if (!rel) return;
                    const imgHtml = rel.img
                        ? '<img src="' + CLD_THUMB + rel.img + '" alt="' + rel.title + '">'
                        : '<div class="image-placeholder"><p>' + rel.title + '</p></div>';
                    grid.innerHTML += '<a href="product.html?id=' + relId + '" class="lv-product-card">' +
                        '<div class="lv-card-img">' + imgHtml + '</div>' +
                        '<svg class="lv-card-wishlist" viewBox="0 0 24 24" fill="none"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" stroke="currentColor" stroke-width="1.5"/></svg>' +
                        '<div class="lv-card-info"><h3>' + rel.title + '</h3><p class="lv-card-price">' + rel.price + '</p></div></a>';
                });
            }
        })();
    </script>

    <script>
    function toggleMobileNav() {
        document.querySelector('.mobile-nav-toggle').classList.toggle('open');
        document.getElementById('mobileNav').classList.toggle('open');
        document.body.style.overflow = document.getElementById('mobileNav').classList.contains('open') ? 'hidden' : '';
    }
    </script>
</body>
</html>